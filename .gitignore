# The complete source-materials tree is machine-local. Its manifests, analyses,
# reports, contact sheets, and media must not enter Git or a later push.
/source-materials/

# Legacy fine-grained rules below remain as documentation for older checkouts.
source-materials/video-sources/**/videos/
source-materials/video-sources/**/audio/
source-materials/video-sources/**/raw/
