{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/03v-creative-context-review-execution-record.schema.json",
  "title": "IDOL 03V Contextual Review Execution Record",
  "description": "Retired evidence-only 03V-specific execution record. Preserved historical bytes remain readable, but new review execution must use the provider-neutral llm-review-execution-record contract. This schema never judges creative adequacy and must not open a new run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "surface_owner",
    "session_type",
    "role_id",
    "session_id",
    "profile",
    "source_video_prompt_index_sha256",
    "assigned_section_ids",
    "completion_state",
    "canonical_semantic_write_performed"
  ],
  "properties": {
    "schema_version": {"const": "idol-03v-creative-context-review-execution-record.v1"},
    "producer": {"enum": ["registered_codex_03v_reviewer_runner", "registered_grok_native_03v_reviewer_runner"]},
    "surface_owner": {"enum": ["codex", "grok"]},
    "session_type": {"enum": ["codex_section_review", "codex_root_reconciliation", "native_subagent", "root_reconciliation"]},
    "role_id": {"enum": ["idol-03v-section-context-reviewer", "grok-03v-section-context-reviewer", "idol-03v-whole-timeline-reconciler", "grok-root-03v-whole-timeline-reconciler"]},
    "session_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["sol_xhigh", "sol_max", "grok_4_5_high_native_subagent", "grok_4_5_high_root"]},
    "source_video_prompt_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assigned_section_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^S[0-9]{2,}(?:_S[0-9]{2,}|_ALT)?$"},
      "uniqueItems": true
    },
    "completion_state": {"const": "completed"},
    "canonical_semantic_write_performed": {"const": false}
  }
}
