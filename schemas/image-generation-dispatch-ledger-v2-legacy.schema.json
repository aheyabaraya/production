{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/image-generation-dispatch-ledger-v2-legacy.schema.json",
  "title": "IDOL Image Generation Dispatch Ledger v2 Legacy Reader",
  "description": "Adapter-neutral state for claiming bounded-parallel Branch-Cut image-generation requests and recording returned files while preserving packet, parent Core Cut, and Branch Cut identity. It supports API, Codex built-in ImageGen, Grok /image, and section-scoped image-capable workers without rewriting a prompt or reference list. The ledger itself never calls a model or grants approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run",
    "source_worklist",
    "section_id",
    "status",
    "capacity",
    "queue",
    "automation_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "idol_image_generation_dispatch_ledger.v2"},
    "artifact_type": {"const": "image_generation_dispatch_ledger"},
    "run": {"type": "string", "pattern": "^(?:runs/[a-z0-9][a-z0-9-]{1,120}/[a-z0-9가-힣][a-z0-9가-힣-]{1,120}/[A-Za-z0-9][A-Za-z0-9._-]{2,120}|runs/2026-07-29/0729_ONE_MOVE)$"},
    "source_worklist": {"$ref": "#/$defs/sourcePointer"},
    "section_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "in_progress", "awaiting_pixel_inspection", "complete", "hold"]},
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_in_flight", "capacity_source", "one_packet_per_call", "unsupported_runtime_fallback"],
      "properties": {
        "max_in_flight": {"type": "integer", "minimum": 1, "maximum": 32},
        "capacity_source": {"const": "operator_declared_current_adapter_or_runtime_capacity"},
        "one_packet_per_call": {"const": true},
        "unsupported_runtime_fallback": {"const": "set_capacity_to_one_without_rewriting_requests"}
      }
    },
    "queue": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/queueItem"}
    },
    "automation_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_noncanonical", "model_call_performed_by_ledger", "approval_granted", "prompt_or_reference_rewrite_performed"],
      "properties": {
        "derived_noncanonical": {"const": true},
        "model_call_performed_by_ledger": {"const": false},
        "approval_granted": {"const": false},
        "prompt_or_reference_rewrite_performed": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claim": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt_id", "runner_id", "claimed_at", "idempotency_key"],
          "properties": {
            "attempt_id": {"type": "string", "pattern": "^ATT_[A-F0-9]{16}$"},
            "runner_id": {"type": "string", "minLength": 1},
            "claimed_at": {"type": "string", "format": "date-time"},
            "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "output": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "recorded_at"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "recorded_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "inspection": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "receipt"],
          "properties": {
            "status": {"enum": ["pass", "reject"]},
            "receipt": {"$ref": "#/$defs/sourcePointer"}
          }
        }
      ]
    },
    "queueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "core_cut_id",
        "branch_cut_id",
        "adapter",
        "request",
        "expected_output_path",
        "state",
        "attempt_count",
        "claim",
        "output",
        "pixel_inspection"
      ],
      "properties": {
        "packet_id": {"type": "string", "minLength": 1},
        "core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
        "adapter": {"type": "string", "minLength": 1},
        "request": {"$ref": "#/$defs/sourcePointer"},
        "expected_output_path": {"type": "string", "minLength": 1},
        "state": {"enum": ["pending", "claimed", "generated", "passed", "failed", "hold"]},
        "attempt_count": {"type": "integer", "minimum": 0},
        "claim": {"$ref": "#/$defs/claim"},
        "output": {"$ref": "#/$defs/output"},
        "pixel_inspection": {"$ref": "#/$defs/inspection"},
        "failure_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
