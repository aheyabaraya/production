{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/graph-creative-judgment-registry.schema.json",
  "title": "IDOL Graph Creative Judgment Registry",
  "description": "Checkpoint-bound 0-4 contextual judgment profiles. The registry chooses criteria and graph edges but has no creative or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "authority", "scale", "decision_edges", "decision_status", "grade_routing", "current_profile_releases", "profiles"],
  "properties": {
    "schema_version": {"const": "idol-graph-creative-judgment-registry.v1"},
    "status": {"enum": ["shadow_not_default", "hold"]},
    "authority": {"const": "criteria_registry_no_creative_or_promotion_authority"},
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "aggregate_score", "automatic_creative_pass", "base_applicable_floor", "hard_gate_precedence"],
      "properties": {
        "minimum": {"const": 0},
        "maximum": {"const": 4},
        "aggregate_score": {"const": "forbidden"},
        "automatic_creative_pass": {"const": "forbidden"},
        "base_applicable_floor": {"const": 3},
        "hard_gate_precedence": {"const": true}
      }
    },
    "decision_edges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_for_director_review", "combine_or_correct", "hold", "reject"],
      "properties": {
        "eligible_for_director_review": {"const": "director_review"},
        "combine_or_correct": {"const": "revise_same_owner"},
        "hold": {"const": "return_to_smallest_owner"},
        "reject": {"const": "stop"}
      }
    },
    "decision_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_for_director_review", "combine_or_correct", "hold", "reject"],
      "properties": {
        "eligible_for_director_review": {"const": "ready_for_director_review"},
        "combine_or_correct": {"const": "draft"},
        "hold": {"const": "hold"},
        "reject": {"const": "rejected"}
      }
    },
    "grade_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade_zero", "grade_one", "grade_two_or_below_profile_floor", "all_applicable_floors_and_critical_fours", "hard_gate"],
      "properties": {
        "grade_zero": {"const": "hold"},
        "grade_one": {"const": "reject"},
        "grade_two_or_below_profile_floor": {"const": ["combine_or_correct", "hold"]},
        "all_applicable_floors_and_critical_fours": {"const": "eligible_for_director_review"},
        "hard_gate": {"const": "hold"}
      }
    },
    "current_profile_releases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_fp_storyline", "reference_candidate", "front_planning_close", "draft_keyframe_proof", "pixel_02b", "playback_03v", "edit_04_playback"],
      "properties": {
        "pre_fp_storyline": {"$ref": "#/$defs/profileReleasePointer"},
        "reference_candidate": {"$ref": "#/$defs/profileReleasePointer"},
        "front_planning_close": {"$ref": "#/$defs/profileReleasePointer"},
        "draft_keyframe_proof": {"$ref": "#/$defs/profileReleasePointer"},
        "pixel_02b": {"$ref": "#/$defs/profileReleasePointer"},
        "playback_03v": {"$ref": "#/$defs/profileReleasePointer"},
        "edit_04_playback": {"$ref": "#/$defs/profileReleasePointer"}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "profileReleasePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "release_value_sha256", "profile_value_sha256", "promotion_binding"],
      "properties": {
        "path": {"type": "string", "pattern": "^automation/graph-creative-judgment-profile-releases/[a-z0-9_]+/[a-f0-9]{64}\\.yaml$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "release_value_sha256": {"$ref": "#/$defs/sha256"},
        "profile_value_sha256": {"$ref": "#/$defs/sha256"},
        "promotion_binding": {"$ref": "#/$defs/profilePromotionPointer"}
      }
    },
    "profilePromotionPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^automation/graph-creative-judgment-profile-promotions/(?:bootstrap-shadow-seed|current-pointer)/[a-z0-9_/-]+\\.yaml$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "stages", "checkpoints", "owner_roles", "target_message_treatment", "evidence_surface", "criteria"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "checkpoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "owner_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "target_message_treatment": {"type": "string", "minLength": 1},
        "evidence_surface": {"type": "string", "minLength": 1},
        "criteria": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/criterion"}}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "minimum", "critical_four"],
      "properties": {
        "criterion_id": {"$ref": "#/$defs/identifier"},
        "minimum": {"type": "integer", "minimum": 3, "maximum": 4},
        "critical_four": {"type": "boolean"},
        "applies_when": {"$ref": "#/$defs/identifier"},
        "not_applicable": {"$ref": "#/$defs/identifier"}
      },
      "allOf": [
        {"if": {"properties": {"critical_four": {"const": true}}, "required": ["critical_four"]}, "then": {"properties": {"minimum": {"const": 4}}}}
      ]
    }
  }
}
