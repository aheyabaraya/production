{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/single-cut-beat-source-generation-manifest.schema.json",
  "title": "IDOL Single-Cut Multi-Member Beat Source Generation Manifest",
  "description": "Retired evidence-only manifest for the legacy beat-source route. New authoring and submission are forbidden; active generation uses one section-scoped Image Generation Request plus the Image Generation Dispatch Ledger. Historical recovery may read this shape without reopening it.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "content_id",
    "status",
    "output_root",
    "prompt_dir",
    "generation_contract",
    "member_face_refs",
    "keyframes"
  ],
  "properties": {
    "schema_version": {
      "const": "idol_cut_only_keyframe_generation_manifest.v1"
    },
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_generation",
        "submitted",
        "completed",
        "deprecated_geometry_failed"
      ]
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    },
    "prompt_dir": {
      "type": "string",
      "minLength": 1
    },
    "generation_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "prompt_header_mode",
        "identity_source_mode",
        "api_endpoint",
        "model",
        "quality",
        "size",
        "fixed_canvas",
        "selected_generation_count"
      ],
      "properties": {
        "prompt_header_mode": {
          "enum": [
            "single_frame_16x9",
            "single_frame_16x9_internal_group"
          ]
        },
        "identity_source_mode": {
          "enum": [
            "face_only_reference_inputs",
            "model_internal_identity"
          ]
        },
        "api_endpoint": {
          "enum": [
            "/v1/images/edits",
            "/v1/images/generations"
          ]
        },
        "model": {
          "const": "gpt-image-2"
        },
        "quality": {
          "const": "high"
        },
        "size": {
          "const": "1280x720"
        },
        "aspect_ratio": {
          "const": "16:9"
        },
        "fixed_canvas": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "const": 1280
            },
            "height": {
              "const": 720
            }
          }
        },
        "selected_generation_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_source_mode": {
                "const": "model_internal_identity"
              }
            }
          },
          "then": {
            "properties": {
              "api_endpoint": {
                "const": "/v1/images/generations"
              },
              "prompt_header_mode": {
                "const": "single_frame_16x9_internal_group"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity_source_mode": {
                "const": "face_only_reference_inputs"
              }
            }
          },
          "then": {
            "properties": {
              "api_endpoint": {
                "const": "/v1/images/edits"
              },
              "prompt_header_mode": {
                "const": "single_frame_16x9"
              }
            }
          }
        }
      ]
    },
    "member_face_refs": {
      "type": "object",
      "description": "Member identity reference paths. Prefer current-title album identity-source copies under assets/members/album-assets/ALBUM_KEY/TITLE_KEY/** when declared; otherwise use approved base member face-only references under assets/members/Mxx/.",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^(assets/members/M[0-9]{2}/.*face-only-reference.*|assets/members/album-assets/[^/]+/[^/]+/.*face-only-reference.*)$"
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "packet_id",
          "beat_id",
          "subject",
          "identity_source_mode",
          "api_face_refs",
          "output_image"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "packet_id": {
            "type": "string",
            "pattern": "^PKT_"
          },
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "description": "All visible members in the generated single-cut source image. Multi-member and formation beats may include more than two visible members.",
            "$ref": "#/$defs/visible_member_codes"
          },
          "api_face_refs": {
            "description": "Face-only member references allowed as API image inputs. Face-ref mode attaches one or two anchors. Five-or-more internal identity mode attaches none.",
            "$ref": "#/$defs/api_face_ref_member_codes"
          },
          "identity_source_mode": {
            "enum": [
              "face_only_reference_inputs",
              "model_internal_identity"
            ]
          },
          "output_image": {
            "type": "string",
            "pattern": "^images/.*\\.png$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "identity_source_mode": {
                  "const": "model_internal_identity"
                }
              }
            },
            "then": {
              "properties": {
                "api_face_refs": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "identity_source_mode": {
                  "const": "face_only_reference_inputs"
                }
              }
            },
            "then": {
              "properties": {
                "api_face_refs": {
                  "minItems": 1,
                  "maxItems": 2
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "visible_member_codes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^M[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "api_face_ref_member_codes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^M[0-9]{2}$"
      },
      "uniqueItems": true
    }
  }
}
