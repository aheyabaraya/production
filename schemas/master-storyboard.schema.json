{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/master-storyboard.schema.json",
  "title": "IDOL 02A Branch Expansion Plan",
  "description": "Active 3.0 contract only. 02A exact-imports the passed 01 Official Core Storyboard, including every one-image Core and mandatory Core reference binding, as immutable parent bytes. It authors only 1..N ordered Branch Cuts per passed Core inside the exact derivative and production scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "status",
    "source_front_planning",
    "source_01_direction",
    "imported_core_storyboard_head",
    "derivative_route_id",
    "production_scope_id",
    "output_intent",
    "storyline_lineage_projection",
    "pre00_audience_target_lineage_projection",
    "target_message_summary",
    "whole_film_spine",
    "founder_visual_alignment_projection",
    "screen_progression_map_projection",
    "creative_role_harness",
    "branch_subject_mix_policy",
    "coverage_plan",
    "section_shards",
    "master_storyboard",
    "official_branch_cuts",
    "reference_coverage_matrix",
    "camera_diversity_review",
    "branch_generation_manifest",
    "g40_core_branch_authorization",
    "founder_planning_gate",
    "review_surface",
    "open_questions"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "content_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "founder_review", "passed", "hold", "rejected"]},
    "source_front_planning": {"$ref": "#/$defs/artifactRef"},
    "source_01_direction": {"$ref": "#/$defs/artifactRef"},
    "imported_core_storyboard_head": {"$ref": "#/$defs/importedCoreStoryboardHead"},
    "derivative_route_id": {"type": "string", "pattern": "^DERIV_[A-Z0-9_]{2,100}$"},
    "production_scope_id": {"type": "string", "pattern": "^PSCOPE_[A-Z0-9_]{2,100}$"},
    "output_intent": {"type": "string", "minLength": 1},
    "storyline_lineage_projection": {"$ref": "#/$defs/storylineLineageProjection"},
    "pre00_audience_target_lineage_projection": {"$ref": "#/$defs/immutableValueProjection"},
    "target_message_summary": {"$ref": "#/$defs/targetMessageSummary"},
    "whole_film_spine": {"$ref": "#/$defs/wholeFilmSpine"},
    "founder_visual_alignment_projection": {"$ref": "#/$defs/alignmentValueProjection"},
    "screen_progression_map_projection": {"$ref": "#/$defs/immutableValueProjection"},
    "creative_role_harness": {
      "const": "creative_development_director_directs_and_reviews_02a_immutable_core_import_and_branch_only_working_shards_overall_director_inspects_and_promotes_exact_bytes"
    },
    "branch_subject_mix_policy": {
      "type": "string",
      "minLength": 1,
      "description": "Whole-film balance among member, unit/group, world/object, environment, system, and mixed screen carriers. Performance is optional rather than assumed."
    },
    "coverage_plan": {"$ref": "#/$defs/coveragePlan"},
    "section_shards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sectionShard"}
    },
    "master_storyboard": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coreCut"}
    },
    "official_branch_cuts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"}},
    "reference_coverage_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceCoverageRow"}},
    "camera_diversity_review": {"$ref": "#/$defs/cameraDiversityReview"},
    "branch_generation_manifest": {"$ref": "#/$defs/branchGenerationManifest"},
    "g40_core_branch_authorization": {"$ref": "#/$defs/g40Authorization"},
    "founder_planning_gate": {"$ref": "#/$defs/founderPlanningGate"},
    "review_surface": {"$ref": "#/$defs/reviewSurface"},
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "immutableValueProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_01_json_pointer", "source_front_planning_json_pointer", "source_value_sha256", "projected_value"],
      "properties": {
        "source_01_json_pointer": {"type": "string", "pattern": "^/.+"},
        "source_front_planning_json_pointer": {"type": "string", "pattern": "^/.+"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {}
      }
    },
    "importedCoreStoryboardHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_01_path", "source_01_sha256", "source_01_schema_version", "source_json_pointer", "source_value_sha256", "projected_value", "authorship_owner", "mutation_rule"],
      "properties": {
        "source_01_path": {"type": "string", "minLength": 1},
        "source_01_sha256": {"$ref": "#/$defs/sha256"},
        "source_01_schema_version": {"const": "3.0"},
        "source_json_pointer": {"const": "/official_core_cuts"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {"type": "array", "minItems": 1},
        "authorship_owner": {"const": "01_imported_immutable"},
        "mutation_rule": {"const": "02A_must_request_01_or_FP_smallest_owner_revision_instead_of_editing_Core_meaning_or_image"}
      }
    },
    "referenceCoverageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_cut_id", "branch_cut_id", "coverage_mode", "exact_source_binding_ids", "status"],
      "properties": {
        "core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
        "coverage_mode": {"enum": ["reference_led", "originated_without_direct_visual_reference"]},
        "exact_source_binding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["complete", "hold"]}
      }
    },
    "cameraDiversityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reviewed_branch_cut_ids", "same_core_and_whole_film_read"],
      "properties": {
        "verdict": {"enum": ["pass", "hold", "reject"]},
        "reviewed_branch_cut_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"}
        },
        "reviewed_core_cut_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}
        },
        "same_core_and_whole_film_read": {"type": "string", "minLength": 1},
        "collected_image_camera_angle_review": {"$ref": "#/$defs/collectedImageCameraAngleReview"}
      }
    },
    "collectedImageCameraAngleReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "automatic_creative_pass",
        "distinct_images",
        "pairs",
        "contextual_full_storyboard_read"
      ],
      "properties": {
        "contract_version": {"const": "collected_storyboard_camera_angle_review.v1"},
        "scope": {
          "const": "all_distinct_generated_production_images_on_the_planning_production_storyboard"
        },
        "automatic_creative_pass": {"const": false},
        "distinct_images": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/collectedStoryboardImage"}
        },
        "pairs": {
          "type": "array",
          "items": {"$ref": "#/$defs/collectedStoryboardImagePair"}
        },
        "contextual_full_storyboard_read": {"type": "string", "minLength": 1},
        "generated_pixel_closure": {"type": "boolean"},
        "incomplete_pixel_bindings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "collectedStoryboardImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cut_id", "production_cut_type", "still_camera_binding", "geometry_projection_sha256"],
      "properties": {
        "cut_id": {"type": "string", "minLength": 1},
        "production_cut_type": {"enum": ["official_core", "branch"]},
        "geometry_projection_sha256": {"$ref": "#/$defs/sha256"},
        "image_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "still_camera_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_json_pointer", "source_value_sha256"],
          "properties": {
            "source_json_pointer": {"type": "string", "pattern": "^/"},
            "source_value_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "collectedStoryboardImagePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_cut_id",
        "right_cut_id",
        "same_image_exact_carry",
        "left_geometry_projection_sha256",
        "right_geometry_projection_sha256",
        "shot_scale_not_used_as_angle_proof",
        "contextual_visual_review",
        "declared_angle_difference_result",
        "founder_exception"
      ],
      "properties": {
        "left_cut_id": {"type": "string", "minLength": 1},
        "right_cut_id": {"type": "string", "minLength": 1},
        "left_image_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "right_image_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "same_image_exact_carry": {"type": "boolean"},
        "left_geometry_projection_sha256": {"$ref": "#/$defs/sha256"},
        "right_geometry_projection_sha256": {"$ref": "#/$defs/sha256"},
        "shot_scale_not_used_as_angle_proof": {"const": true},
        "contextual_visual_review": {"type": "string", "minLength": 1},
        "declared_angle_difference_result": {
          "enum": ["differs", "exact_carry", "founder_lock_hold", "same"]
        },
        "founder_exception": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lock_id",
                "source_path",
                "source_json_pointer",
                "source_value_sha256",
                "conflicting_repeat_reason"
              ],
              "properties": {
                "lock_id": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "source_json_pointer": {"type": "string", "pattern": "^/"},
                "source_value_sha256": {"$ref": "#/$defs/sha256"},
                "named_cut_ids": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "named_image_sha256s": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/sha256"}
                },
                "conflicting_repeat_reason": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "branchGenerationManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_scope_id", "planned_branch_cut_ids", "expected_output_count_per_branch", "paid_generation_authorized"],
      "properties": {"production_scope_id": {"type": "string", "pattern": "^PSCOPE_[A-Z0-9_]{2,100}$"}, "planned_branch_cut_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"}}, "expected_output_count_per_branch": {"const": 1}, "paid_generation_authorized": {"type": "boolean"}}
    },
    "g40Authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "derivative_route_id", "production_scope_id", "reviewed_core_cut_ids", "reviewed_branch_cut_ids", "draft_keyframe_grade_vector", "paid_generation_authorized"],
      "properties": {"decision": {"enum": ["pending", "pass", "hold", "reject"]}, "derivative_route_id": {"type": "string", "pattern": "^DERIV_[A-Z0-9_]{2,100}$"}, "production_scope_id": {"type": "string", "pattern": "^PSCOPE_[A-Z0-9_]{2,100}$"}, "reviewed_core_cut_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}}, "reviewed_branch_cut_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"}}, "draft_keyframe_grade_vector": {"$ref": "#/$defs/draftKeyframeGradeVectorRef"}, "paid_generation_authorized": {"type": "boolean"}}
    },
    "draftKeyframeGradeVectorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "stage"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "stage": {"const": "draft_keyframe_proof"}
      }
    },
    "founderPlanningGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewed_scope",
        "reviewed_section_ids",
        "review_note",
        "storyline_review_order",
        "authorizes",
        "paid_generation_authorized"
      ],
      "properties": {
        "decision": {"enum": ["pending", "pass", "hold", "reject"]},
        "reviewed_scope": {"enum": ["whole_video", "named_sections"]},
        "reviewed_section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
        },
        "review_note": {"type": "string"},
        "storyline_review_order": {"const": "complete_pre00_root_and_active_full_text_lineage_then_fp_close_and_01_expansion_then_02a_core_and_branch_plan"},
        "authorizes": {"const": "affected_02B_route_only"},
        "paid_generation_authorized": {"const": false}
      }
    },
    "alignmentValueProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_01_json_pointer",
        "source_front_planning_json_pointer",
        "source_value_sha256",
        "projected_value"
      ],
      "properties": {
        "source_01_json_pointer": {"type": "string", "pattern": "^/.+"},
        "source_front_planning_json_pointer": {"type": "string", "pattern": "^/founder_visual_alignment(?:/.+)?$"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {}
      }
    },
    "storylineLineageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_01_json_pointer",
        "source_front_planning_json_pointer",
        "source_value_sha256",
        "projected_value"
      ],
      "properties": {
        "source_01_json_pointer": {"const": "/storyline_lineage_projection/projected_value"},
        "source_front_planning_json_pointer": {"const": "/storyline_lineage"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {"type": "object"}
      }
    },
    "sectionAlignmentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "source_01_json_pointer",
        "source_front_planning_json_pointer",
        "source_value_sha256",
        "projected_value"
      ],
      "properties": {
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "source_01_json_pointer": {"type": "string", "pattern": "^/section_directions/[0-9]+/section_alignment_projection/projected_value$"},
        "source_front_planning_json_pointer": {"type": "string", "pattern": "^/founder_visual_alignment/section_readouts/[0-9]+$"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {}
      }
    },
    "planningCutAlignmentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_cut_id",
        "source_key_screen_id",
        "source_01_json_pointer",
        "source_front_planning_json_pointer",
        "source_value_sha256",
        "projected_value"
      ],
      "properties": {
        "planning_cut_id": {"type": "string", "pattern": "^PC_[A-Z0-9_]{2,100}$"},
        "source_key_screen_id": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"},
        "source_01_json_pointer": {"type": "string", "pattern": "^/section_directions/[0-9]+/planning_cut_alignment_projections/[0-9]+/projected_value$"},
        "source_front_planning_json_pointer": {"type": "string", "pattern": "^/founder_visual_alignment/planning_cut_readouts/[0-9]+$"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {}
      }
    },
    "branchStorylineAlignmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_cut_id",
        "source_key_screen_id",
        "source_01_json_pointer",
        "source_front_planning_json_pointer",
        "source_value_sha256",
        "projected_value",
        "02a_expansion_delta",
        "prompt_lineage_rule"
      ],
      "properties": {
        "planning_cut_id": {"type": "string", "pattern": "^PC_[A-Z0-9_]{2,100}$"},
        "source_key_screen_id": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"},
        "source_01_json_pointer": {"type": "string", "pattern": "^/section_directions/[0-9]+/planning_cut_alignment_projections/[0-9]+/projected_value$"},
        "source_front_planning_json_pointer": {"type": "string", "pattern": "^/founder_visual_alignment/planning_cut_readouts/[0-9]+$"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {},
        "02a_expansion_delta": {
          "type": "string",
          "minLength": 1,
          "description": "Observable framing, staging, action, object-response, or continuity specificity added by this Branch Cut without replacing the exact Founder-aligned planning-cut readout."
        },
        "prompt_lineage_rule": {
          "const": "02B_must_read_this_exact_storyline_value_and_hash_before_authoring_the_five_prompt_items"
        }
      }
    },
    "targetMessageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_target",
        "audience_promise",
        "core_message",
        "desired_response",
        "do_not_serve"
      ],
      "properties": {
        "primary_target": {"type": "string", "minLength": 1},
        "audience_promise": {"type": "string", "minLength": 1},
        "core_message": {"type": "string", "minLength": 1},
        "desired_response": {"type": "string", "minLength": 1},
        "do_not_serve": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "wholeFilmSpine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening_state", "progression", "turn", "resolution_or_afterimage", "recurrence_rule"],
      "properties": {
        "opening_state": {"type": "string", "minLength": 1},
        "progression": {"type": "string", "minLength": 1},
        "turn": {"type": "string", "minLength": 1},
        "resolution_or_afterimage": {"type": "string", "minLength": 1},
        "recurrence_rule": {"type": "string", "minLength": 1}
      }
    },
    "coveragePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "unit",
        "cardinality_rule",
        "coverage_dimensions",
        "section_exact_cover_required"
      ],
      "properties": {
        "owner": {"const": "02A_internal"},
        "unit": {"const": "core_event_cut_then_1_to_n_distinct_branch_cut_children"},
        "cardinality_rule": {
          "const": "story_audio_screen_state_camera_composition_transition_and_edit_evidence_decide_counts_no_global_cap"
        },
        "coverage_dimensions": {
          "type": "array",
          "prefixItems": [
            {"const": "audio_or_section_cue"},
            {"const": "visible_action_or_hold"},
            {"const": "screen_carrier"},
            {"const": "space_or_object_state"},
            {"const": "still_camera_geometry"},
            {"const": "composition"},
            {"const": "reference_grammar"},
            {"const": "continuity"}
          ],
          "items": false
        },
        "section_exact_cover_required": {"const": true}
      }
    },
    "transitionLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_trigger", "visible_state", "continuity_carrier"],
      "properties": {
        "audio_trigger": {"type": "string", "minLength": 1},
        "visible_state": {"type": "string", "minLength": 1},
        "continuity_carrier": {"type": "string", "minLength": 1}
      }
    },
    "sectionShard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shard_id",
        "section_ids",
        "core_cut_ids",
        "time_range",
        "section_goal",
        "assigned_member_ids",
        "member_owner",
        "frame_subject_mode",
        "visual_system_anchor",
        "authorized_member_visual_asset_ids",
        "authorized_scene_reference_binding_ids",
        "section_alignment_projection",
        "planning_cut_alignment_projections",
        "transition_in",
        "transition_out",
        "status",
        "path"
      ],
      "properties": {
        "shard_id": {"type": "string", "pattern": "^SHARD_[A-Z0-9_]{2,80}$"},
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
        },
        "core_cut_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}
        },
        "time_range": {"type": "string", "minLength": 1},
        "section_goal": {"type": "string", "minLength": 1},
        "assigned_member_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M(0[1-9]|1[0-3])$"}
        },
        "member_owner": {"type": "string", "minLength": 1},
        "frame_subject_mode": {
          "enum": [
            "member_led",
            "unit_or_group_led",
            "world_object_led",
            "environment_insert",
            "system_transition",
            "mixed_member_world"
          ]
        },
        "visual_system_anchor": {"type": "string", "minLength": 1},
        "authorized_member_visual_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authorized_scene_reference_binding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^VRB_[A-Z0-9_]{2,80}$"}
        },
        "source_01_section": {"$ref": "#/$defs/source01SectionRef"},
