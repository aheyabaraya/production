          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "render_facing_action_cue": {"type": "string", "minLength": 1},
        "continuity_in": {"type": "string", "minLength": 1},
        "continuity_out": {"type": "string", "minLength": 1},
        "visible_member_focus": {
          "type": "array",
          "uniqueItems": true,
