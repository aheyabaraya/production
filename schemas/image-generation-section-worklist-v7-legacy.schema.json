{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/image-generation-section-worklist-v7-legacy.schema.json",
  "title": "IDOL Image Generation Section Worklist v7 Legacy Reader",
  "description": "A deterministic launch-ready index of validated Branch-Cut image-generation requests inside one post-02A section lineage. Active v7 requires an explicit active-selection manifest, validates shared section inputs once, and binds every ready section to the adapter-neutral dispatch ledger that can claim bounded-parallel Branch-Cut packet calls. Durable checkpoints may resume the same section lineage in a new physical session while a second creative lineage remains forbidden. The image/motion lineage ends after 03V handoff; 04 edit/QC is a separate execution unit. The worklist itself creates no model call, upload, approval, or paid generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run",
    "request_set_sha256",
    "discovery_contract",
    "status",
    "summary",
    "sections",
    "coordinator_contract",
    "automation_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "idol_image_generation_section_worklist.v7"},
    "artifact_type": {"const": "derived_image_generation_section_worklist"},
    "run": {"type": "string", "pattern": "^(?:runs/[a-z0-9][a-z0-9-]{1,120}/[a-z0-9가-힣][a-z0-9가-힣-]{1,120}/[A-Za-z0-9][A-Za-z0-9._-]{2,120}|runs/2026-07-29/0729_ONE_MOVE)$"},
    "request_set_sha256": {"$ref": "#/$defs/sha256"},
    "discovery_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_root",
        "current_source_02b",
        "selection_mode",
        "archive_segments_ignored",
        "selection_rule",
        "stale_candidate_action",
        "no_current_request_action",
        "equally_current_duplicate_action",
        "candidate_count",
        "selected_count",
        "stale_count",
        "ignored_archive_count"
      ],
      "properties": {
        "request_root": {"type": "string", "minLength": 1},
        "current_source_02b": {"$ref": "#/$defs/sourcePointer"},
        "selection_mode": {"const": "explicit_active_selection"},
        "selection_source": {
          "oneOf": [
            {"$ref": "#/$defs/sourcePointer"},
            {"type": "null"}
          ]
        },
        "archive_segments_ignored": {
          "const": ["archive", "archived", "history", "superseded", "rejected"]
        },
        "selection_rule": {"const": "explicit_selection_exact_path_hash_then_current_02b_binding"},
        "stale_candidate_action": {"const": "report_and_exclude_without_blocking_current_work"},
        "no_current_request_action": {"const": "emit_hold_worklist_without_crashing"},
        "equally_current_duplicate_action": {"const": "hold"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "selected_count": {"type": "integer", "minimum": 0},
        "stale_count": {"type": "integer", "minimum": 0},
        "ignored_archive_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["ready", "hold"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_count", "request_count", "ready_section_count", "hold_section_count"],
      "properties": {
        "section_count": {"type": "integer", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 0},
        "ready_section_count": {"type": "integer", "minimum": 0},
        "hold_section_count": {"type": "integer", "minimum": 0}
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "status",
          "fresh_session_required",
          "prompt_authoring_session_reuse_forbidden",
          "fresh_session_boundary",
          "second_creative_lineage_after_02b_forbidden",
          "post_02a_section_lineage_required",
          "durable_checkpoint_resume_allowed",
          "same_physical_session_required",
          "04_edit_session_included",
          "03v_completion_handoff_required_before_04",
          "execution_controller",
          "sol_execution_forbidden",
          "asynchronous_with_disjoint_sections_allowed",
          "parallel_dispatch",
          "context_packs",
          "planning_source",
          "requests",
          "output_paths",
          "hold_reasons"
        ],
        "properties": {
          "section_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["ready", "hold"]},
          "fresh_session_required": {"const": true},
          "prompt_authoring_session_reuse_forbidden": {"const": true},
          "fresh_session_boundary": {"const": "sol_approved_02a_section"},
          "post_02a_section_lineage_required": {"const": true},
          "second_creative_lineage_after_02b_forbidden": {"const": true},
          "durable_checkpoint_resume_allowed": {"const": true},
          "same_physical_session_required": {"const": false},
          "04_edit_session_included": {"const": false},
          "03v_completion_handoff_required_before_04": {"const": true},
          "execution_controller": {"const": "adapter_native_or_terra_locked_section_executor"},
          "sol_execution_forbidden": {"const": true},
          "asynchronous_with_disjoint_sections_allowed": {"const": true},
          "parallel_dispatch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "membership",
              "mode",
              "request_unit",
              "concurrency_limit_source",
              "same_output_parallel_write_forbidden",
              "failure_isolation",
              "unsupported_runtime_fallback",
              "result_barrier"
            ],
            "properties": {
              "enabled": {"type": "boolean"},
              "membership": {"const": "all_ready_requests_in_section"},
              "mode": {"const": "bounded_parallel_packet_calls"},
              "request_unit": {"const": "one_exact_packet_per_generation_call"},
              "concurrency_limit_source": {"const": "selected_adapter_or_runtime_current_capacity"},
              "same_output_parallel_write_forbidden": {"const": true},
              "failure_isolation": {"const": "failed_packet_holds_without_invalidating_successful_disjoint_outputs"},
              "unsupported_runtime_fallback": {"const": "serialize_only_that_adapter_without_rewriting_packets"},
              "result_barrier": {"const": "hash_and_pixel_inspect_every_returned_output_before_section_review"}
              ,
              "controller_script": {"const": "scripts/idol_image_generation_dispatch.rb"},
              "ledger_schema": {"const": "schemas/image-generation-dispatch-ledger.schema.json"},
              "claim_policy": {"const": "atomic_capacity_bounded_claims"},
              "idempotency_policy": {"const": "request_hash_plus_attempt_number"},
              "result_recording": {"const": "expected_path_hash_then_pixel_inspection_receipt"}
            }
          },
          "context_packs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/sourcePointer"}
          },
          "planning_source": {"$ref": "#/$defs/sourcePointer"},
          "requests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "packet_id",
                "core_cut_id",
                "branch_cut_id",
                "adapter",
                "request_status",
                "prompt_sha256",
                "member_visual_inputs_sha256",
                "scene_reference_inputs_sha256",
                "attachment_order_sha256",
                "expected_output_path",
                "packet_value_sha256"
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/sha256"},
                "packet_id": {"type": "string", "minLength": 1},
                "core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
                "branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
                "adapter": {"type": "string", "minLength": 1},
                "request_status": {
                  "enum": ["ready", "hold"]
                },
                "prompt_sha256": {"$ref": "#/$defs/sha256"},
                "member_visual_inputs_sha256": {"$ref": "#/$defs/sha256"},
                "scene_reference_inputs_sha256": {"$ref": "#/$defs/sha256"},
                "attachment_order_sha256": {"$ref": "#/$defs/sha256"},
                "expected_output_path": {"type": "string", "minLength": 1},
                "packet_value_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          },
          "output_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "hold_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "coordinator_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatch_unit", "parallel_rule", "output_intake", "merge_rule"],
      "properties": {
        "dispatch_unit": {
          "enum": [
            "one_post_02a_lifecycle_session_per_section",
            "one_checkpointed_post_02a_image_motion_lineage_per_section"
          ]
        },
        "parallel_rule": {
          "enum": [
            "only_disjoint_section_ids_and_output_paths_may_run_asynchronously",
            "bounded_parallel_packet_calls_within_each_section_and_asynchronous_disjoint_sections"
          ]
        },
        "output_intake": {"const": "direct_scripts_hash_every_result_terra_pixel_inspects_full_section_before_sol_branch_cut_gate"},
        "merge_rule": {"const": "sol_reviews_bounded_decision_evidence_and_performs_cross_section_repetition_continuity_and_registry_merge"}
      }
    },
    "automation_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_noncanonical", "task_created", "model_called", "upload_performed", "approval_granted", "paid_generation_performed"],
      "properties": {
        "derived_noncanonical": {"const": true},
        "task_created": {"const": false},
        "model_called": {"const": false},
        "upload_performed": {"const": false},
        "approval_granted": {"const": false},
        "paid_generation_performed": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "discovery_contract": {"required": ["selection_source"]},
        "sections": {
          "items": {
            "properties": {
              "parallel_dispatch": {
                "required": [
                  "controller_script",
                  "ledger_schema",
                  "claim_policy",
                  "idempotency_policy",
                  "result_recording"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {"status": {"const": "ready"}},
                  "required": ["status"]
                },
                "then": {
                  "properties": {
                    "parallel_dispatch": {
                      "properties": {"enabled": {"const": true}}
                    }
                  }
                },
                "else": {
                  "properties": {
                    "parallel_dispatch": {
                      "properties": {"enabled": {"const": false}}
                    }
                  }
                }
              }
            ]
          }
        },
        "coordinator_contract": {
          "properties": {
            "dispatch_unit": {"const": "one_checkpointed_post_02a_image_motion_lineage_per_section"},
            "parallel_rule": {"const": "bounded_parallel_packet_calls_within_each_section_and_asynchronous_disjoint_sections"}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
