{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/03v-source-snapshot.schema.json",
  "title": "IDOL 03V Source Snapshot",
  "description": "Run-owned derived source-discovery snapshot for typed Official Core/Branch Production Cut placement and 03V authoring. It records one deterministic source scan with readable file hashes so later authoring and playback helpers can use stable refs instead of repeating broad discovery. It creates no creative lock or approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "run",
    "status",
    "generated_at",
    "discovery_contract",
    "gate_detection",
    "sources",
    "missing_required_roles",
    "missing_optional_roles",
    "source_set_sha256",
    "automation_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "idol_03v_source_snapshot.v3"},
    "content_id": {"type": "string", "minLength": 1},
    "run": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["current", "hold_missing_required_sources"]
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "discovery_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selection_rule", "reuse_rule"],
      "properties": {
        "mode": {"const": "single_run_source_scan"},
        "selection_rule": {"const": "latest_numeric_version_per_role"},
        "reuse_rule": {"const": "reuse_until_source_set_digest_changes"}
      }
    },
    "gate_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_cut_pass_detected",
        "selected_audio_timing_detected",
        "song_led_timing_gate_applies"
      ],
      "properties": {
        "production_cut_pass_detected": {"type": "boolean"},
        "selected_audio_timing_detected": {"type": "boolean"},
        "song_led_timing_gate_applies": {"type": "boolean"},
        "eligible_cue_count": {"type": "integer", "minimum": 0},
        "founder_pass_count": {"type": "integer", "minimum": 0},
        "timing_source_role": {"type": ["string", "null"]}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "role", "path", "sha256", "required_for_gate"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC_[A-Z0-9_]+$"},
          "role": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "required_for_gate": {"type": "boolean"}
        }
      }
    },
    "missing_required_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "missing_optional_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "source_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "automation_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_context_only",
        "creative_lock_created",
        "founder_pass_inferred",
        "paid_generation_approved",
        "playback_pass_implied",
        "external_execution_approved"
      ],
      "properties": {
        "derived_context_only": {"const": true},
        "creative_lock_created": {"const": false},
        "founder_pass_inferred": {"const": false},
        "paid_generation_approved": {"const": false},
        "playback_pass_implied": {"const": false},
        "external_execution_approved": {"const": false}
      }
    }
  }
}
