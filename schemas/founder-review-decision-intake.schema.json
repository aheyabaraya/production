{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/founder-review-decision-intake.schema.json",
  "title": "IDOL Founder Workbench Review Intake",
  "description": "Active v12 source-bound intake. It preserves canonical G-cycle decisions verbatim, routes Founder-facing decisions through the Overall Director only, and preserves video_playback_internal as a CDD checkpoint without creating a Founder gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "review_mode",
    "run",
    "source_board",
    "status",
    "summary",
    "decisions",
    "creative_rereview_policy",
    "automation_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "idol_founder_review_decision_intake.v12"},
    "artifact_type": {"const": "workbench_review_decision_intake"},
    "review_mode": {"$ref": "#/$defs/cycleKind"},
    "run": {"type": "string", "pattern": "^(?:runs/[a-z0-9][a-z0-9-]{1,120}/[a-z0-9가-힣][a-z0-9가-힣-]{1,120}/[A-Za-z0-9][A-Za-z0-9._-]{2,120}|runs/2026-07-29/0729_ONE_MOVE)$"},
    "source_board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_id", "board_revision", "manifest", "decision_export"],
      "properties": {
        "board_id": {"type": "string", "minLength": 1},
        "board_revision": {"type": "integer", "minimum": 1},
        "manifest": {"$ref": "#/$defs/sourcePointer"},
        "decision_export": {"$ref": "#/$defs/sourcePointer"}
      }
    },
    "status": {"enum": ["captured_for_director_synthesis", "ready_for_owner_routing", "hold"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_review_count",
        "decision_count",
        "pass_count",
        "hold_count",
        "reject_count",
        "action_counts",
        "missing_review_keys"
      ],
      "properties": {
        "active_review_count": {"type": "integer", "minimum": 1},
        "decision_count": {"type": "integer", "minimum": 0},
        "pass_count": {"type": "integer", "minimum": 0},
        "hold_count": {"type": "integer", "minimum": 0},
        "reject_count": {"type": "integer", "minimum": 0},
        "action_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "missing_review_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/intakeDecision"}
    },
    "creative_rereview_policy": {
      "enum": [
        "director_synthesizes_g00_non_gate_feedback",
        "overall_routes_one_selected_complete_g30_route_without_automatic_merge",
        "cdd_internal_playback_checkpoint_without_founder_gate",
        "founder_direct_decision_skips_additional_llm_creative_verdict"
      ]
    },
    "automation_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_creative_write_performed",
        "decision_interpreted_or_rewritten",
        "downstream_invalidation_authored",
        "gate_status_inferred",
        "unnamed_field_lock_created"
      ],
      "properties": {
        "canonical_creative_write_performed": {"const": false},
        "decision_interpreted_or_rewritten": {"const": false},
        "downstream_invalidation_authored": {"const": false},
        "gate_status_inferred": {"const": false},
        "unnamed_field_lock_created": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cycleKind": {
      "enum": [
        "g00_direction_draft",
        "g10_song_lock",
        "g20_visual_identity_lock",
        "g30_fp_final",
        "g30_experiment_disposition",
        "g40_core_branch_authorization",
        "g50_branch_results",
        "video_playback_internal",
        "g60_playback_edit",
        "g70_release"
      ]
    },
    "decisionOwner": {
      "oneOf": [
        {"enum": ["creative_development_director", "overall_director", "edit_director"]},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": {"enum": ["creative_development_director", "overall_director", "edit_director"]},
            "surface": {"enum": ["overall_founder_conversation", "cdd_internal_checkpoint"]},
            "promotion_authority": {"enum": ["cannot_promote", "overall_final_acceptance"]},
            "owner_id": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "task_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "legalActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["attracted", "reject", "hold", "connect_these", "keep_only", "search_further", "direct_comment", "select_candidate", "pass", "reject_archive", "revise_experiment", "teaser_only", "teaser_first_full_mv_hold", "full_mv_development", "internal_pass", "internal_hold", "material_exception"]}
    },
    "affectedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_mode", "stage_id", "section_ids", "chunk_ids", "target_ids"],
      "properties": {
        "scope_mode": {"enum": ["sectionless", "single_section", "multi_section", "whole_film"]},
        "stage_id": {"type": "string", "minLength": 1},
        "section_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}},
        "chunk_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "core_cut_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "branch_cut_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "edit_shard_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "directorReviewBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "row"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row": {"type": "string", "minLength": 1},
        "pointer": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "dispatchIndexBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "row", "pointer"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row": {"type": "string", "minLength": 1},
        "pointer": {"type": "string", "minLength": 1}
      }
    },
    "workerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "lineage_id", "attempt_id", "session_id", "director_dispatch_index"],
      "properties": {
        "applicability": {"enum": ["worker_return", "mechanical_no_worker"]},
        "lineage_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "session_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "director_dispatch_index": {"$ref": "#/$defs/dispatchIndexBinding"}
      }
    },
    "founderLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["founder_receipt", "decision_export", "decision_intake"],
      "properties": {
        "founder_receipt": {"$ref": "#/$defs/artifactBinding"},
        "decision_export": {"$ref": "#/$defs/artifactBinding"},
        "decision_intake": {"$ref": "#/$defs/artifactBinding"}
      }
    },
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "level", "display_number", "label"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "level": {"enum": ["discovery", "direction", "whole_film", "section", "planning_cut", "core_cut", "branch_cut"]},
        "display_number": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "planning_cut_id": {"type": "string", "minLength": 1},
        "core_cut_id": {"type": "string", "minLength": 1},
        "branch_cut_id": {"type": "string", "minLength": 1}
      }
    },
    "intakeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_key",
        "cycle_kind",
        "review_mode",
        "action",
        "annotation",
        "routing_status",
        "stage_id",
        "revision_id",
        "decision_scope",
        "revision_scope",
        "affected_section_ids",
        "review_target",
        "decision_owner",
        "decision_question",
        "legal_actions",
        "affected_scope",
        "blocking_effect",
        "decision_epoch",
        "dispatch_id",
        "returned_output",
        "director_review",
        "founder_lineage",
        "worker_evidence"
      ],
      "properties": {
        "review_key": {"type": "string", "minLength": 1},
        "cycle_kind": {"$ref": "#/$defs/cycleKind"},
        "review_mode": {"$ref": "#/$defs/cycleKind"},
        "action": {
          "enum": ["attracted", "reject", "hold", "connect_these", "keep_only", "search_further", "direct_comment", "select_candidate", "pass", "reject_archive", "revise_experiment", "teaser_only", "teaser_first_full_mv_hold", "full_mv_development", "internal_pass", "internal_hold", "material_exception"]
        },
        "annotation": {"type": "string"},
        "related_card_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "named_field_locks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/[A-Za-z0-9_~./-]+$"}
        },
        "routing_status": {
          "enum": ["exploratory_signal", "g30_route_feedback", "candidate_selected_for_overall_promotion", "no_change_pass", "founder_hold", "founder_rejected", "experiment_disposition", "cdd_internal_pass", "cdd_internal_hold", "cdd_material_exception"]
        },
        "stage_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "decision_scope": {
          "enum": ["creative_selection", "reference_link", "screen_truth", "render_candidate", "video_prompt", "playback", "edit"]
        },
        "revision_scope": {"enum": ["none", "branch_cut", "core_cut", "section", "whole_film", "planning_cut"]},
        "affected_section_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "review_target": {"$ref": "#/$defs/reviewTarget"},
        "decision_owner": {"$ref": "#/$defs/decisionOwner"},
        "decision_question": {"type": "string", "minLength": 1},
        "legal_actions": {"$ref": "#/$defs/legalActions"},
        "affected_scope": {"$ref": "#/$defs/affectedScope"},
        "blocking_effect": {"enum": ["non_gating_signal_only", "only_explicitly_named_field_or_card_is_fixed", "advances_or_holds_only_bound_scope", "routes_derivative_scope_without_discarding_other_derivatives", "internal_playback_checkpoint_only"]},
        "decision_epoch": {"type": "string", "minLength": 1},
        "dispatch_id": {"type": "string", "minLength": 1},
        "returned_output": {"$ref": "#/$defs/artifactBinding"},
        "director_review": {"$ref": "#/$defs/directorReviewBinding"},
        "founder_lineage": {"$ref": "#/$defs/founderLineage"},
        "worker_evidence": {"$ref": "#/$defs/workerEvidence"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "select_candidate"}}, "required": ["action"]},
          "then": {"properties": {"routing_status": {"const": "candidate_selected_for_overall_promotion"}}}
        },
        {
          "if": {"properties": {"review_mode": {"const": "g30_fp_final"}, "action": {"enum": ["hold", "reject", "direct_comment"]}}, "required": ["review_mode", "action"]},
          "then": {"properties": {"routing_status": {"const": "g30_route_feedback"}}}
        },
        {
          "if": {"properties": {"action": {"const": "pass"}}, "required": ["action"]},
          "then": {"properties": {"routing_status": {"const": "no_change_pass"}}}
        },
        {
          "if": {"properties": {"action": {"const": "hold"}, "review_mode": {"enum": ["g10_song_lock", "g20_visual_identity_lock", "g30_experiment_disposition", "g40_core_branch_authorization", "g50_branch_results", "g60_playback_edit", "g70_release"]}}, "required": ["action", "review_mode"]},
          "then": {"properties": {"routing_status": {"const": "founder_hold"}, "annotation": {"minLength": 1}}}
        },
        {
          "if": {"properties": {"action": {"const": "reject"}, "review_mode": {"enum": ["g10_song_lock", "g20_visual_identity_lock", "g40_core_branch_authorization", "g50_branch_results", "g60_playback_edit", "g70_release"]}}, "required": ["action", "review_mode"]},
          "then": {"properties": {"routing_status": {"const": "founder_rejected"}, "annotation": {"minLength": 1}}}
        },
        {
          "if": {"properties": {"action": {"enum": ["reject_archive", "revise_experiment", "teaser_only", "teaser_first_full_mv_hold", "full_mv_development"]}}, "required": ["action"]},
          "then": {"properties": {"routing_status": {"const": "experiment_disposition"}}}
        },
        {
          "if": {"properties": {"action": {"const": "internal_pass"}}, "required": ["action"]},
          "then": {"properties": {"routing_status": {"const": "cdd_internal_pass"}}}
        },
        {
          "if": {"properties": {"action": {"const": "internal_hold"}}, "required": ["action"]},
          "then": {"properties": {"routing_status": {"const": "cdd_internal_hold"}, "annotation": {"minLength": 1}}}
        },
        {
          "if": {"properties": {"action": {"const": "material_exception"}}, "required": ["action"]},
          "then": {"properties": {"routing_status": {"const": "cdd_material_exception"}, "annotation": {"minLength": 1}}}
        }
      ]
    }
  }
}
