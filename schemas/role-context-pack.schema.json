{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/role-context-pack.schema.json",
  "title": "IDOL Graph-Projected Role Context Pack",
  "description": "Derived current-node operational context. Optional Founder quality rows are compact v3 pointer-bound advisory patterns only; raw feedback is forbidden. The pack has no creative, lock, review, promotion, generation, or external authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "pack_id",
    "source_envelope",
    "identity",
    "unload_after",
    "current_node",
    "authority_binding",
    "founder_context",
    "creative_source_pointers",
    "dependency_edges",
    "instruction_slices",
    "output_contract",
    "provider_binding",
    "hold_reasons",
    "projection"
  ],
  "properties": {
    "schema_version": {"const": "idol-role-context-pack.v1"},
    "status": {"enum": ["pass", "hold"]},
    "authority": {"const": "derived_read_only_no_creative_or_promotion_authority"},
    "pack_id": {"type": "string", "pattern": "^ROLE_CONTEXT_[A-Z0-9_]{3,160}$"},
    "activation_binding": {"$ref": "#/$defs/activationBinding"},
    "source_envelope": {"$ref": "#/$defs/sourceEnvelope"},
    "identity": {"$ref": "#/$defs/identity"},
    "unload_after": {"$ref": "#/$defs/nonEmpty"},
    "current_node": {"$ref": "#/$defs/currentNode"},
    "authority_binding": {"type": "object"},
    "founder_context": {"$ref": "#/$defs/founderContext"},
    "founder_quality_context": {"$ref": "#/$defs/founderQualityContext"},
    "creative_judgment_contract": {"$ref": "#/$defs/creativeJudgmentContract"},
    "graph_dispatch_identity": {"$ref": "#/$defs/graphDispatchIdentity"},
    "creative_source_pointers": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactPointer"}
    },
    "dependency_edges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependencyEdge"}
    },
    "instruction_slices": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/instructionSlice"}
    },
    "output_contract": {"type": "object"},
    "provider_binding": {"$ref": "#/$defs/providerBinding"},
    "hold_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "live_run_state": {"$ref": "#/$defs/liveRunState"},
    "projection": {"$ref": "#/$defs/projection"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {"properties": {"hold_reasons": {"maxItems": 0}}},
      "else": {"properties": {"hold_reasons": {"minItems": 1}}}
    },
    {
      "if": {"required": ["creative_judgment_contract"]},
      "then": {
        "required": ["activation_binding"],
        "properties": {
          "activation_binding": {
            "properties": {"writer": {"const": "graph_v2"}},
            "required": ["writer"]
          }
        },
        "oneOf": [
          {
            "not": {"required": ["graph_dispatch_identity"]},
            "properties": {
              "source_envelope": {
                "properties": {"kind": {"const": "startup_admission"}},
                "required": ["kind"]
              },
              "current_node": {
                "properties": {"state": {"const": "prepared"}},
                "required": ["state"]
              }
            }
          },
          {
            "required": ["graph_dispatch_identity"],
            "properties": {
              "source_envelope": {
                "properties": {
                  "kind": {"const": "department_dispatch"},
                  "path": {"$ref": "#/$defs/repositoryPath"},
                  "sha256": {"$ref": "#/$defs/sha256"}
                },
                "required": ["kind", "path", "sha256"]
              },
              "current_node": {
                "properties": {"state": {"enum": ["prepared", "launched", "returned"]}},
                "required": ["state"]
              }
            }
          }
        ]
      }
    },
    {
      "if": {"required": ["graph_dispatch_identity"]},
      "then": {"required": ["creative_judgment_contract"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "repositoryPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "currentFilePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "modelFacingCreativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "connection"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "locator": {"$ref": "#/$defs/nonEmpty"},
        "function": {"$ref": "#/$defs/nonEmpty"},
        "role_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "disposition": {"enum": ["applied", "combined", "held", "rejected"]},
        "purpose": {"$ref": "#/$defs/nonEmpty"},
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["connected", "not_connected", "hold"]},
            "reason": {"$ref": "#/$defs/nonEmpty"}
          }
        }
      }
    },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "purpose"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"$ref": "#/$defs/nonEmpty"},
        "locator": {"$ref": "#/$defs/nonEmpty"},
        "function": {"$ref": "#/$defs/nonEmpty"},
        "role_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "disposition": {"enum": ["applied", "combined", "held", "rejected"]}
      }
    },
    "activationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writer", "run_class", "switch_receipt"],
      "properties": {
        "writer": {"enum": ["legacy_pinned", "graph_v2"]},
        "run_class": {"type": "string", "minLength": 1},
        "switch_receipt": {
          "oneOf": [
            {"$ref": "#/$defs/graphSwitchReceipt"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"writer": {"const": "graph_v2"}}, "required": ["writer"]},
          "then": {
            "properties": {
              "run_class": {"const": "new_run"},
              "switch_receipt": {"$ref": "#/$defs/graphSwitchReceipt"}
            }
          },
          "else": {"properties": {"switch_receipt": {"type": "null"}}}
        }
      ]
    },
    "graphSwitchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "founder_authority", "graph_revision", "switch_boundary", "source_set_sha256", "verified_at"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/nonEmpty"},
        "founder_authority": {"const": "founder"},
        "graph_revision": {"const": "idol-graph-skill-load-profiles.v1"},
        "switch_boundary": {"const": "new_runs_only_after_verified_receipt"},
        "source_set_sha256": {"$ref": "#/$defs/sha256"},
        "verified_at": {"type": "string", "format": "date-time"}
      }
    },
    "sourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"enum": ["startup_admission", "department_dispatch", "profile_checkpoint"]},
        "path": {
          "oneOf": [
            {"$ref": "#/$defs/repositoryPath"},
            {"type": "null"}
          ]
        },
        "sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_root", "assignment_id", "role", "profile_id", "checkpoint_id", "stage_id", "section_ids"],
      "properties": {
        "run_root": {"$ref": "#/$defs/repositoryPath"},
        "assignment_id": {"$ref": "#/$defs/nonEmpty"},
        "role": {"$ref": "#/$defs/identifier"},
        "profile_id": {"$ref": "#/$defs/identifier"},
        "checkpoint_id": {"$ref": "#/$defs/identifier"},
        "stage_id": {"$ref": "#/$defs/identifier"},
        "section_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
        }
      }
    },
    "currentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "legal_next", "scope", "non_scope", "stop_conditions", "return_recipient"],
      "properties": {
        "state": {"$ref": "#/$defs/nonEmpty"},
        "legal_next": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "scope": {"type": "object"},
        "non_scope": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "stop_conditions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "return_recipient": {"type": "object"}
      }
    },
    "founderContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_epoch", "locks"],
      "properties": {
        "decision_epoch": {"type": ["string", "integer"], "minLength": 1},
        "locks": {"type": "array", "items": {"type": "object"}}
      }
    },
    "compactSignal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "compactSignals": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/compactSignal"}
    },
    "founderQualityApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_mode", "roles", "profile_ids", "stage_ids", "section_ids"],
      "properties": {
        "scope_mode": {"enum": ["exact_named_scope", "same_track_scope", "studio_confirmed_scope"]},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["overall_director", "creative_development_director", "edit_director", "department_worker", "section_owner", "edit_shard_worker"]}
        },
        "profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:\\*|[a-z][a-z0-9_]*)$"}
        },
        "stage_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:\\*|[a-z][a-z0-9_]*)$"}
        },
        "section_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:\\*|S[0-9]{2,}[A-Z]?)$"}
        }
      }
    },
    "founderQualityPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_id",
        "recurrence_key",
        "recurrence_count",
        "reason_summary",
        "pattern_type",
        "priority",
        "first_seen_at",
        "last_seen_at",
        "evidence_rollup_sha256",
        "positive_core",
        "avoid_signals",
        "director_actions",
        "review_questions",
        "applicability",
        "source_json_pointer"
      ],
      "properties": {
        "closure_id": {"type": "string", "pattern": "^FCF_[A-Z0-9][A-Z0-9_-]{2,79}$"},
        "recurrence_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "recurrence_count": {"type": "integer", "minimum": 1},
        "reason_summary": {"type": "string", "minLength": 1, "maxLength": 360},
        "pattern_type": {"enum": ["avoid_failure", "preserve_preference", "decision_rule", "review_question"]},
        "priority": {"type": "integer", "minimum": 1, "maximum": 100},
        "first_seen_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": "string", "format": "date-time"},
        "evidence_rollup_sha256": {"$ref": "#/$defs/sha256"},
        "positive_core": {"$ref": "#/$defs/compactSignals"},
        "avoid_signals": {"$ref": "#/$defs/compactSignals"},
        "director_actions": {"$ref": "#/$defs/compactSignals"},
        "review_questions": {"$ref": "#/$defs/compactSignals"},
        "applicability": {"$ref": "#/$defs/founderQualityApplicability"},
        "source_json_pointer": {"type": "string", "pattern": "^/founder_creative_closures/[0-9]+$"}
      }
    },
    "founderQualityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "source_sidecar", "selection_mode", "pattern_limit", "omitted_pattern_count", "patterns", "context_digest"],
      "properties": {
        "authority": {"const": "compact_advisory_context_no_lock_review_or_promotion_authority"},
        "source_sidecar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "schema_version"],
          "properties": {
            "path": {"$ref": "#/$defs/repositoryPath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "schema_version": {"const": "idol_harness_improvement_review.v3"}
          }
        },
        "selection_mode": {"const": "author_scoped_priority_then_recency_no_machine_similarity"},
        "pattern_limit": {"const": 12},
        "omitted_pattern_count": {"type": "integer", "minimum": 0},
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/founderQualityPattern"}
        },
        "context_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "creativeJudgmentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "registry", "registry_schema", "profile_release", "profile_release_schema", "profile_promotion", "profile_promotion_schema", "profile_promotion_validator", "artifact_schema", "validator", "profile_id", "profile_value_sha256", "profile"],
      "properties": {
        "authority": {"const": "criteria_projection_no_creative_or_promotion_authority"},
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "automation/graph-creative-judgment-registry.yaml"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "registry_schema": {"$ref": "#/$defs/currentFilePointer"},
        "profile_release": {"$ref": "#/$defs/currentFilePointer"},
        "profile_release_schema": {"$ref": "#/$defs/currentFilePointer"},
        "profile_promotion": {"$ref": "#/$defs/currentFilePointer"},
        "profile_promotion_schema": {"$ref": "#/$defs/currentFilePointer"},
        "profile_promotion_validator": {"$ref": "#/$defs/currentFilePointer"},
        "artifact_schema": {"$ref": "#/$defs/currentFilePointer"},
        "validator": {"$ref": "#/$defs/currentFilePointer"},
        "profile_id": {"$ref": "#/$defs/identifier"},
        "profile_value_sha256": {"$ref": "#/$defs/sha256"},
        "profile": {"type": "object"}
      }
    },
    "graphDispatchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "dispatch", "dispatch_id", "input_digest_sha256", "dispatch_lifecycle_state_at_projection", "run", "lane_id", "section_cohort_id", "section_ids", "logical_role", "assigned_owner", "output_writer", "reviewer", "return_recipient"],
      "properties": {
        "authority": {"const": "exact_copy_from_hash_bound_graph_dispatch_at_pack_creation"},
        "dispatch": {"$ref": "#/$defs/currentFilePointer"},
        "dispatch_id": {"$ref": "#/$defs/nonEmpty"},
        "input_digest_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_lifecycle_state_at_projection": {"enum": ["prepared", "launched", "returned"]},
        "run": {"$ref": "#/$defs/repositoryPath"},
        "lane_id": {"$ref": "#/$defs/nonEmpty"},
        "section_cohort_id": {"type": ["string", "null"], "minLength": 1},
        "section_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
        },
        "logical_role": {"$ref": "#/$defs/identifier"},
        "assigned_owner": {"$ref": "#/$defs/nonEmpty"},
        "output_writer": {"$ref": "#/$defs/graphDispatchOutputWriter"},
        "reviewer": {"$ref": "#/$defs/graphDispatchReviewer"},
        "return_recipient": {"$ref": "#/$defs/graphDispatchReturnRecipient"}
      }
    },
    "graphDispatchOutputWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "role", "session_id"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonEmpty"},
        "role": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "graphDispatchReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "role", "lane_id"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonEmpty"},
        "role": {"$ref": "#/$defs/identifier"},
        "lane_id": {"$ref": "#/$defs/nonEmpty"},
        "session_id": {"$ref": "#/$defs/nonEmpty"},
        "logical_lineage_id": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "graphDispatchReturnRecipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "role", "return_route"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonEmpty"},
        "role": {"$ref": "#/$defs/identifier"},
        "return_route": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_type", "from", "to", "invalidation_scope"],
      "properties": {
        "edge_type": {"enum": ["authority", "semantic", "provenance", "execution", "review", "provider"]},
        "from": {"$ref": "#/$defs/nonEmpty"},
        "to": {"$ref": "#/$defs/nonEmpty"},
        "invalidation_scope": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["whole_file", "markdown_heading", "pointer_only"]},
        "heading": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "markdown_heading"}}, "required": ["type"]},
          "then": {"required": ["heading"]},
          "else": {"not": {"required": ["heading"]}}
        }
      ]
    },
    "instructionSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "binding_kind",
        "path",
        "revision",
        "whole_file_sha256",
        "locator",
        "fragment_sha256",
        "runtime_read_mode",
        "source_read_verified_to_eof",
        "content",
        "selection_reason"
      ],
      "properties": {
        "binding_id": {"$ref": "#/$defs/identifier"},
        "binding_kind": {"enum": ["skill", "linked_read"]},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "revision": {"$ref": "#/$defs/nonEmpty"},
        "whole_file_sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/locator"},
        "fragment_sha256": {"$ref": "#/$defs/nullableSha256"},
        "runtime_read_mode": {"enum": ["inline_exact_full_file", "inline_exact_fragment", "pointer_with_structural_preflight"]},
        "source_read_verified_to_eof": {"const": true},
        "content": {"type": ["string", "null"]},
        "selection_reason": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "logical_profile_alias",
        "provider",
        "runtime_surface",
        "registry_path",
        "registry_sha256",
        "provider_profile_id",
        "provider_source_path",
        "provider_source_sha256",
        "exact_model",
        "reasoning_effort",
        "fallback_policy"
      ],
      "properties": {
        "status": {"enum": ["resolved", "hold"]},
        "logical_profile_alias": {"enum": ["frontier_director", "director_deep", "worker_high", "research_medium", "cursor_grok_explicit_selected_worker"]},
        "provider": {"enum": ["grok", "cursor", "unresolved"]},
        "runtime_surface": {"$ref": "#/$defs/nonEmpty"},
        "registry_path": {"const": "automation/harness-provider-profile-registry.yaml"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "provider_profile_id": {"type": ["string", "null"], "minLength": 1},
        "provider_source_path": {
          "oneOf": [
            {"$ref": "#/$defs/repositoryPath"},
            {"type": "null"}
          ]
        },
        "provider_source_sha256": {"$ref": "#/$defs/nullableSha256"},
        "exact_model": {"type": ["string", "null"], "minLength": 1},
        "reasoning_effort": {"type": ["string", "null"], "minLength": 1},
        "requested_provider_attestation": {"$ref": "#/$defs/requestedProviderAttestation"},
        "fallback_policy": {"const": "forbidden"}
      }
    },
    "requestedProviderAttestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_profile_alias": {"enum": ["frontier_director", "director_deep", "worker_high", "research_medium", "cursor_grok_explicit_selected_worker"]},
        "provider_profile_id": {"$ref": "#/$defs/nonEmpty"},
        "exact_model": {"$ref": "#/$defs/nonEmpty"},
        "reasoning_effort": {"$ref": "#/$defs/nonEmpty"},
        "provider_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "liveRunState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_hold_ids", "consumed_helper_ids", "run_followup_path"],
      "properties": {
        "open_hold_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "consumed_helper_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "run_followup_path": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_path",
        "registry_sha256",
        "profile_registry_path",
        "profile_registry_sha256",
        "source_set_sha256",
        "instruction_content_sha256",
        "original_word_count",
        "projected_word_count",
        "reduction_ratio",
        "pack_digest",
        "replacement_rule",
        "invalidation_policy"
      ],
      "properties": {
        "registry_path": {
          "enum": [
            "automation/harness-role-context-projection.yaml",
            "automation/graph-role-context-projection.yaml"
          ]
        },
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "profile_registry_path": {
          "enum": [
            "automation/harness-skill-load-profiles.yaml",
            "automation/graph-skill-load-profiles.yaml"
          ]
        },
        "profile_registry_sha256": {"$ref": "#/$defs/sha256"},
        "source_set_sha256": {"$ref": "#/$defs/sha256"},
        "instruction_content_sha256": {"$ref": "#/$defs/sha256"},
        "original_word_count": {"type": "integer", "minimum": 1},
        "projected_word_count": {"type": "integer", "minimum": 0},
        "reduction_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "pack_digest": {"$ref": "#/$defs/sha256"},
        "replacement_rule": {"const": "runtime_pack_replaces_broad_instruction_reads_and_is_not_an_additional_required_layer"},
        "invalidation_policy": {"const": "bound_fragment_or_exact_dependency_change_only_except_always_on_authority"},
        "model_facing_creative_sources": {
          "type": "array",
          "description": "Derived adapter view of creative_source_pointers. No SHA-256 fields. Connection status is computed from the envelope pointers plus disk.",
          "items": {"$ref": "#/$defs/modelFacingCreativeSource"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"registry_path": {"const": "automation/graph-role-context-projection.yaml"}},
            "required": ["registry_path"]
          },
          "then": {"properties": {"profile_registry_path": {"const": "automation/graph-skill-load-profiles.yaml"}}},
          "else": {"properties": {"profile_registry_path": {"const": "automation/harness-skill-load-profiles.yaml"}}}
        }
      ]
    }
  }
}
