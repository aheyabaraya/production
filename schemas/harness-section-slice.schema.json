{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/harness-section-slice.schema.json",
  "title": "IDOL Graph Engineering Section Slice And Transition Handoff",
  "description": "Payload contract for one physical section work unit. Audio, visual, beat, and cue identifiers stay in explicit namespaces; transition handoffs preserve the observable song, body/object, composition, camera/edit, space/object, and continuity boundary needed by the adjacent slice and the final merge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_kind",
    "slice_id",
    "stage_id",
    "id_namespace",
    "source_bindings",
    "section_goal",
    "section_function",
    "reference_function_transfers",
    "selected_reference_fragments",
    "timing",
    "identity_and_subject",
    "screen_event",
    "direction_decisions",
    "section_visual_quality_note",
    "transition_in",
    "transition_out",
    "mechanical_merge",
    "merge_contract",
    "output_paths",
    "open_questions",
    "blockers",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "idol-harness-section-slice.v1"},
    "contract_kind": {"const": "section_slice"},
    "output_kind": {
      "const": "pre_02a_section_working_shard",
      "description": "Optional dispatch discriminator for a non-canonical, source-backed Front Planning/01/02A section work result. Omission preserves the existing canonical section-slice contract."
    },
    "slice_id": {"$ref": "#/$defs/nonEmptyString"},
    "stage_id": {"$ref": "#/$defs/identifier"},
    "id_namespace": {"$ref": "#/$defs/idNamespace"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "section_goal": {"$ref": "#/$defs/nonEmptyString"},
    "section_function": {"$ref": "#/$defs/nonEmptyString"},
    "reference_function_transfers": {
      "type": "array",
      "items": {"$ref": "#/$defs/referenceFunctionTransfer"}
    },
    "selected_reference_fragments": {
      "type": "array",
      "items": {"$ref": "#/$defs/referenceFragment"}
    },
    "selected_reference_application_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^APP_[A-Z0-9_]{2,80}$"},
      "uniqueItems": true,
      "description": "Pointer-only selected 01 research application ids. Raw research paths and observations remain upstream."
    },
    "timing": {"$ref": "#/$defs/timing"},
    "identity_and_subject": {"$ref": "#/$defs/identityAndSubject"},
    "screen_event": {"$ref": "#/$defs/screenEvent"},
    "direction_decisions": {"$ref": "#/$defs/directionDecisions"},
    "section_visual_quality_note": {"$ref": "#/$defs/nonEmptyString"},
    "transition_in": {"$ref": "#/$defs/transitionHandoff"},
    "transition_out": {"$ref": "#/$defs/transitionHandoff"},
    "mechanical_merge": {"$ref": "#/$defs/mechanicalMerge"},
    "merge_contract": {"$ref": "#/$defs/mergeContract"},
    "output_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "open_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "status": {
      "enum": ["draft", "done", "blocked", "needs_founder"]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sectionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "nullableSectionId": {
      "oneOf": [
        {"$ref": "#/$defs/sectionId"},
        {"type": "null"}
      ]
    },
    "idNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_section_id",
        "source_audio_section_ids",
        "visual_section_id",
        "beat_ids",
        "cue_ids",
        "cut_ids",
        "packet_ids"
      ],
      "properties": {
        "audio_section_id": {"$ref": "#/$defs/sectionId"},
        "source_audio_section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "visual_section_id": {"$ref": "#/$defs/sectionId"},
        "beat_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "cue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "cut_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "packet_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        }
      }
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_ref_ids", "feedback_ref_ids"],
      "properties": {
        "upstream_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "feedback_ref_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "referenceFunctionTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref_id",
        "source_identity",
        "followed_surface",
        "current_song_translation",
        "reject_guard"
      ],
      "properties": {
        "source_ref_id": {"$ref": "#/$defs/identifier"},
        "source_identity": {"$ref": "#/$defs/nonEmptyString"},
        "followed_surface": {"$ref": "#/$defs/nonEmptyString"},
        "current_song_translation": {"$ref": "#/$defs/nonEmptyString"},
        "reject_guard": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "referenceFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_id", "source_ref_id", "direct_follow_surfaces"],
      "properties": {
        "fragment_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_ref_id": {"$ref": "#/$defs/identifier"},
        "direct_follow_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_seconds",
        "end_seconds",
        "primary_audio_section_cue",
        "backing_rhythm_trigger"
      ],
      "properties": {
        "start_seconds": {"type": "number"},
        "end_seconds": {"type": "number", "minimum": 0},
        "primary_audio_section_cue": {"$ref": "#/$defs/nonEmptyString"},
        "lyric_or_no_lyric_cue": {"$ref": "#/$defs/nonEmptyString", "description": "Legacy compatibility field."},
        "lyric_original_text": {"$ref": "#/$defs/nonEmptyString", "description": "Exact contiguous selected-audio lyric words only; omit when no lyric text needs to travel."},
        "lyric_or_no_lyric_meaning_guard": {"$ref": "#/$defs/nonEmptyString", "description": "Legacy compatibility field."},
        "backing_rhythm_trigger": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "identityAndSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_owner",
        "unit_owner",
        "frame_subject_mode",
        "visual_system_anchor"
      ],
      "properties": {
        "member_owner": {"type": ["string", "null"]},
        "unit_owner": {"type": ["string", "null"]},
        "frame_subject_mode": {
          "enum": [
            "member_led",
            "unit_or_group_led",
            "world_object_led",
            "environment_insert",
            "system_transition",
            "mixed_member_world"
          ]
        },
        "visual_system_anchor": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "screenEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_subject",
        "location",
        "visible_action",
        "face_or_gaze",
        "composition_lock",
        "camera_view"
      ],
      "properties": {
        "visible_subject": {"$ref": "#/$defs/nonEmptyString"},
        "location": {"$ref": "#/$defs/nonEmptyString"},
        "visible_action": {"$ref": "#/$defs/nonEmptyString"},
        "face_or_gaze": {"$ref": "#/$defs/nonEmptyString"},
        "composition_lock": {"$ref": "#/$defs/nonEmptyString"},
        "camera_view": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "directionDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_decision",
        "space_or_object_decision",
        "wardrobe_or_material_decision",
        "performance_or_body_decision"
      ],
      "properties": {
        "camera_decision": {"$ref": "#/$defs/nonEmptyString"},
        "camera_route_spec": {"$ref": "#/$defs/cameraRouteSpec"},
        "space_or_object_decision": {"$ref": "#/$defs/nonEmptyString"},
        "wardrobe_or_material_decision": {"$ref": "#/$defs/nonEmptyString"},
        "performance_or_body_decision": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "cameraRouteSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "route_id", "summary", "shot_scale_family", "camera_height", "direction_angle", "depth_design", "movement_family", "base_speed", "composition_family", "lens_feel", "audio_story_job", "refuse_defaults"],
      "properties": {
        "contract_version": {"const": "camera_direction.v2"},
        "route_id": {"type": "string", "pattern": "^CAM_[A-Z0-9_]{2,80}$"},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "shot_scale_family": {"$ref": "#/$defs/nonEmptyString"},
        "camera_height": {"$ref": "#/$defs/nonEmptyString"},
        "direction_angle": {"$ref": "#/$defs/nonEmptyString"},
        "depth_design": {"$ref": "#/$defs/nonEmptyString"},
        "movement_family": {"$ref": "#/$defs/nonEmptyString"},
        "base_speed": {"$ref": "#/$defs/nonEmptyString"},
        "envelope": {"$ref": "#/$defs/nonEmptyString"},
        "composition_family": {"$ref": "#/$defs/nonEmptyString"},
        "lens_feel": {"$ref": "#/$defs/nonEmptyString"},
        "transition_family": {"$ref": "#/$defs/nonEmptyString"},
        "coverage_pattern": {"$ref": "#/$defs/nonEmptyString"},
        "audio_story_job": {"$ref": "#/$defs/nonEmptyString"},
        "refuse_defaults": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "intentional_repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "reason": {"$ref": "#/$defs/nonEmptyString"},
            "changing_surface": {"$ref": "#/$defs/nonEmptyString"}
          },
          "allOf": [
            {"if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}, "then": {"required": ["reason", "changing_surface"]}}
          ]
        }
      }
    },
    "sectionEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_section_id", "visual_section_id"],
      "properties": {
        "audio_section_id": {"$ref": "#/$defs/nullableSectionId"},
        "visual_section_id": {"$ref": "#/$defs/nullableSectionId"}
      }
    },
    "transitionTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_audio_section_cue",
        "backing_rhythm_trigger"
      ],
      "properties": {
        "primary_audio_section_cue": {"$ref": "#/$defs/nonEmptyString"},
        "lyric_or_no_lyric_cue": {"$ref": "#/$defs/nonEmptyString", "description": "Legacy compatibility field."},
        "lyric_original_text": {"$ref": "#/$defs/nonEmptyString", "description": "Exact contiguous selected-audio lyric words only; omit when no lyric text needs to travel."},
        "lyric_or_no_lyric_meaning_guard": {"$ref": "#/$defs/nonEmptyString", "description": "Legacy compatibility field."},
        "backing_rhythm_trigger": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "transitionHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "boundary_kind",
        "from",
        "to",
        "trigger",
        "body_or_formation_bridge",
        "composition_handoff",
        "camera_or_edit_bridge",
        "space_or_object_change",
        "continuity_locks",
        "feedback_ref_ids",
        "status",
        "blockers"
      ],
      "properties": {
        "handoff_id": {"$ref": "#/$defs/nonEmptyString"},
        "boundary_kind": {"enum": ["entry", "internal", "exit"]},
        "from": {"$ref": "#/$defs/sectionEndpoint"},
        "to": {"$ref": "#/$defs/sectionEndpoint"},
        "trigger": {"$ref": "#/$defs/transitionTrigger"},
        "body_or_formation_bridge": {"$ref": "#/$defs/nonEmptyString"},
        "composition_handoff": {"$ref": "#/$defs/nonEmptyString"},
        "camera_or_edit_bridge": {"$ref": "#/$defs/nonEmptyString"},
        "space_or_object_change": {"$ref": "#/$defs/nonEmptyString"},
        "continuity_locks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "feedback_ref_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "status": {"enum": ["draft", "ready", "blocked", "needs_founder"]},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "mechanicalMerge": {
      "type": "object",
      "description": "Opaque, lossless merge material. Automation may use these exact source indexes and embedded records to reconstruct the canonical artifact, but it may not reinterpret or rewrite creative content.",
      "additionalProperties": false,
      "required": [
        "source_ref_id",
        "source_content_digest",
        "record_groups",
        "round_trip_policy"
      ],
      "properties": {
        "source_ref_id": {"$ref": "#/$defs/identifier"},
        "source_content_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_groups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mechanicalRecordGroup"}
        },
        "round_trip_policy": {"const": "lossless_replace_at_source_locators"}
      }
    },
    "mechanicalRecordGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "source_container_path",
        "source_container_kind",
        "source_record_indexes",
        "source_record_keys",
        "source_record_ids",
        "embedded_records"
      ],
      "properties": {
        "group_id": {"$ref": "#/$defs/identifier"},
        "source_container_path": {
          "type": "array",
          "items": {"type": ["string", "integer"]}
        },
        "source_container_kind": {"enum": ["array", "object", "root"]},
        "source_record_indexes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "source_record_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "source_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "embedded_records": {
          "type": "array",
          "minItems": 1,
          "items": {}
        }
      }
    },
    "mergeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_artifact",
        "merge_key",
        "sequence_index",
        "required_merge_checks"
      ],
      "properties": {
        "canonical_artifact": {"$ref": "#/$defs/nonEmptyString"},
        "merge_key": {"$ref": "#/$defs/nonEmptyString"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "required_merge_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "section_boundary_continuity",
              "repeated_hook_variation",
              "member_balance",
              "frame_subject_variety",
              "world_object_system_continuity",
              "space_variety",
              "wardrobe_rotation",
              "source_traceability",
              "rhythm_preservation",
              "packet_export_count_alignment",
              "motion_continuity",
              "audio_marker_alignment",
              "founder_gate_preserved"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["output_kind"]
      },
      "then": {
        "properties": {
          "stage_id": {
            "enum": [
              "front_planning_integration",
              "mv_performance_direction",
              "mv_storyboard_direction"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "done"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "transition_in": {
            "properties": {"status": {"const": "ready"}}
          },
          "transition_out": {
            "properties": {"status": {"const": "ready"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["blocked", "needs_founder"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blockers": {"minItems": 1}
        }
      }
    }
  ]
}
