        },
        "status": {"enum": ["draft", "founder_review", "passed", "hold", "rejected"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "choreography_presence_policy": {"enum": ["primary", "supporting"]}
            },
            "required": ["choreography_presence_policy"]
          },
          "then": {
            "properties": {"choreography_reference_binding": {"type": "object"}}
          },
          "else": {
            "properties": {"choreography_reference_binding": {"type": "null"}}
          }
        }
      ]
    },
    "downstream02AContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
