        },
        "new_core_cut_rule": {
          "const": "a_new_governing_event_requires_a_new_core_cut_while_a_materially_different_revelation_of_the_same_event_is_a_branch_cut"
        },
        "reference_binding_rule": {
          "const": "bind_selected_sequence_cells_crops_or_scene_images_individually_with_path_sha256_and_preserved_grammar"
        },
        "member_visual_rule": {
          "const": "current_title_package_only_smallest_branch_cut_relevant_subset_no_member_visual_when_no_member_is_visible"
        },
        "still_camera_rule": {
          "const": "01_authors_core_camera_composition_depth_and_02A_authors_each_branch_variation"
        },
        "key_screen_lineage_rule": {
          "const": "02A_consumes_the_01_section_hash_that_preserves_each_director_quality_passed_front_planning_key_screen_anchor_and_its_expansion"
        },
        "storyline_lineage_rule": {
          "const": "02A_exact_copies_the_whole_film_section_and_planning_cut_alignment_pointers_values_and_hashes_before_expanding_core_and_branch_cuts"
        },
        "pre00_audience_target_lineage_rule": {
          "const": "02A_exact_copies_01_pre00_audience_profiles_x_envelope_and_title_target_intersection_projection"
        },
        "temporal_camera_rule": {
          "const": "03V_authors_push_pull_pan_tilt_track_orbit_speed_envelope_start_and_stop_after_pixels_pass"
