{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/song-choreography-performance-mv-map.schema.json",
  "title": "IDOL 01 Official Core Storyboard",
  "description": "Active 3.0 contract only. 01 exact-projects the selected FP v17 route, active full-text storyline, screen progression map, derivative and production scope, and owns every Official Core Cut in that scope with exactly one actual primary image. 02A imports these Core bytes unchanged and authors Branch Cuts only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "status",
    "source_front_planning",
    "imported_fp_head",
    "derivative_route_id",
    "production_scope_id",
    "source_song_lock",
    "director_role",
    "front_planning_consumption_contract",
    "storyline_lineage_projection",
    "pre00_audience_target_lineage_projection",
    "target_message_projection",
    "whole_film_spine_projection",
    "founder_visual_alignment_projection",
    "screen_progression_map_projection",
    "section_directions",
    "official_core_cuts",
    "hero_core_adoptions",
    "core_storyboard",
    "branch_expansion_needs",
    "section_camera_composition_depth_progression",
    "core_motion_readiness_map",
    "whole_film_core_review",
    "downstream_02a_contract",
    "review_surface",
    "open_questions"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "content_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "founder_review", "passed", "hold", "rejected"]},
    "source_front_planning": {"$ref": "#/$defs/artifactRef"},
    "imported_fp_head": {"$ref": "#/$defs/importedFpHead"},
    "derivative_route_id": {"type": "string", "pattern": "^DERIV_[A-Z0-9_]{2,100}$"},
    "production_scope_id": {"type": "string", "pattern": "^PSCOPE_[A-Z0-9_]{2,100}$"},
    "source_song_lock": {"$ref": "#/$defs/artifactRef"},
    "director_role": {
      "const": "creative_development_director_directs_and_reviews_01_story_staging_visual_choreography_and_still_camera_working_shards_overall_director_inspects_and_promotes_exact_bytes"
    },
    "front_planning_consumption_contract": {"$ref": "#/$defs/consumptionContract"},
    "storyline_lineage_projection": {"$ref": "#/$defs/valueProjection"},
    "pre00_audience_target_lineage_projection": {"$ref": "#/$defs/valueProjection"},
    "target_message_projection": {"$ref": "#/$defs/valueProjection"},
    "whole_film_spine_projection": {"$ref": "#/$defs/valueProjection"},
    "founder_visual_alignment_projection": {"$ref": "#/$defs/valueProjection"},
    "screen_progression_map_projection": {"$ref": "#/$defs/valueProjection"},
    "section_directions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sectionDirection"}
    },
    "official_core_cuts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/officialCoreCut"}},
    "hero_core_adoptions": {"type": "array", "items": {"$ref": "#/$defs/heroCoreAdoption"}},
    "core_storyboard": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}},
    "branch_expansion_needs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branchExpansionNeed"}},
    "section_camera_composition_depth_progression": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sectionCameraProgression"}},
    "core_motion_readiness_map": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coreMotionReadiness"}},
    "whole_film_core_review": {"$ref": "#/$defs/wholeFilmCoreReview"},
    "downstream_02a_contract": {"$ref": "#/$defs/downstream02AContract"},
    "review_surface": {"$ref": "#/$defs/reviewSurface"},
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "importedFpHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "selected_candidate_route_id", "active_storyline_version_id", "active_storyline_sha256", "screen_progression_map_id", "screen_progression_map_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "front-planning-readiness.v17"},
        "selected_candidate_route_id": {"enum": ["FP-A", "FP-B", "FP-C"]},
        "active_storyline_version_id": {"type": "string", "minLength": 1},
        "active_storyline_sha256": {"$ref": "#/$defs/sha256"},
        "screen_progression_map_id": {"type": "string", "pattern": "^SPM_[A-Z0-9_]{2,100}$"},
        "screen_progression_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coreReferenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "binding_id": {"type": "string", "pattern": "^CRB_[A-Z0-9_]{2,100}$"},
        "selected_reference_candidate_id": {"type": "string", "pattern": "^CVC_[A-Z0-9_]{2,100}$"},
        "source_type": {"enum": ["sequence_frame", "sequence_crop", "pinterest", "registered_still", "other_approved"]},
        "actual_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "pixel_inspection_status": {"const": "inspected"},
        "governing_functions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_to_screen_delta": {"type": "string", "minLength": 1},
        "founder_reference_waiver": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["exact_core_cut_id", "authored_by", "reason"],
              "properties": {
                "exact_core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
                "authored_by": {"const": "founder"},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": ["required", "binding_id", "selected_reference_candidate_id", "source_type", "actual_path", "sha256", "pixel_inspection_status", "governing_functions", "source_to_screen_delta", "founder_reference_waiver"],
          "properties": {"required": {"const": true}, "founder_reference_waiver": {"type": "null"}}
        },
        {
          "required": ["required", "founder_reference_waiver"],
          "properties": {"required": {"const": false}, "founder_reference_waiver": {"type": "object"}},
          "not": {"anyOf": [{"required": ["binding_id"]}, {"required": ["selected_reference_candidate_id"]}, {"required": ["actual_path"]}, {"required": ["sha256"]}]}
        }
      ]
    },
    "primaryCoreImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actual_path", "sha256", "pixel_review"],
      "properties": {
        "status": {"const": "pass"},
        "actual_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "pixel_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "note"],
          "properties": {"verdict": {"const": "pass"}, "note": {"type": "string", "minLength": 1}}
        }
      }
    },
    "motionReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_vector", "lead_or_reveal_room", "depth_layers", "occlusion_plan", "crop_safe_room", "start_end_potential", "transition_vector"],
      "properties": {
        "action_vector": {"type": "string", "minLength": 1},
        "lead_or_reveal_room": {"type": "string", "minLength": 1},
        "depth_layers": {"type": "string", "minLength": 1},
        "occlusion_plan": {"type": "string", "minLength": 1},
        "crop_safe_room": {"type": "string", "minLength": 1},
        "start_end_potential": {"type": "string", "minLength": 1},
        "transition_vector": {"type": "string", "minLength": 1}
      }
    },
    "officialCoreCut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_cut_id", "parent_major_scene_id", "scene_phase_context", "source_core_slot_id", "active_storyline_version_id", "screen_progression_node_id", "section_id", "order_within_section", "parent_major_order", "primary_audio_cue", "required_screen_information", "visible_subject", "visible_action_or_hold", "visible_state_change", "environment_and_depth", "camera", "composition", "motion_readiness", "identity_when_visible", "member_visual_applicability", "core_reference_binding", "supporting_reference_bindings", "sequence_phase_bindings", "continuity_in", "continuity_out", "primary_image", "branch_expansion_need"],
      "properties": {
        "core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "parent_major_scene_id": {"type": "string", "pattern": "^MJ[0-9]{2,}$"},
        "scene_phase_context": {"type": "string", "minLength": 1},
        "source_core_slot_id": {"type": "string", "pattern": "^CS[0-9]{2,}[A-Z0-9_]*$"},
        "active_storyline_version_id": {"type": "string", "minLength": 1},
        "screen_progression_node_id": {"type": "string", "pattern": "^SPN_[A-Z0-9_]{2,100}$"},
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "order_within_section": {"type": "integer", "minimum": 1},
        "parent_major_order": {"type": "integer", "minimum": 1},
        "primary_audio_cue": {"type": "string", "minLength": 1},
        "required_screen_information": {"type": "string", "minLength": 1},
        "visible_subject": {"type": "string", "minLength": 1},
        "visible_action_or_hold": {"type": "string", "minLength": 1},
        "visible_state_change": {"type": "string", "minLength": 1},
        "environment_and_depth": {"type": "string", "minLength": 1},
        "camera": {"type": "object", "minProperties": 5},
        "composition": {"type": "string", "minLength": 1},
        "motion_readiness": {"$ref": "#/$defs/motionReadiness"},
        "identity_when_visible": {"type": "string", "minLength": 1},
        "member_visual_applicability": {"enum": ["meaningfully_visible", "visible_but_member_visual_unnecessary", "not_visible"]},
        "core_reference_binding": {"$ref": "#/$defs/coreReferenceBinding"},
        "supporting_reference_bindings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sequence_phase_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SEQU_[A-Z0-9_]{2,100}$"}},
        "continuity_in": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "continuity_out": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "primary_image": {"$ref": "#/$defs/primaryCoreImage"},
        "branch_expansion_need": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "heroCoreAdoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_core_candidate_id", "output_path", "output_sha256", "adopted_as_core_cut_id", "semantic_equivalence_review", "current_section_review", "input_lineage_preserved"],
      "properties": {
        "hero_core_candidate_id": {"type": "string", "pattern": "^HERO_[A-Z0-9_]{2,100}$"},
        "output_path": {"type": "string", "minLength": 1},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "adopted_as_core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "semantic_equivalence_review": {"type": "string", "minLength": 1},
        "current_section_review": {"const": "pass"},
        "input_lineage_preserved": {"const": true}
      }
    },
    "branchExpansionNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_cut_id", "needed_contributions"],
      "properties": {"core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}, "needed_contributions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "sectionCameraProgression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "ordered_core_cut_ids", "progression_read"],
      "properties": {"section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}, "ordered_core_cut_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}}, "progression_read": {"type": "string", "minLength": 1}}
    },
    "coreMotionReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_cut_id", "motion_readiness"],
      "properties": {"core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}, "motion_readiness": {"$ref": "#/$defs/motionReadiness"}}
    },
    "wholeFilmCoreReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reviewed_core_cut_ids", "anchor_progression_read", "camera_depth_repetition_review"],
      "properties": {"verdict": {"enum": ["pass", "hold", "reject"]}, "reviewed_core_cut_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}}, "anchor_progression_read": {"type": "string", "minLength": 1}, "camera_depth_repetition_review": {"type": "string", "minLength": 1}}
    },
    "valueProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_json_pointer", "source_value_sha256", "projected_value"],
      "properties": {
        "source_json_pointer": {"type": "string", "pattern": "^/.+"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {}
      }
    },
    "sectionAlignmentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "source_json_pointer", "source_value_sha256", "projected_value"],
      "properties": {
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "source_json_pointer": {"type": "string", "pattern": "^/founder_visual_alignment/section_readouts/[0-9]+$"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {}
      }
    },
    "planningCutAlignmentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_cut_id", "source_key_screen_id", "source_json_pointer", "source_value_sha256", "projected_value"],
      "properties": {
        "planning_cut_id": {"type": "string", "pattern": "^PC_[A-Z0-9_]{2,100}$"},
        "source_key_screen_id": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"},
        "source_json_pointer": {"type": "string", "pattern": "^/founder_visual_alignment/planning_cut_readouts/[0-9]+$"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {}
      }
    },
    "consumptionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_message",
        "storyline_lineage",
        "pre00_audience_target_lineage",
        "visual_identity",
        "section_member_assignment",
        "major_scene_flow",
        "key_screen_anchors",
        "reference_interpretations",
        "founder_visual_alignment",
        "reopen_rule",
        "separate_01a_artifact"
      ],
      "properties": {
        "target_message": {"const": "exact_projection_no_reselection"},
        "storyline_lineage": {"const": "exact_project_complete_pre00_root_active_full_text_revision_history_density_review_and_reference_receipts_no_summary_substitution"},
        "pre00_audience_target_lineage": {"const": "exact_project_pre00_audience_profiles_x_envelope_and_title_target_intersection_without_reinterpretation"},
        "visual_identity": {"const": "current_title_package_exact_projection_no_cross_title_substitution"},
        "section_member_assignment": {"const": "exact_projection_unless_founder_reopens_the_section"},
        "major_scene_flow": {"const": "expand_staging_without_replacing_the_front_planning_scene_job"},
        "key_screen_anchors": {
          "const": "expand_director_quality_passed_key_screen_anchors_without_replacing_their_visible_action_still_camera_composition_current_title_visuals_or_reference_function_bindings"
        },
        "reference_interpretations": {"const": "consume_hash_bound_interpretation_and_preserve_direct_grammar"},
        "founder_visual_alignment": {"const": "exact_project_whole_film_section_and_planning_cut_readouts_without_paraphrase_or_detail_loss"},
        "reopen_rule": {
          "const": "changed_bytes_or_meaning_incomplete_lock_identity_safety_feasibility_conflict_or_explicit_founder_rereview_only"
        },
        "separate_01a_artifact": {"const": false}
      }
    },
    "sectionSourceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "source_json_pointer",
        "source_value_sha256",
        "assigned_member_ids",
        "screen_carrier",
        "member_visual_asset_ids",
        "background_world_asset_ids",
        "sequence_unit_ids",
        "scene_reference_unit_ids",
        "major_scene_ids",
        "key_screen_anchor_ids"
      ],
      "properties": {
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "source_json_pointer": {"type": "string", "pattern": "^/section_plan/[0-9]+$"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "assigned_member_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M(0[1-9]|1[0-3])$"}
        },
        "screen_carrier": {
          "enum": [
            "member_led",
            "unit_or_group_led",
            "world_object_led",
            "environment_insert",
            "system_transition",
            "mixed_member_world"
          ]
        },
        "member_visual_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "background_world_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sequence_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "scene_reference_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "major_scene_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "key_screen_anchor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"}
        }
      }
    },
    "referenceApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "reference_unit_id",
        "source_path",
        "source_sha256",
        "direct_use_mode",
        "scene_or_sequence_target",
        "preserved_action_or_hold",
        "preserved_staging",
        "preserved_still_camera",
        "preserved_subject_placement_and_crop",
        "preserved_ordered_grammar",
        "intentional_deviation",
        "02a_binding_rule"
      ],
      "properties": {
        "application_id": {"type": "string", "pattern": "^VRB_[A-Z0-9_]{2,80}$"},
        "reference_unit_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {
          "enum": ["main_reference", "supporting_visual_reference"]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Exact authored main/support job inherited from the selected Front Planning unit; required by validation for Pinterest applications."
        },
        "direct_use_mode": {
          "enum": ["bounded_surface_direct", "full_scene_direct", "sequence_direct"]
        },
        "scene_or_sequence_target": {"type": "string", "minLength": 1},
        "preserved_action_or_hold": {"type": "string", "minLength": 1},
        "preserved_staging": {"type": "string", "minLength": 1},
        "preserved_still_camera": {"type": "string", "minLength": 1},
        "preserved_subject_placement_and_crop": {"type": "string", "minLength": 1},
        "preserved_ordered_grammar": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "intentional_deviation": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "02a_binding_rule": {
          "const": "bind_each_selected_cell_crop_or_frame_as_its_own_path_and_sha256_never_whole_sheet_fallback"
        }
      }
    },
    "branchingOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "source_key_screen_anchor_ids",
        "core_event_relation",
        "distinct_screen_contribution",
        "observable_action_or_hold",
        "space_object_or_relation_change",
        "still_camera_coverage_ids",
        "continuity_or_edit_use",
        "non_repetition_guard"
      ],
      "properties": {
        "opportunity_id": {"type": "string", "pattern": "^BO_[A-Z0-9_]{2,80}$"},
        "source_key_screen_anchor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"}
        },
        "core_event_relation": {
          "type": "string",
          "minLength": 1,
          "description": "Why this remains another screen realization of the same major event rather than a new core event."
        },
        "distinct_screen_contribution": {
          "type": "string",
          "minLength": 1,
          "description": "The new observable information or directorial job this opportunity would add."
        },
        "observable_action_or_hold": {"type": "string", "minLength": 1},
        "space_object_or_relation_change": {"type": "string", "minLength": 1},
        "still_camera_coverage_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "continuity_or_edit_use": {"type": "string", "minLength": 1},
        "non_repetition_guard": {
          "type": "string",
          "minLength": 1,
          "description": "What neighboring branch this must not merely repeat. Start/end labels alone are insufficient."
        }
      }
    },
    "sceneExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "source_key_screen_anchor_ids",
        "front_planning_scene_job",
        "space_blocking",
        "subject_entrance_and_position",
        "visible_action_or_hold",
        "acting_or_object_behavior",
        "object_environment_change",
        "still_camera_coverage_need",
        "branching_strategy",
        "branching_opportunities",
        "continuity_in",
        "continuity_out",
        "02a_core_cut_implication"
      ],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "source_key_screen_anchor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"}
        },
        "front_planning_scene_job": {"type": "string", "minLength": 1},
        "space_blocking": {"type": "string", "minLength": 1},
        "subject_entrance_and_position": {"type": "string", "minLength": 1},
        "visible_action_or_hold": {"type": "string", "minLength": 1},
        "acting_or_object_behavior": {"type": "string", "minLength": 1},
        "object_environment_change": {"type": "string", "minLength": 1},
        "still_camera_coverage_need": {"type": "string", "minLength": 1},
        "branching_strategy": {
          "type": "string",
          "minLength": 1,
          "description": "How the major event can produce materially different screens without becoming a start/end worksheet or a fixed category quota."
        },
        "branching_opportunities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/branchingOpportunity"}
        },
        "continuity_in": {"type": "string", "minLength": 1},
        "continuity_out": {"type": "string", "minLength": 1},
        "02a_core_cut_implication": {
          "type": "string",
          "minLength": 1,
          "description": "Which governing event should become a parent core cut and where a different event would require a new one."
        }
      }
    },
    "stillCameraCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_id",
        "scene_id",
        "source_key_screen_anchor_ids",
        "screen_readability_job",
        "shot_scale_distance",
        "camera_height",
        "direction_angle",
        "depth_design",
        "subject_placement",
        "crop_negative_space",
        "variation_reason",
        "temporal_camera_owner"
      ],
      "properties": {
        "coverage_id": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string", "minLength": 1},
        "source_key_screen_anchor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"}
        },
        "screen_readability_job": {"type": "string", "minLength": 1},
        "shot_scale_distance": {"type": "string", "minLength": 1},
        "camera_height": {"type": "string", "minLength": 1},
        "direction_angle": {"type": "string", "minLength": 1},
        "depth_design": {"type": "string", "minLength": 1},
        "subject_placement": {"type": "string", "minLength": 1},
        "crop_negative_space": {"type": "string", "minLength": 1},
        "variation_reason": {"type": "string", "minLength": 1},
        "temporal_camera_owner": {"const": "03V_after_passed_image_pixel_inspection"}
      }
    },
    "sequenceMotionDimensionDispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "alternate_view", "reveal_space", "rear_world_direction", "identity", "crop", "occlusion", "continuity", "start_landing"],
      "properties": {
        "depth": {"enum": ["adopt", "partial", "reject"]},
        "alternate_view": {"enum": ["adopt", "partial", "reject"]},
        "reveal_space": {"enum": ["adopt", "partial", "reject"]},
        "rear_world_direction": {"enum": ["adopt", "partial", "reject"]},
        "identity": {"enum": ["adopt", "partial", "reject"]},
        "crop": {"enum": ["adopt", "partial", "reject"]},
        "occlusion": {"enum": ["adopt", "partial", "reject"]},
        "continuity": {"enum": ["adopt", "partial", "reject"]},
        "start_landing": {"enum": ["adopt", "partial", "reject"]}
      }
    },
    "sequenceMotionAdoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "major_scene_id",
        "selected_sequence_composition_id",
        "overall_disposition",
        "dimension_dispositions",
        "authored_reason",
        "applied_official_core_cut_ids",
        "applied_still_camera_coverage_ids",
        "applied_branching_opportunity_ids"
      ],
      "properties": {
        "analysis_id": {"type": "string", "pattern": "^SMA_[A-Z0-9_]{2,100}$"},
        "major_scene_id": {"type": "string", "pattern": "^MJ[0-9]{2,}$"},
        "selected_sequence_composition_id": {"type": "string", "pattern": "^SCOMP_[A-Z0-9_]{2,100}$"},
        "overall_disposition": {"enum": ["adopt", "partial", "reject"]},
        "dimension_dispositions": {"$ref": "#/$defs/sequenceMotionDimensionDispositions"},
        "authored_reason": {"type": "string", "minLength": 1},
        "applied_official_core_cut_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}},
        "applied_still_camera_coverage_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "applied_branching_opportunity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BO_[A-Z0-9_]{2,80}$"}}
      },
      "allOf": [
        {
          "if": {"properties": {"overall_disposition": {"const": "reject"}}, "required": ["overall_disposition"]},
          "then": {
            "properties": {
              "dimension_dispositions": {
                "properties": {
                  "depth": {"const": "reject"},
                  "alternate_view": {"const": "reject"},
                  "reveal_space": {"const": "reject"},
                  "rear_world_direction": {"const": "reject"},
                  "identity": {"const": "reject"},
                  "crop": {"const": "reject"},
                  "occlusion": {"const": "reject"},
                  "continuity": {"const": "reject"},
                  "start_landing": {"const": "reject"}
                }
              },
              "applied_official_core_cut_ids": {"maxItems": 0},
              "applied_still_camera_coverage_ids": {"maxItems": 0},
              "applied_branching_opportunity_ids": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"overall_disposition": {"const": "adopt"}}, "required": ["overall_disposition"]},
          "then": {
            "properties": {
              "dimension_dispositions": {
                "properties": {
                  "depth": {"const": "adopt"},
                  "alternate_view": {"const": "adopt"},
                  "reveal_space": {"const": "adopt"},
                  "rear_world_direction": {"const": "adopt"},
                  "identity": {"const": "adopt"},
                  "crop": {"const": "adopt"},
                  "occlusion": {"const": "adopt"},
                  "continuity": {"const": "adopt"},
                  "start_landing": {"const": "adopt"}
                }
              }
            },
            "anyOf": [
              {"properties": {"applied_official_core_cut_ids": {"minItems": 1}}},
              {"properties": {"applied_still_camera_coverage_ids": {"minItems": 1}}},
              {"properties": {"applied_branching_opportunity_ids": {"minItems": 1}}}
            ]
          }
        }
      ]
    },
