{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/tiktok-studio-export.schema.json",
  "title": "IDOL TikTok Studio Export",
  "description": "idol_tiktok_studio_export.v1 normalized local records for Founder-provided TikTok Studio ZIP exports. These rows preserve report scope and missing-detail boundaries; they are not a publication ledger and do not infer unavailable audience or retention metrics.",
  "oneOf": [
    { "$ref": "#/$defs/import_record" },
    { "$ref": "#/$defs/account_daily_record" },
    { "$ref": "#/$defs/video_snapshot_record" }
  ],
  "$defs": {
    "schema_version": {
      "const": "idol_tiktok_studio_export.v1"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "detail_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_dimension", "status", "row_count"],
      "properties": {
        "source_dimension": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "populated",
            "not_in_export",
            "manual_ui_required",
            "request_failed"
          ]
        },
        "row_count": { "$ref": "#/$defs/non_negative_integer" },
        "reason_code": { "type": "string", "minLength": 1 }
      }
    },
    "source_archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "archive_sha256",
        "report_name",
        "member_name",
        "member_sha256",
        "member_modified_at",
        "row_count"
      ],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "report_name": {
          "enum": ["Overview.csv", "Viewers.csv", "Content.csv"]
        },
        "member_name": { "type": "string", "minLength": 1 },
        "member_sha256": { "$ref": "#/$defs/sha256" },
        "member_modified_at": { "$ref": "#/$defs/timestamp" },
        "row_count": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "archive_source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_sha256", "report_name", "source_row_number"],
      "properties": {
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "report_name": {
          "enum": ["Overview.csv", "Viewers.csv", "Content.csv"]
        },
        "source_row_number": { "type": "integer", "minimum": 2 }
      }
    },
    "detail_statuses": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/detail_status" }
    },
    "import_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "import_id",
        "import_fingerprint",
        "account_handle",
        "captured_at",
        "captured_at_precision",
        "source_archives",
        "available_metrics",
        "unavailable_detail_dimensions",
        "data_quality_notes",
        "deduplication",
        "mapping_summary",
        "importer_version"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "record_type": { "const": "import" },
        "import_id": { "type": "string", "minLength": 1 },
        "import_fingerprint": { "$ref": "#/$defs/sha256" },
        "account_handle": { "type": "string", "minLength": 1 },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "captured_at_precision": {
          "enum": ["zip_member_minute", "provided_iso8601"]
        },
        "source_archives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_archive" }
        },
        "available_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unavailable_detail_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "detail_statuses": { "$ref": "#/$defs/detail_statuses" },
        "data_quality_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deduplication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_duplicate_daily_rows_collapsed",
            "exact_duplicate_video_rows_collapsed",
            "conflicting_rows"
          ],
          "properties": {
            "exact_duplicate_daily_rows_collapsed": { "$ref": "#/$defs/non_negative_integer" },
            "exact_duplicate_video_rows_collapsed": { "$ref": "#/$defs/non_negative_integer" },
            "conflicting_rows": { "$ref": "#/$defs/non_negative_integer" }
          }
        },
        "mapping_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_platform_post_id_matches", "unmatched_video_count"],
          "properties": {
            "exact_platform_post_id_matches": { "$ref": "#/$defs/non_negative_integer" },
            "unmatched_video_count": { "$ref": "#/$defs/non_negative_integer" }
          }
        },
        "importer_version": { "const": "idol_tiktok_studio_importer.v1" }
      }
    },
    "account_daily_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "import_id",
        "account_handle",
        "observed_date",
        "overview",
        "viewers",
        "source_refs",
        "data_completeness",
        "known_gaps",
        "importer_version"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "record_type": { "const": "account_daily" },
        "import_id": { "type": "string", "minLength": 1 },
        "account_handle": { "type": "string", "minLength": 1 },
        "observed_date": { "$ref": "#/$defs/date" },
        "overview": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["video_views", "profile_views", "likes", "comments", "shares"],
          "properties": {
            "video_views": { "$ref": "#/$defs/non_negative_integer" },
            "profile_views": { "$ref": "#/$defs/non_negative_integer" },
            "likes": { "$ref": "#/$defs/non_negative_integer" },
            "comments": { "$ref": "#/$defs/non_negative_integer" },
            "shares": { "$ref": "#/$defs/non_negative_integer" }
          }
        },
        "viewers": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["total_viewers", "new_viewers", "returning_viewers"],
          "properties": {
            "total_viewers": { "type": ["integer", "null"], "minimum": 0 },
            "new_viewers": { "$ref": "#/$defs/non_negative_integer" },
            "returning_viewers": { "$ref": "#/$defs/non_negative_integer" }
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/archive_source_ref" }
        },
        "data_completeness": { "const": "partial" },
        "known_gaps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "importer_version": { "const": "idol_tiktok_studio_importer.v1" }
      }
    },
    "video_snapshot_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "import_id",
        "captured_at",
        "captured_at_precision",
        "account_handle",
        "platform",
        "platform_video_id",
        "video_url",
        "published_date",
        "published_date_year_inferred_from_capture",
        "video_title",
        "views",
        "likes",
        "comments",
        "shares",
        "engagement",
        "snapshot_kind",
        "mapping",
        "source_refs",
        "data_completeness",
        "known_gaps",
        "importer_version"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "record_type": { "const": "video_snapshot" },
        "import_id": { "type": "string", "minLength": 1 },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "captured_at_precision": {
          "enum": ["zip_member_minute", "provided_iso8601"]
        },
        "account_handle": { "type": "string", "minLength": 1 },
        "platform": { "const": "tiktok" },
        "platform_video_id": { "type": "string", "pattern": "^[0-9]{8,}$" },
        "video_url": { "type": "string", "format": "uri" },
        "published_date": { "$ref": "#/$defs/date" },
        "published_date_year_inferred_from_capture": { "type": "boolean" },
        "video_title": { "type": "string" },
        "views": { "$ref": "#/$defs/non_negative_integer" },
        "likes": { "$ref": "#/$defs/non_negative_integer" },
        "comments": { "$ref": "#/$defs/non_negative_integer" },
        "shares": { "$ref": "#/$defs/non_negative_integer" },
        "engagement": { "$ref": "#/$defs/non_negative_integer" },
        "snapshot_kind": { "const": "tiktok_studio_content_aggregate" },
        "mapping": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "post_id", "content_id"],
              "properties": {
                "status": { "const": "exact_platform_post_id" },
                "post_id": { "type": "string", "minLength": 1 },
                "content_id": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "post_id", "content_id"],
              "properties": {
                "status": { "const": "unmatched" },
                "post_id": { "type": "null" },
                "content_id": { "type": "null" }
              }
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/archive_source_ref" }
        },
        "data_completeness": { "const": "partial" },
        "known_gaps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "importer_version": { "const": "idol_tiktok_studio_importer.v1" }
      }
    }
  }
}
