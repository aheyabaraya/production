{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/edit-recipe.schema.json",
  "title": "IDOL Edit Recipe v3",
  "description": "04-owned source/timing/geometry/grade/delivery contract. Each Edit Segment exact-carries one marker-plan screen-progression node while playback owns timing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "status",
    "owner",
    "source_edit_map",
    "source_edit_marker_plan",
    "audio_program",
    "audio_path",
    "timebase",
    "render_spec",
    "color_pipeline",
    "timeline",
    "boundary_handle_contracts",
    "grade_profiles",
    "effects",
    "delivery_policy",
    "qc_requirements"
  ],
  "properties": {
    "schema_version": {"const": "idol_edit_recipe.v3"},
    "content_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,80}$"},
    "status": {"enum": ["draft", "preview_ready", "preview_passed", "locked_for_04fx", "final_render_ready", "hold"]},
    "owner": {"const": "04_edit"},
    "source_edit_map": {"$ref": "#/$defs/binding"},
    "source_edit_marker_plan": {"$ref": "#/$defs/binding"},
    "audio_program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "duration_seconds", "sample_rate", "channel_layout", "start_sample"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "sample_rate": {"type": "integer", "minimum": 8000},
        "channel_layout": {"type": "string", "minLength": 1},
        "start_sample": {"type": "integer", "minimum": 0}
      }
    },
    "audio_path": {"type": "string", "minLength": 1, "description": "Renderer audio pointer; must equal audio_program.path."},
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "start_timecode", "drop_frame", "frame_interval"],
      "properties": {
        "fps": {"$ref": "#/$defs/fps"},
        "start_timecode": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}[:;][0-9]{2}$"},
        "drop_frame": {"type": "boolean"},
        "frame_interval": {"const": "start_inclusive_end_exclusive"}
      }
    },
    "render_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "width", "height", "sample_aspect_ratio", "fit_mode", "background", "pixel_format"],
      "properties": {
        "fps": {"$ref": "#/$defs/fps"},
        "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
        "height": {"type": "integer", "minimum": 2, "multipleOf": 2},
        "sample_aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"},
        "fit_mode": {"enum": ["fit_pad", "fill_crop", "stretch"]},
        "background": {"type": "string", "minLength": 1},
        "pixel_format": {"type": "string", "minLength": 1}
      }
    },
    "color_pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_interpretation", "working_space", "transform", "delivery"],
      "properties": {
        "input_interpretation": {"type": "string", "minLength": 1},
        "working_space": {"type": "string", "minLength": 1},
        "transform": {"type": "string", "minLength": 1},
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color_range", "color_space", "color_transfer", "color_primaries"],
          "properties": {
            "color_range": {"type": "string", "minLength": 1},
            "color_space": {"type": "string", "minLength": 1},
            "color_transfer": {"type": "string", "minLength": 1},
            "color_primaries": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered Edit Segments selected by 04. A Branch Cut may support multiple segments, and one segment may combine several Branch-Cut-derived states through its hash-bound marker slot.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id", "slot", "marker_slot_ref", "screen_progression_node", "section_ids", "source", "source_sha256",
          "source_probe_ref", "source_probe_sha256", "source_in", "source_out", "output_in_frame", "output_out_frame",
          "duration_frames", "output_in", "output_out", "output_duration", "retime", "geometry"
        ],
        "properties": {
          "segment_id": {"type": "string", "pattern": "^SEG_[A-Z0-9_]{2,80}$", "description": "04 Edit Segment id; never reuse a Core-Cut or Branch-Cut id here."},
          "slot": {"type": "string", "pattern": "^R[0-9]{2}[A-Z]?$"},
          "marker_slot_ref": {"type": "string", "pattern": "^R[0-9]{2}[A-Z]?$"},
          "screen_progression_node": {"$ref": "#/$defs/editUnitScreenProgressionNode"},
          "section_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}},
          "source": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "source_probe_ref": {"type": "string", "minLength": 1},
          "source_probe_sha256": {"$ref": "#/$defs/sha256"},
          "source_in": {"type": "number", "minimum": 0},
          "source_out": {"type": "number", "exclusiveMinimum": 0},
          "output_in_frame": {"type": "integer", "minimum": 0},
          "output_out_frame": {"type": "integer", "minimum": 1},
          "duration_frames": {"type": "integer", "minimum": 1},
          "output_in": {"type": "number", "minimum": 0},
          "output_out": {"type": "number", "exclusiveMinimum": 0},
          "output_duration": {"type": "number", "exclusiveMinimum": 0},
          "retime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "speed_factor", "cadence_method", "cadence_qc_required"],
            "properties": {
              "mode": {"enum": ["constant", "hold", "variable_external_04"]},
              "speed_factor": {"type": "number", "exclusiveMinimum": 0},
              "cadence_method": {"enum": ["frame_sampling", "blend", "optical_flow_external", "intentional_hold"]},
              "cadence_qc_required": {"type": "boolean"},
              "note": {"type": "string"}
            }
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy", "anchor_x", "anchor_y"],
            "properties": {
              "policy": {"enum": ["inherit_render_spec", "fit_pad", "fill_crop", "stretch"]},
              "anchor_x": {"type": "number", "minimum": 0, "maximum": 1},
              "anchor_y": {"type": "number", "minimum": 0, "maximum": 1},
              "reframe_safe_area_note": {"type": "string"}
            }
          },
          "grade": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "boundary_handle_contracts": {
      "type": "array",
      "description": "04-owned Edit Boundary handles between adjacent Edit Segments. These are not Branch-Cut boundaries.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handle_id", "mode", "from_slot", "to_slot", "fixed_program_cut_frame",
          "transition_frames", "pre_cut_frames", "post_cut_frames"
        ],
        "properties": {
          "handle_id": {"type": "string", "pattern": "^HANDLE_[A-Z0-9_]{2,80}$"},
          "mode": {"const": "duration_preserving"},
          "from_slot": {"type": "string", "pattern": "^R[0-9]{2}[A-Z]?$"},
          "to_slot": {"type": "string", "pattern": "^R[0-9]{2}[A-Z]?$"},
          "fixed_program_cut_frame": {"type": "integer", "minimum": 1},
          "fixed_program_cut_seconds": {"type": "number", "minimum": 0},
          "transition_frames": {"type": "integer", "minimum": 1},
          "pre_cut_frames": {"type": "integer", "minimum": 0},
          "post_cut_frames": {"type": "integer", "minimum": 0},
          "04_preview_ref": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "grade_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filter", "working_space", "review_status"],
        "properties": {
          "filter": {"type": "string", "minLength": 1},
          "working_space": {"type": "string", "minLength": 1},
          "lut_path": {"type": "string"},
          "lut_sha256": {"$ref": "#/$defs/sha256"},
          "review_status": {"enum": ["preview_needed", "pass", "hold"]}
        }
      }
    },
    "effects": {"type": "array", "items": {"type": "object"}},
    "effects_compile_note": {"type": "object"},
    "delivery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mezzanine", "platform_derivatives", "audio_qc_targets"],
      "properties": {
        "mezzanine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container", "video_codec", "audio_codec", "chroma_policy"],
          "properties": {
            "container": {"enum": ["mp4", "mov", "mkv"]},
            "video_codec": {"type": "string", "minLength": 1},
            "audio_codec": {"type": "string", "minLength": 1},
            "chroma_policy": {"type": "string", "minLength": 1},
            "video_profile": {"type": ["string", "integer"]}
          }
        },
        "platform_derivatives": {"type": "array", "items": {"type": "string"}},
        "audio_qc_targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrated_lufs_target", "true_peak_ceiling_dbtp", "normalization_policy"],
          "properties": {
            "integrated_lufs_target": {"type": ["number", "null"]},
            "true_peak_ceiling_dbtp": {"type": "number"},
            "normalization_policy": {"const": "analysis_only_no_auto_normalize"}
          }
        }
      }
    },
    "qc_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_step_cutpoint_qc", "color_metadata_qc", "audio_delivery_qc", "retime_cadence_qc", "black_and_silence_qc"],
      "properties": {
        "frame_step_cutpoint_qc": {"type": "boolean", "const": true},
        "color_metadata_qc": {"type": "boolean", "const": true},
        "audio_delivery_qc": {"type": "boolean", "const": true},
        "retime_cadence_qc": {"type": "boolean", "const": true},
        "black_and_silence_qc": {"type": "boolean", "const": true}
      }
    }
  },
  "$defs": {
    "editUnitScreenProgressionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_progression_map_id", "screen_progression_node_id", "section_id", "major_scene_id", "core_cut_id", "branch_cut_ids", "source_03v_cue_ids", "storyline_role", "observable_screen_proof"],
      "properties": {
        "screen_progression_map_id": {"type": "string", "minLength": 1},
        "screen_progression_node_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "major_scene_id": {"type": "string", "minLength": 1},
        "core_cut_id": {"type": "string", "minLength": 1},
        "branch_cut_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_03v_cue_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "storyline_role": {"type": "string", "minLength": 1},
        "observable_screen_proof": {"type": "string", "minLength": 1}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    }
  }
}
