{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/image-generation-request-v8-legacy.schema.json",
  "title": "IDOL Image Generation Request v8 Legacy Reader",
  "description": "Active v7 execution envelope for exactly one 02B Branch Cut packet. It carries five required prompt items in their exact five-line serialization, parent Core Cut and Branch Cut identity, current-title member-visual inputs selected for that branch, and selected scene-reference inputs in declared order. Face-only is the sole upstream facial-identity source; after a current-title card passes, this request carries the passed card and has no second raw face-reference lane. It rejects cross-album member visuals unless the exact image was explicitly selected as a Founder direct scene reference. The request never infers paid-generation approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "run",
    "adapter",
    "source_02a",
    "source_02b",
    "packet_id",
    "core_cut_id",
    "branch_cut_id",
    "section_ids",
    "execution_section_id",
    "execution_section_assignment",
    "prompt",
    "member_visual_inputs",
    "member_visual_inputs_sha256",
    "scene_reference_inputs",
    "scene_reference_inputs_sha256",
    "attachment_order",
    "attachment_order_sha256",
    "execution_context",
    "quality_contract",
    "integrity_contract",
    "expected_output_path",
    "adapter_contract",
    "section_execution_contract",
    "approval",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "idol_image_generation_request.v8"},
    "content_id": {"type": "string", "minLength": 1},
    "run": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["openai_api", "codex_builtin_imagegen", "grok_image", "section_image_capable_worker"]},
    "source_02a": {"$ref": "#/$defs/sourceArtifact"},
    "source_02b": {"$ref": "#/$defs/sourceArtifact"},
    "packet_id": {"type": "string", "pattern": "^PKT_BC[0-9]{2,}_[A-Z0-9_]+$"},
    "core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
    "branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
    "section_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
    },
    "execution_section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
    "execution_section_assignment": {"$ref": "#/$defs/executionSectionAssignment"},
    "prompt": {"$ref": "#/$defs/prompt"},
    "member_visual_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/memberVisualInput"}
    },
    "member_visual_inputs_sha256": {"$ref": "#/$defs/sha256"},
    "scene_reference_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/sceneReferenceInput"}
    },
    "scene_reference_inputs_sha256": {"$ref": "#/$defs/sha256"},
    "attachment_order": {
      "type": "array",
      "items": {"$ref": "#/$defs/attachmentOrderItem"}
    },
    "attachment_order_sha256": {"$ref": "#/$defs/sha256"},
    "execution_context": {"$ref": "#/$defs/executionContext"},
    "quality_contract": {"$ref": "#/$defs/qualityContract"},
    "integrity_contract": {"$ref": "#/$defs/integrityContract"},
    "expected_output_path": {"type": "string", "minLength": 1},
    "adapter_contract": {"$ref": "#/$defs/adapterContract"},
    "section_execution_contract": {"$ref": "#/$defs/sectionExecutionContract"},
    "approval": {"$ref": "#/$defs/approval"},
    "status": {"enum": ["draft", "ready", "hold", "submitted", "completed", "failed"]},
    "hold_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "not": {
    "anyOf": [
      {"required": ["identity_inputs"]},
      {"required": ["identity_decision"]},
      {"required": ["face_reference_inputs"]}
    ]
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "executionSectionAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "section_id", "packet_ownership", "cross_section_rule"],
      "properties": {
        "mode": {"const": "one_request_one_packet_one_section"},
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "packet_ownership": {"const": "disjoint_section_worker"},
        "cross_section_rule": {"const": "never_load_or_merge_another_section_inside_this_request"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_reference_rule",
        "scene_intent",
        "visible_details",
        "action_cue",
        "avoid",
        "full_prompt_text",
        "full_prompt_sha256",
        "label_order"
      ],
      "properties": {
        "identity_reference_rule": {"type": "string", "minLength": 1},
        "scene_intent": {"type": "string", "minLength": 1},
        "visible_details": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {"pattern": "4K"},
            {"pattern": "high quality"},
            {"pattern": "high detail"}
          ]
        },
        "action_cue": {"type": "string", "minLength": 1},
        "avoid": {"type": "string", "minLength": 1},
        "full_prompt_text": {"type": "string", "minLength": 1},
        "full_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "label_order": {
          "type": "array",
          "prefixItems": [
            {"const": "Identity reference rule"},
            {"const": "Scene intent"},
            {"const": "Visible details"},
            {"const": "Action cue"},
            {"const": "Avoid"}
          ],
          "items": false
        }
      }
    },
    "memberVisualInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "path",
        "sha256",
        "package_album_key",
        "package_title_key",
        "order",
        "visual_control_policy"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(^|/)face-only-reference(?:-|\\.|/)"}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "package_album_key": {"type": "string", "minLength": 1},
        "package_title_key": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "visual_control_policy": {
          "const": "appearance_hair_makeup_wardrobe_material_silhouette_and_body_continuity_only"
        }
      }
    },
    "sceneReferenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "asset_id",
        "path",
        "sha256",
        "reference_class",
        "order",
        "preserve",
        "discard"
      ],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^VRB_[A-Z0-9_]{2,80}$"},
        "asset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {
          "enum": ["main_reference", "supporting_visual_reference"]
        },
        "role": {"type": "string", "minLength": 1},
        "reference_class": {
          "enum": [
            "current_title_world_or_background",
            "founder_sequence_subreference",
            "founder_scene_subreference",
            "other_scene_visual"
          ]
        },
        "order": {"type": "integer", "minimum": 1},
        "preserve": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "discard": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "attachmentOrderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_slot",
        "reference_scope",
        "binding_id",
        "asset_id",
        "path",
        "sha256"
      ],
      "properties": {
        "input_slot": {"type": "integer", "minimum": 1},
        "reference_scope": {"enum": ["member_visual", "scene_visual"]},
        "binding_id": {"type": "string", "pattern": "^VRB_[A-Z0-9_]{2,80}$"},
        "asset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {
          "enum": ["main_reference", "supporting_visual_reference"]
        },
        "role": {"type": "string", "minLength": 1}
      }
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_policy",
        "section_id",
        "current_core_cut_id",
        "current_branch_cut_id",
        "previous_branch_cut_id",
        "next_branch_cut_id",
        "previous_core_cut_id",
        "next_core_cut_id",
        "same_section_context_sha256",
        "context_pack",
        "planning_source",
        "cross_section_continuity_owner"
      ],
      "properties": {
        "context_policy": {
          "const": "current_branch_plus_parent_core_immediate_branch_siblings_and_immediate_previous_and_next_core_cuts_in_same_section_only"
        },
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "current_core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "current_branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
        "previous_branch_cut_id": {
          "type": ["string", "null"],
          "pattern": "^BC[0-9A-Z_]{2,80}$"
        },
        "next_branch_cut_id": {
          "type": ["string", "null"],
          "pattern": "^BC[0-9A-Z_]{2,80}$"
        },
        "previous_core_cut_id": {
          "type": ["string", "null"],
          "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"
        },
        "next_core_cut_id": {
          "type": ["string", "null"],
          "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"
        },
        "same_section_context_sha256": {"$ref": "#/$defs/sha256"},
        "context_pack": {"$ref": "#/$defs/sourceArtifact"},
        "planning_source": {"$ref": "#/$defs/sourceArtifact"},
        "cross_section_continuity_owner": {"const": "coordinator_review_not_packet_request"}
      }
    },
    "qualityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "quality",
        "dimension_policy",
        "required_prompt_terms",
        "pixel_inspection_required"
      ],
      "properties": {
        "model": {"const": "gpt-image-2"},
        "quality": {"const": "highest_available"},
        "dimension_policy": {"const": "maximum_supported_dimensions_for_locked_aspect_ratio"},
        "required_prompt_terms": {
          "type": "array",
          "prefixItems": [
            {"const": "4K"},
            {"const": "high quality"},
            {"const": "high detail"}
          ],
          "items": false
        },
        "pixel_inspection_required": {"const": true}
      }
    },
    "integrityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_value_sha256",
        "prompt_sha256",
        "member_visual_order_sha256",
        "scene_reference_order_sha256",
        "combined_attachment_order_sha256",
        "expected_output_path_sha256",
        "cross_album_check",
        "face_only_lane_check"
      ],
      "properties": {
        "packet_value_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "member_visual_order_sha256": {"$ref": "#/$defs/sha256"},
        "scene_reference_order_sha256": {"$ref": "#/$defs/sha256"},
        "combined_attachment_order_sha256": {"$ref": "#/$defs/sha256"},
        "expected_output_path_sha256": {"$ref": "#/$defs/sha256"},
        "cross_album_check": {"const": "passed_current_title_package_only"},
        "face_only_lane_check": {"const": "passed_no_separate_face_input"}
      }
    },
    "adapterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsupported_reference_behavior", "prompt_rewrite_policy", "one_request_rule"],
      "properties": {
        "unsupported_reference_behavior": {"const": "hold_never_drop_or_replace_with_prose"},
        "prompt_rewrite_policy": {"const": "forbidden"},
        "one_request_rule": {"const": "one_packet_per_generation_call"}
      }
    },
    "sectionExecutionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_profile",
        "scope",
        "parallelism_rule",
        "post_generation_gate",
        "motion_handoff_rule"
      ],
      "properties": {
        "owner_profile": {"const": "luna_max_section_image_motion_lineage"},
        "scope": {"const": "one_declared_section"},
        "parallelism_rule": {"const": "bounded_parallel_disjoint_packets_only"},
        "post_generation_gate": {"const": "byte_hash_pixel_inspection_and_generated_branch_cut_review"},
        "motion_handoff_rule": {"const": "03v_starts_only_from_passed_pixels"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "founder_external_execution_approval",
        "founder_paid_generation_approval",
        "approval_source_path",
        "approval_source_sha256"
      ],
      "properties": {
        "founder_external_execution_approval": {"type": "boolean"},
        "founder_paid_generation_approval": {"type": "boolean"},
        "approval_source_path": {"type": ["string", "null"]},
        "approval_source_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "founder_external_execution_approval": {"const": true},
              "founder_paid_generation_approval": {"const": true}
            },
            "required": [
              "founder_external_execution_approval",
              "founder_paid_generation_approval"
            ]
          },
          "then": {
            "properties": {
              "approval_source_path": {"type": "string", "minLength": 1},
              "approval_source_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {
              "approval_source_path": {"type": "null"},
              "approval_source_sha256": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
