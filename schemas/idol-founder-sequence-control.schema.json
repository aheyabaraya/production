{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/idol-founder-sequence-control.schema.json",
  "title": "IDOL Founder Start And Sequence Control",
  "description": "IDOL Front Planning v17 input contract. The Founder may start from one short direction, selected song and typed A/B/C visual plus X/Y/Z audio references, one must-have or avoid, or a request for the director's first proposal. The assigned director translates that seed into ordered MJxx Major proposals and exact section/Major reference targets. New sequence evidence uses one-second exact-five Sequence Units with contextual flow readings and linked Sequence Runs; legacy three-second units remain external pinned read-only evidence. This input is not a separate Founder approval gate or production stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "lane",
    "status",
    "source_capture",
    "story_flow",
    "reference_plan",
    "director_translation",
    "minimal_intervention_contract",
    "startup_gate"
  ],
  "properties": {
    "schema_version": {"const": "idol_founder_sequence_control.v3"},
    "content_id": {"type": "string", "minLength": 1},
    "lane": {"const": "idol_mv"},
    "status": {"enum": ["draft", "director_ready", "hold", "rejected"]},
    "source_capture": {"$ref": "#/$defs/sourceCapture"},
    "story_flow": {"$ref": "#/$defs/storyFlow"},
    "reference_plan": {"$ref": "#/$defs/referencePlan"},
    "director_translation": {"$ref": "#/$defs/directorTranslation"},
    "minimal_intervention_contract": {"$ref": "#/$defs/minimalInterventionContract"},
    "startup_gate": {"$ref": "#/$defs/startupGate"}
  },
  "$defs": {
    "sourceCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_authorization_mode",
        "founder_verbatim_inputs",
        "transcription_owner",
        "founder_does_not_fill_schema_fields"
      ],
      "properties": {
        "start_authorization_mode": {
          "enum": [
            "founder_direction_supplied",
            "selected_song_and_references_supplied",
            "must_have_or_avoid_supplied",
            "director_first_proposal_requested"
          ]
        },
        "founder_verbatim_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "transcription_owner": {"const": "assigned_director_codex_or_grok"},
        "founder_does_not_fill_schema_fields": {"const": true}
      }
    },
    "majorScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_major_id",
        "section_id",
        "order_index",
        "direction_owner",
        "direction",
        "major_scene_boundaries",
        "required_subject_or_member_ids",
        "required_action_or_hold",
        "space_direction",
        "reference_ids",
        "entry_state",
        "endpoint",
        "continuity_to_next"
      ],
      "properties": {
        "control_major_id": {"type": "string", "pattern": "^MJ[0-9]{2,}$"},
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "order_index": {"type": "integer", "minimum": 1},
        "direction_owner": {"enum": ["assigned_director_proposal", "founder_direct_update"]},
        "direction": {"type": "string", "minLength": 1},
        "major_scene_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "required_subject_or_member_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_action_or_hold": {"type": "string", "minLength": 1},
        "space_direction": {
          "type": "string",
          "minLength": 1,
          "description": "Text or exact scene-reference direction only; no separate background/world asset package."
        },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "entry_state": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "continuity_to_next": {"type": "string", "minLength": 1}
      }
    },
    "storyFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_line_direction",
        "message_or_viewer_result",
        "opening_state",
        "ordered_major_scenes",
        "ending_or_afterimage",
        "hard_locks",
        "forbidden_outcomes"
      ],
      "properties": {
        "one_line_direction": {"type": "string", "minLength": 1},
        "message_or_viewer_result": {"type": "string", "minLength": 1},
        "opening_state": {"type": "string", "minLength": 1},
        "ordered_major_scenes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/majorScene"}
        },
        "ending_or_afterimage": {"type": "string", "minLength": 1},
        "hard_locks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_outcomes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "referenceUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "assignment_owner",
        "source_identity",
        "source_path_or_url",
        "selected_range_or_surface",
        "exact_use_function",
        "reference_slot",
        "target_section_ids",
        "target_control_major_ids",
        "preserve",
        "replace_or_discard",
        "disposition"
      ],
      "properties": {
        "reference_id": {"type": "string", "minLength": 1},
        "reference_slot": {"enum": ["A", "B", "C", "X", "Y", "Z", "additional_bounded_reference"]},
        "assignment_owner": {"enum": ["assigned_director_proposal", "founder_direct_update"]},
        "source_identity": {"type": "string", "minLength": 1},
        "source_path_or_url": {"type": "string", "minLength": 1},
        "selected_range_or_surface": {"type": "string", "minLength": 1},
        "exact_use_function": {"type": "string", "minLength": 1},
        "target_section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
        },
        "target_control_major_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MJ[0-9]{2,}$"}
        },
        "preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "replace_or_discard": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "disposition": {"enum": ["applied", "combined", "held", "rejected"]}
      }
    },
    "referencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governing_reference_ids", "references", "unresolved_reference_choices"],
      "properties": {
        "governing_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/referenceUse"}
        },
        "unresolved_reference_choices": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "observableMajor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_major_id",
        "visible_action_or_hold",
        "screen_change",
        "camera_and_composition_read",
        "sound_opportunity",
        "endpoint",
        "continuity_to_next"
      ],
      "properties": {
        "control_major_id": {"type": "string", "pattern": "^MJ[0-9]{2,}$"},
        "visible_action_or_hold": {"type": "string", "minLength": 1},
        "screen_change": {"type": "string", "minLength": 1},
        "camera_and_composition_read": {"type": "string", "minLength": 1},
        "sound_opportunity": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "continuity_to_next": {"type": "string", "minLength": 1}
      }
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict", "resolution", "founder_decision_required"],
      "properties": {
        "conflict": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "founder_decision_required": {"type": "boolean"}
      }
    },
    "directorTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation_owner",
        "translated_message",
        "observable_sequence",
        "conflicts_and_resolutions",
        "explicit_founder_locks_preserved",
        "director_fills_unspecified_story_order",
        "reference_roles_are_proposals_unless_founder_locked"
      ],
      "properties": {
        "translation_owner": {"const": "assigned_director_codex_or_grok"},
        "translated_message": {"type": "string", "minLength": 1},
        "observable_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/observableMajor"}
        },
        "conflicts_and_resolutions": {
          "type": "array",
          "items": {"$ref": "#/$defs/conflictResolution"}
        },
        "explicit_founder_locks_preserved": {"const": true},
        "director_fills_unspecified_story_order": {"const": true},
        "reference_roles_are_proposals_unless_founder_locked": {"const": true}
      }
    },
    "minimalInterventionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "founder_may_start_with_one_short_input",
        "director_authors_first_recommended_sequence",
        "director_authors_major_scene_proposals",
        "director_authors_and_quality_checks_key_screens",
        "separate_major_approval_required",
        "separate_key_screen_approval_required",
        "new_member_visual_requires_founder_selection",
        "unresolved_material_conflict_requires_founder_decision",
        "front_planning_final_gate_required",
        "separate_background_asset_generation"
      ],
      "properties": {
        "founder_may_start_with_one_short_input": {"const": true},
        "director_authors_first_recommended_sequence": {"const": true},
        "director_authors_major_scene_proposals": {"const": true},
        "director_authors_and_quality_checks_key_screens": {"const": true},
        "separate_major_approval_required": {"const": false},
        "separate_key_screen_approval_required": {"const": false},
        "new_member_visual_requires_founder_selection": {"const": true},
        "unresolved_material_conflict_requires_founder_decision": {"const": true},
        "front_planning_final_gate_required": {"const": true},
        "separate_background_asset_generation": {"const": false}
      }
    },
    "startupGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "unresolved_material_choices",
        "projection_authorized",
        "note"
      ],
      "properties": {
        "decision": {"enum": ["start_authorized", "hold", "reject"]},
        "unresolved_material_choices": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "projection_authorized": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "director_ready"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reference_plan": {
            "properties": {"unresolved_reference_choices": {"maxItems": 0}}
          },
          "startup_gate": {
            "properties": {
              "decision": {"const": "start_authorized"},
              "unresolved_material_choices": {"maxItems": 0},
              "projection_authorized": {"const": true}
            }
          }
        }
      }
    }
  ]
}
