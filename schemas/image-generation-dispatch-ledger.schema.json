{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/image-generation-dispatch-ledger.schema.json",
  "title": "IDOL Provider-Neutral Image Generation Dispatch Ledger",
  "description": "Active v4 claim/output/pixel ledger for provider-neutral Production Cut image jobs. It preserves the current-session-native or explicit provider decision and each provider's exact tool/auth/profile surface; it never aliases providers, calls a model itself, or decides creative PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "run", "source_worklist", "section_id", "status", "capacity", "queue", "return_recipient", "automation_boundaries"],
  "properties": {
    "schema_version": {"const": "idol_image_generation_dispatch_ledger.v4"},
    "artifact_type": {"const": "image_generation_dispatch_ledger"},
    "run": {"type": "string", "pattern": "^runs/"},
    "source_worklist": {"$ref": "#/$defs/sourcePointer"},
    "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
    "status": {"enum": ["ready", "in_progress", "awaiting_pixel_inspection", "complete", "hold"]},
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_in_flight", "one_packet_per_call", "same_output_parallel_write_forbidden"],
      "properties": {
        "max_in_flight": {"type": "integer", "minimum": 1, "maximum": 32},
        "one_packet_per_call": {"const": true},
        "same_output_parallel_write_forbidden": {"const": true}
      }
    },
    "queue": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/queueItem"}},
    "return_recipient": {"const": "creative_development_director"},
    "automation_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_call_performed_by_ledger", "approval_granted", "prompt_or_attachment_rewrite_performed", "provider_auth_model_fallback"],
      "properties": {
        "model_call_performed_by_ledger": {"const": false},
        "approval_granted": {"const": false},
        "prompt_or_attachment_rewrite_performed": {"const": false},
        "provider_auth_model_fallback": {"const": "none"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "claim": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt_id", "runner_id", "claimed_at", "idempotency_key"],
          "properties": {
            "attempt_id": {"type": "string", "pattern": "^ATT_[A-F0-9]{16}$"},
            "runner_id": {"type": "string", "minLength": 1},
            "claimed_at": {"type": "string", "format": "date-time"},
            "idempotency_key": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "mediaReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "exact_model_or_tool", "runtime_version", "auth_lane", "auth_verified_without_secret_material", "provider_profile_id", "provider_profile_sha256", "provider_capability_snapshot_sha256", "prompt_sha256", "ordered_input_sha256s", "expected_output_path", "original_provider_output_path", "canonical_ingested_path", "output_sha256", "watermark_present", "usage_snapshot", "pixel_review_status", "provider_auth_model_fallback"],
      "properties": {
        "provider": {"enum": ["codex", "openai", "xai_grok_build", "xai_api"]},
        "exact_model_or_tool": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "auth_lane": {"enum": ["codex_session", "subscription_oauth", "founder_approved_api"]},
        "auth_verified_without_secret_material": {"const": true},
        "provider_profile_id": {"type": "string", "minLength": 1},
        "provider_profile_sha256": {"$ref": "#/$defs/sha256"},
        "provider_capability_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "ordered_input_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "expected_output_path": {"type": "string", "minLength": 1},
        "original_provider_output_path": {"type": "string", "minLength": 1},
        "canonical_ingested_path": {"type": "string", "minLength": 1},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "watermark_present": {"type": "boolean"},
        "usage_snapshot": {"type": "string", "minLength": 1},
        "pixel_review_status": {"enum": ["generated_unreviewed", "passed", "rejected"]},
        "provider_auth_model_fallback": {"const": "none"}
      }
    },
    "output": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "recorded_at", "media_execution_receipt"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "recorded_at": {"type": "string", "format": "date-time"},
            "media_execution_receipt": {"$ref": "#/$defs/mediaReceipt"}
          }
        }
      ]
    },
    "inspection": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "receipt", "reviewer"],
          "properties": {
            "status": {"enum": ["pass", "reject"]},
            "receipt": {"$ref": "#/$defs/sourcePointer"},
            "reviewer": {"const": "creative_development_director_or_bounded_image_worker_returned_to_cdd"}
          }
        }
      ]
    },
    "queueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "mode", "cut_id", "cut_type", "production_scope_id", "image_execution_request", "image_execution_request_origin", "image_execution_session_provider", "image_execution_lane", "execution_adapter_id", "provider", "auth_lane", "provider_profile_id", "provider_profile_sha256", "provider_capability_snapshot_sha256", "selected_native_tool", "request", "expected_output_path", "state", "attempt_count", "claim", "output", "pixel_inspection"],
      "properties": {
        "packet_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["fp_hero_core", "official_core", "official_branch"]},
        "cut_id": {"type": "string", "minLength": 1},
        "cut_type": {"enum": ["hero_core", "official_core", "branch"]},
        "parent_core_cut_id": {"type": "string", "minLength": 1},
        "production_scope_id": {"type": "string", "minLength": 1},
        "image_execution_request": {"enum": ["current_session_native", "openai_api_gpt_image_2", "grok_build_oauth_subscription", "xai_api_media"]},
        "image_execution_request_origin": {"enum": ["founder_omitted_current_session_default", "founder_explicit"]},
        "image_execution_session_provider": {"enum": ["codex", "grok_build"]},
        "image_execution_lane": {"enum": ["codex_session_native", "openai_api_gpt_image_2", "grok_build_oauth_subscription", "xai_api_media"]},
        "execution_adapter_id": {"enum": ["codex_imagegen", "openai_api_gpt_image_2", "grok_image", "xai_api_media"]},
        "provider": {"enum": ["codex", "openai", "xai_grok_build", "xai_api"]},
        "auth_lane": {"enum": ["codex_session", "subscription_oauth", "founder_approved_api"]},
        "provider_profile_id": {"type": "string", "minLength": 1},
        "provider_profile_sha256": {"$ref": "#/$defs/sha256"},
        "provider_capability_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "selected_native_tool": {"enum": ["imagegen", "image_edit", "image_gen", null]},
        "request": {"$ref": "#/$defs/sourcePointer"},
        "expected_output_path": {"type": "string", "minLength": 1},
        "state": {"enum": ["pending", "claimed", "generated", "passed", "failed", "hold"]},
        "attempt_count": {"type": "integer", "minimum": 0},
        "claim": {"$ref": "#/$defs/claim"},
        "output": {"$ref": "#/$defs/output"},
        "pixel_inspection": {"$ref": "#/$defs/inspection"},
        "failure_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
