{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/schemas/03v-playback-decision-sheet.schema.json",
  "title": "IDOL 03V Playback Decision Sheet",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "run",
    "status",
    "route",
    "source_playback_worklist",
    "source_intake",
    "source_section_qa",
    "section_range",
    "section_ids",
    "clips_root",
    "summary",
    "response_contract",
    "sections",
    "packet_rows",
    "automation_boundaries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "idol_03v_playback_decision_sheet.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "waiting_for_clips",
        "partial_clip_intake",
        "ready_for_founder_playback_decision"
      ]
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "source_playback_worklist": {
      "type": "string",
      "minLength": 1
    },
    "source_intake": {
      "type": "string",
      "minLength": 1
    },
    "source_section_qa": {
      "type": "string",
      "minLength": 1
    },
    "section_range": {
      "type": "string",
      "minLength": 1
    },
    "section_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "clips_root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "section_count",
        "packet_count",
        "present_clip_count",
        "missing_clip_count",
        "media_probe_issue_count",
        "pending_playback_review_count",
        "required_check_count"
      ],
      "additionalProperties": false,
      "properties": {
        "section_count": {"type": "integer", "minimum": 0},
        "packet_count": {"type": "integer", "minimum": 0},
        "present_clip_count": {"type": "integer", "minimum": 0},
        "missing_clip_count": {"type": "integer", "minimum": 0},
        "media_probe_issue_count": {"type": "integer", "minimum": 0},
        "pending_playback_review_count": {"type": "integer", "minimum": 0},
        "required_check_count": {"type": "integer", "minimum": 0}
      }
    },
    "response_contract": {
      "type": "object",
      "required": [
        "pass_reply",
        "hold_reply",
        "fix_reply",
        "apply_pass_command_template",
        "apply_hold_command_template",
        "apply_fix_command_template"
      ],
      "additionalProperties": false,
      "properties": {
        "pass_reply": {"type": "string", "minLength": 1},
        "hold_reply": {"type": "string", "minLength": 1},
        "fix_reply": {"type": "string", "minLength": 1},
        "apply_pass_command_template": {"type": "string", "minLength": 1},
        "apply_hold_command_template": {"type": "string", "minLength": 1},
        "apply_fix_command_template": {"type": "string", "minLength": 1}
      }
    },
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "packet_rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/packet_row"}
    },
    "automation_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "section_key",
        "section_label",
        "section_status",
        "playback_review_status",
        "packet_count",
        "present_clip_count",
        "missing_clip_count",
        "media_probe_issue_count",
        "founder_question",
        "packet_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "section_key": {"type": "string", "minLength": 1},
        "section_label": {"type": "string"},
        "section_status": {"type": "string"},
        "playback_review_status": {"type": "string"},
        "packet_count": {"type": "integer", "minimum": 0},
        "present_clip_count": {"type": "integer", "minimum": 0},
        "missing_clip_count": {"type": "integer", "minimum": 0},
        "media_probe_issue_count": {"type": "integer", "minimum": 0},
        "founder_question": {"type": "string", "minLength": 1},
        "packet_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "packet_row": {
      "type": "object",
      "required": [
        "packet_id",
        "section_key",
        "timeline",
        "clip_status",
        "clip_file_status",
        "media_probe_status",
        "media_probe_error",
        "playback_review_status",
        "generated_clip_path",
        "visible_review_prompt",
        "focus_checks",
        "pass_blocker"
      ],
      "additionalProperties": false,
      "properties": {
        "packet_id": {"type": "string", "minLength": 1},
        "section_key": {"type": "string", "minLength": 1},
        "timeline": {"type": "string"},
        "clip_status": {"enum": ["missing", "present"]},
        "clip_file_status": {
          "enum": ["missing", "present_probe_ok", "present_probe_failed"]
        },
        "media_probe_status": {"enum": ["ok", "probe_failed", "not_run"]},
        "media_probe_error": {"type": "string"},
        "playback_review_status": {
          "enum": ["waiting_clip", "pending_review", "reviewed"]
        },
        "generated_clip_path": {"type": "string"},
        "generated_clip_sha256": {"type": "string", "pattern": "^(?:[a-f0-9]{64})?$"},
        "visible_review_prompt": {"type": "string", "minLength": 1},
        "focus_checks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "pass_blocker": {"type": "string"}
      }
    }
  }
}
