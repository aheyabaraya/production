{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/prompt-packet-delta-v1.2-legacy.schema.json",
  "title": "IDOL 02A To 02B Section Prompt Translation Input 1.2 Legacy Reader",
  "description": "Pinned read-only 1.2 input for historical 02A v2.5 Branch-only translation. New authoring uses prompt-packet-delta.schema.json 1.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_profile",
    "content_id",
    "source_02a",
    "direct_compile_basis",
    "section_compile_scope",
    "readiness_evidence",
    "output",
    "packets"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "compiler_profile": {"const": "front_planning_member_visual_storyline_02b_structured_translation_v2_2"},
    "content_id": {"type": "string", "minLength": 1},
    "source_02a": {"$ref": "#/$defs/source02AArtifactRef"},
    "carry_forward_source_02b": {"$ref": "#/$defs/artifactRef"},
    "direct_compile_basis": {"$ref": "#/$defs/directCompileBasis"},
    "section_compile_scope": {"$ref": "#/$defs/sectionCompileScope"},
    "readiness_evidence": {"$ref": "#/$defs/readinessEvidence"},
    "output": {"$ref": "#/$defs/output"},
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/packetTranslation"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source02AArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "2.5"}
      }
    },
    "directCompileBasis": {
      "type": "object",
      "description": "Operational choices only. Creative wording lives in packet.direct_prompt_revision; its prompt_blueprint field contains the five required 02B render-prompt items, later serialized as five fixed labeled lines, not a 02A schema projection.",
      "additionalProperties": false,
      "required": [
        "image_quality",
        "default_render_prompt_mode",
        "default_render_size",
        "generation_route",
        "review_order_policy",
        "prompt_translation_policy",
        "member_visual_policy",
        "scene_reference_policy",
        "context_policy"
      ],
      "properties": {
        "image_quality": {"const": "highest_available"},
        "default_render_prompt_mode": {
          "enum": ["single_branch_cut_16_9", "single_branch_cut_3_2"]
        },
        "default_render_size": {"type": "string", "minLength": 1},
        "generation_route": {"const": "prompt_export_only"},
        "review_order_policy": {"const": "packet_sequence"},
        "prompt_translation_policy": {
          "const": "model_or_human_authored_natural_language_translation_from_02a_never_schema_dump_or_exact_prompt_copy"
        },
        "member_visual_policy": {
          "const": "current_title_package_only_select_smallest_branch_cut_relevant_subset_no_separate_face_input"
        },
        "scene_reference_policy": {
          "const": "preserve_02a_selected_sequence_or_scene_reference_action_staging_composition_still_camera_crop_and_order"
        },
        "context_policy": {
          "const": "current_branch_plus_parent_core_immediate_branch_siblings_and_immediate_previous_and_next_core_cuts_in_same_section_only"
        }
      }
    },
    "sectionCompileScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "shard_id",
        "primary_section_id",
        "section_ids",
        "core_cut_ids",
        "output_kind",
        "canonical_merge_policy"
      ],
      "properties": {
        "mode": {"const": "sequential_single_physical_section"},
        "shard_id": {"type": "string", "minLength": 1},
        "primary_section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
        },
        "core_cut_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"}
        },
        "output_kind": {"const": "noncanonical_02b_section_shard"},
        "canonical_merge_policy": {
          "const": "lossless_ordered_merge_after_section_founder_review_pass"
        }
      }
    },
    "readinessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyboard_context_review"],
      "properties": {
        "storyboard_context_review": {"$ref": "#/$defs/artifactRef"},
        "founder_direct_intervention": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "status", "coverage_status"],
      "properties": {
        "format": {"const": "prompt_packets_v2_2"},
        "status": {"enum": ["draft", "hold"]},
        "coverage_status": {"const": "partial"},
        "open_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "parentCoreCutRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_cut_id", "json_pointer", "value_sha256"],
      "properties": {
        "core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "json_pointer": {"type": "string", "pattern": "^/master_storyboard/[0-9]+$"},
        "value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "branchCutRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_cut_id", "json_pointer", "value_sha256"],
      "properties": {
        "branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
        "json_pointer": {
          "type": "string",
          "pattern": "^/master_storyboard/[0-9]+/compile_seed/branch_cuts/[0-9]+$"
        },
        "value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "neighborBranchCutRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["branch_cut_id", "json_pointer", "value_sha256"],
      "properties": {
        "branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
        "json_pointer": {
          "type": "string",
          "pattern": "^/master_storyboard/[0-9]+/compile_seed/branch_cuts/[0-9]+$"
        },
        "value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "neighborCoreCutRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["core_cut_id", "json_pointer", "value_sha256"],
      "properties": {
        "core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "json_pointer": {"type": "string", "pattern": "^/master_storyboard/[0-9]+$"},
        "value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sameSectionContextBinding": {
      "type": "object",
      "description": "Compact creative context for one 02B translation. Branch refs point only to immediate siblings inside the parent core cut. Core refs point only to the immediately previous and next core cuts inside the same section. A section boundary uses its existing entry or exit continuity instead of loading another section.",
      "additionalProperties": false,
      "required": [
        "policy",
        "section_id",
        "current_core_cut_id",
        "current_branch_cut_id",
        "previous_branch_cut",
        "next_branch_cut",
        "previous_core_cut",
        "next_core_cut",
        "first_core_cut_boundary_rule",
        "last_core_cut_boundary_rule",
        "context_value_sha256"
      ],
      "properties": {
        "policy": {
          "const": "current_branch_plus_parent_core_immediate_branch_siblings_and_immediate_previous_and_next_core_cuts_in_same_section_only"
        },
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "current_core_cut_id": {"type": "string", "pattern": "^C[0-9]{2,}[A-Z0-9_]*$"},
        "current_branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
        "previous_branch_cut": {"$ref": "#/$defs/neighborBranchCutRef"},
        "next_branch_cut": {"$ref": "#/$defs/neighborBranchCutRef"},
        "previous_core_cut": {"$ref": "#/$defs/neighborCoreCutRef"},
        "next_core_cut": {"$ref": "#/$defs/neighborCoreCutRef"},
        "first_core_cut_boundary_rule": {
          "const": "use_current_section_entry_continuity_when_previous_core_cut_is_null"
        },
        "last_core_cut_boundary_rule": {
          "const": "use_current_section_exit_continuity_when_next_core_cut_is_null"
        },
        "context_value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "promptBlueprint": {
      "type": "object",
      "description": "Five required render-facing prompt items authored at 02B. Visible details and Action cue have required internal authored components; the compiler may add only fixed labels, separators, and punctuation when serializing the items as the unchanged five labeled lines.",
      "additionalProperties": false,
      "required": [
        "authoring_owner",
        "identity_reference_rule",
        "scene_intent",
        "visible_details",
        "action_cue",
        "avoid"
      ],
      "properties": {
        "authoring_owner": {"enum": ["human_authored_02b", "model_authored_02b"]},
        "identity_reference_rule": {"type": "string", "minLength": 1},
        "scene_intent": {"type": "string", "minLength": 1},
        "visible_details": {"$ref": "#/$defs/structuredVisibleDetails"},
        "action_cue": {"$ref": "#/$defs/structuredActionCue"},
        "avoid": {"type": "string", "minLength": 1}
      }
    },
    "structuredStillCameraAndComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_height",
        "shot_scale_distance",
        "direction_angle",
        "depth_design",
        "subject_placement",
        "crop_negative_space",
        "lens_feel"
      ],
      "properties": {
        "camera_height": {"type": "string", "minLength": 1},
        "shot_scale_distance": {"type": "string", "minLength": 1},
        "direction_angle": {"type": "string", "minLength": 1},
        "depth_design": {"type": "string", "minLength": 1},
        "subject_placement": {"type": "string", "minLength": 1},
        "crop_negative_space": {"type": "string", "minLength": 1},
        "lens_feel": {"type": "string", "minLength": 1}
      }
    },
    "structuredVisibleDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background_and_space",
        "still_camera_and_composition",
        "lighting_color_material",
        "render_quality"
      ],
      "properties": {
        "background_and_space": {"type": "string", "minLength": 1},
        "still_camera_and_composition": {"$ref": "#/$defs/structuredStillCameraAndComposition"},
        "lighting_color_material": {"type": "string", "minLength": 1},
        "render_quality": {"const": "4K, high quality, high detail"}
      }
    },
    "structuredActionCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_state_or_pose",
        "visible_action_or_hold",
        "object_environment_response"
      ],
      "properties": {
        "subject_state_or_pose": {"type": "string", "minLength": 1},
        "visible_action_or_hold": {"type": "string", "minLength": 1},
        "object_environment_response": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "authoringInspectionReceipt": {
      "type": "object",
      "description": "A human/model declaration that the exact source truth and bound visual inputs were inspected before creative fields were authored. The compiler validates hashes and exact sets only; it cannot claim that reading or author the values.",
      "additionalProperties": false,
      "required": [
        "inspection_owner",
        "source_02a_branch_cut_sha256",
        "source_storyline_alignment_binding_sha256",
        "inspected_storyline_levels",
        "inspected_visual_reference_binding_ids",
        "inspected_current_title_asset_ids",
        "authored_component_order",
        "creative_fill_policy",
        "storyline_inspection_note",
        "inspection_note"
      ],
      "properties": {
        "inspection_owner": {"enum": ["human_authored_02b", "model_authored_02b"]},
        "source_02a_branch_cut_sha256": {"$ref": "#/$defs/sha256"},
        "source_storyline_alignment_binding_sha256": {"$ref": "#/$defs/sha256"},
        "inspected_storyline_levels": {
          "type": "array",
          "prefixItems": [
            {"const": "whole_film"},
            {"const": "section"},
            {"const": "planning_cut"},
            {"const": "02a_branch_expansion"}
          ],
          "items": false
        },
        "inspected_visual_reference_binding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^VRB_[A-Z0-9_]{2,80}$"}
        },
        "inspected_current_title_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authored_component_order": {
          "type": "array",
          "prefixItems": [
            {"const": "identity_reference_rule"},
            {"const": "scene_intent"},
            {"const": "visible_details.background_and_space"},
            {"const": "visible_details.still_camera_and_composition.camera_height"},
            {"const": "visible_details.still_camera_and_composition.shot_scale_distance"},
            {"const": "visible_details.still_camera_and_composition.direction_angle"},
            {"const": "visible_details.still_camera_and_composition.depth_design"},
            {"const": "visible_details.still_camera_and_composition.subject_placement"},
            {"const": "visible_details.still_camera_and_composition.crop_negative_space"},
            {"const": "visible_details.still_camera_and_composition.lens_feel"},
            {"const": "visible_details.lighting_color_material"},
            {"const": "action_cue.subject_state_or_pose"},
            {"const": "action_cue.visible_action_or_hold"},
            {"const": "action_cue.object_environment_response"},
            {"const": "avoid"}
          ],
          "items": false
        },
        "creative_fill_policy": {
          "const": "human_or_assigned_model_inspects_source_truth_and_authors_every_creative_component_scripts_may_only_validate_hash_and_serialize_fixed_labels"
        },
        "storyline_inspection_note": {"type": "string", "minLength": 1},
        "inspection_note": {"type": "string", "minLength": 1}
      }
    },
    "storylineComponentList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "scene_intent",
          "visible_details.background_and_space",
          "visible_details.still_camera_and_composition",
          "visible_details.lighting_color_material",
          "action_cue.subject_state_or_pose",
          "action_cue.visible_action_or_hold",
          "action_cue.object_environment_response",
          "avoid"
        ]
      }
    },
    "storylineAuthoringBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_cut_id",
        "source_key_screen_id",
        "source_branch_storyline_binding_sha256",
        "whole_film_readout_sha256",
        "section_readout_sha256",
        "planning_cut_readout_sha256",
        "02a_expansion_delta_sha256",
        "component_consumption",
        "coverage_rule",
        "semantic_review_rule"
      ],
      "properties": {
        "planning_cut_id": {"type": "string", "pattern": "^PC_[A-Z0-9_]{2,100}$"},
        "source_key_screen_id": {"type": "string", "pattern": "^KS_[A-Z0-9_]{2,100}$"},
        "source_branch_storyline_binding_sha256": {"$ref": "#/$defs/sha256"},
        "whole_film_readout_sha256": {"$ref": "#/$defs/sha256"},
        "section_readout_sha256": {"$ref": "#/$defs/sha256"},
        "planning_cut_readout_sha256": {"$ref": "#/$defs/sha256"},
        "02a_expansion_delta_sha256": {"$ref": "#/$defs/sha256"},
        "component_consumption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["whole_film", "section", "planning_cut", "02a_branch_expansion"],
          "properties": {
            "whole_film": {"$ref": "#/$defs/storylineComponentList"},
            "section": {"$ref": "#/$defs/storylineComponentList"},
            "planning_cut": {"$ref": "#/$defs/storylineComponentList"},
            "02a_branch_expansion": {"$ref": "#/$defs/storylineComponentList"}
          }
        },
        "coverage_rule": {
          "const": "the_union_must_cover_every_storyline_sensitive_prompt_component_before_compile"
        },
        "semantic_review_rule": {
          "const": "mechanical_mapping_is_not_semantic_proof_the_recipient_director_must_read_the_storyline_and_prompt_then_accept_or_hold"
        }
      }
    },
    "preservedLockAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_core_cut_timing_and_section_ownership",
        "branch_cut_id_sequence_derivation_and_distinct_contribution",
        "member_visual_input_set_and_order",
        "visual_reference_binding_set_and_order",
        "founder_visual_alignment_storyline",
        "explicit_founder_locks",
        "expected_output_path"
      ],
      "properties": {
        "parent_core_cut_timing_and_section_ownership": {"const": true},
        "branch_cut_id_sequence_derivation_and_distinct_contribution": {"const": true},
        "member_visual_input_set_and_order": {"const": true},
        "visual_reference_binding_set_and_order": {"const": true},
        "founder_visual_alignment_storyline": {"const": true},
        "explicit_founder_locks": {"const": true},
        "expected_output_path": {"const": true}
      }
    },
    "directPromptRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "authoring_owner",
        "authoring_reason",
        "source_02a_branch_cut_lock_sha256",
        "same_section_context",
        "storyline_authoring_binding",
        "authoring_inspection_receipt",
        "preserved_lock_assertions",
        "prompt_blueprint"
      ],
      "properties": {
        "revision_id": {"type": "string", "pattern": "^02BPR_[A-Z0-9_]{2,80}$"},
        "authoring_owner": {"enum": ["human_authored_02b", "model_authored_02b"]},
        "authoring_reason": {
          "const": "translate_the_exact_02a_branch_cut_and_bounded_context_into_natural_render_language_without_schema_dumping"
        },
        "source_02a_branch_cut_lock_sha256": {"$ref": "#/$defs/sha256"},
        "same_section_context": {"$ref": "#/$defs/sameSectionContextBinding"},
        "storyline_authoring_binding": {"$ref": "#/$defs/storylineAuthoringBinding"},
        "authoring_inspection_receipt": {"$ref": "#/$defs/authoringInspectionReceipt"},
        "preserved_lock_assertions": {"$ref": "#/$defs/preservedLockAssertions"},
        "prompt_blueprint": {"$ref": "#/$defs/promptBlueprint"}
      }
    },
    "packetTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "parent_core_cut_ref",
        "branch_cut_ref",
        "expected_output_path",
        "direct_prompt_revision"
      ],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^PKT_BC[0-9]{2,}_[A-Z0-9_]+$"},
        "parent_core_cut_ref": {"$ref": "#/$defs/parentCoreCutRef"},
        "branch_cut_ref": {"$ref": "#/$defs/branchCutRef"},
        "expected_output_path": {"type": "string", "minLength": 1},
        "direct_prompt_revision": {"$ref": "#/$defs/directPromptRevision"}
      }
    }
  }
}
