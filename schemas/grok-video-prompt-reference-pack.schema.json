{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/grok-video-prompt-reference-pack.schema.json",
  "title": "IDOL Optional Grok 03V Reference Pack",
  "description": "Active v7 only. This is a read-only projection of the common active 03V authoring source pack built from the complete PRE-00-rooted full-storyline lineage, passed Official Core/Branch Production Cut images, their audio placement, and exact CDD-P3-Ci to CDD-V-Ci section-cohort succession. It does not rediscover sources, replace the full lineage with a summary, rewrite canonical creative truth, approve external execution, or generate video.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "run_root",
    "status",
    "founder_requested",
    "execution_mode",
    "source_pack",
    "source_set_sha256",
    "source_artifacts",
    "storyline_lineage_projection",
    "authoring_policy",
    "section_cohort_successions",
    "section_shards",
    "reference_files",
    "automation_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "idol_grok_video_prompt_reference_pack.v7"},
    "content_id": {"type": "string", "minLength": 1},
    "run_root": {"type": "string", "minLength": 1},
    "status": {"enum": ["dry_run", "written"]},
    "founder_requested": {"const": true},
    "execution_mode": {"const": "founder_paste_only"},
    "source_pack": {"$ref": "#/$defs/artifactRef"},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/sourceArtifact"}
    },
    "storyline_lineage_projection": {"$ref": "#/$defs/storylineLineageProjection"},
    "authoring_policy": {"$ref": "#/$defs/authoringPolicy"},
    "section_cohort_successions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sectionCohortSuccession"}},
    "section_shards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sectionShard"}
    },
    "reference_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_authoring_source_pack",
        "local_brief",
        "request_packet",
        "paste_trigger"
      ],
      "properties": {
        "common_authoring_source_pack": {"type": "string", "minLength": 1},
        "local_brief": {"type": "string", "minLength": 1},
        "request_packet": {"type": "string", "minLength": 1},
        "paste_trigger": {"type": "string", "minLength": 1}
      }
    },
    "automation_boundaries": {"$ref": "#/$defs/automationBoundaries"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "master_storyboard",
            "prompt_packets",
            "production_cut_review",
            "audio_branch_cut_placement",
            "storyboard_assist"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "storylineLineageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_01_json_pointer",
        "source_front_planning_json_pointer",
        "source_value_sha256",
        "projected_value"
      ],
      "properties": {
        "source_01_json_pointer": {"const": "/storyline_lineage_projection/projected_value"},
        "source_front_planning_json_pointer": {"const": "/storyline_lineage"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"},
        "projected_value": {"type": "object", "minProperties": 1}
      }
    },
    "valueBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["source_json_pointer", "source_value_sha256"],
      "properties": {
        "source_json_pointer": {"type": "string", "pattern": "^/"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sectionCohortSuccession": {
      "type": "object", "additionalProperties": false,
      "required": ["section_cohort_id", "section_ids", "source_02b_section_shards", "planning_cdd_lane_id", "production_cdd_lane_id", "carry_policy", "physical_session_policy"],
      "properties": {
        "section_cohort_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
        "section_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}},
        "source_02b_section_shards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/valueBinding"}},
        "planning_cdd_lane_id": {"type": "string", "pattern": "^CDD-P3-C[1-9][0-9]*$"},
        "production_cdd_lane_id": {"type": "string", "pattern": "^CDD-V-C[1-9][0-9]*$"},
        "carry_policy": {"const": "p3_ci_to_v_ci_exact_same_section_cohort"},
        "physical_session_policy": {"const": "primary_plus_successor_max_two_per_stage"}
      }
    },
    "authoringPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_gate",
        "attachment_order",
        "board_authority",
        "production_cut_original_authority",
        "source_union",
        "same_parent_default",
        "cross_core_rule",
        "camera_motion_owner",
        "creative_prompt_author",
        "one_section_per_owner"
      ],
      "properties": {
        "source_gate": {"const": "passed_hash_bound_pixels_and_passed_storyboard_boards_only"},
        "attachment_order": {
          "const": "@image1_storyboard_then_@image2_@image3_optional_@image4_ordered_production_cut_originals"
        },
        "board_authority": {"const": "timing_blocking_subject_route_and_temporal_camera_motion"},
        "production_cut_original_authority": {"const": "pixels_identity_style_light_still_composition_and_visible_states"},
        "source_union": {"const": "official_core_or_branch"},
        "same_parent_default": {"const": true},
        "cross_core_rule": {"const": "both_core_ids_and_continuity_reason_required"},
        "camera_motion_owner": {"const": "03V_after_passed_production_cut_review_and_audio_production_cut_placement"},
        "creative_prompt_author": {"const": "selected_Grok_surface_under_the_same_active_IDOL_contract"},
        "one_section_per_owner": {"const": true}
      }
    },
    "sectionShard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "section_cohort_id", "planning_cdd_lane_id", "production_cdd_lane_id", "cohort_carry_policy", "storyboard_ids", "board_count", "authoring_scope"],
      "properties": {
        "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
        "section_cohort_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
        "planning_cdd_lane_id": {"type": "string", "pattern": "^CDD-P3-C[1-9][0-9]*$"},
        "production_cdd_lane_id": {"type": "string", "pattern": "^CDD-V-C[1-9][0-9]*$"},
        "cohort_carry_policy": {"const": "p3_ci_to_v_ci_exact_same_section_cohort"},
        "storyboard_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^03VSB_[A-Z0-9_]{2,80}$"}
        },
        "board_count": {"type": "integer", "minimum": 1},
        "authoring_scope": {"const": "one_section_only"}
      }
    },
    "automationBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_handoff_only",
        "canonical_source_mutation_allowed",
        "paid_video_generation_approved",
        "external_video_execution_approved",
        "playback_pass_implied",
        "edit_readiness_implied"
      ],
      "properties": {
        "derived_handoff_only": {"const": true},
        "canonical_source_mutation_allowed": {"const": false},
        "paid_video_generation_approved": {"const": false},
        "external_video_execution_approved": {"const": false},
        "playback_pass_implied": {"const": false},
        "edit_readiness_implied": {"const": false}
      }
    }
  }
}
