{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/image-generation-section-approval-v5-legacy.schema.json",
  "title": "IDOL Image Generation Scope Approval v5 Legacy Reader",
  "description": "Pinned read-only copy of the committed v5 approval contract. It preserves pre-session-native authorization evidence and must never authorize new work; active authoring uses image-generation-section-approval.schema.json v6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "content_id", "section_id", "production_scope_id", "source_prompt_packets_sha256", "execution_adapter_id", "provider", "auth_lane", "provider_profile_id", "provider_profile_sha256", "provider_capability_snapshot_sha256", "founder_generation_authority_id", "external_execution_approved", "paid_generation_approved", "approved_output_count", "spend_envelope", "automatic_fallback", "packets"],
  "properties": {
    "schema_version": {"const": "idol_image_generation_section_approval.v5"},
    "artifact_type": {"const": "image_generation_scope_approval"},
    "content_id": {"type": "string", "minLength": 1},
    "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
    "production_scope_id": {"type": "string", "minLength": 1},
    "source_prompt_packets_sha256": {"$ref": "#/$defs/sha256"},
    "execution_adapter_id": {"enum": ["openai_api_gpt_image_2", "grok_image", "xai_api_media"]},
    "provider": {"enum": ["openai", "xai_grok_build", "xai_api"]},
    "auth_lane": {"enum": ["subscription_oauth", "founder_approved_api"]},
    "provider_profile_id": {"type": "string", "minLength": 1},
    "provider_profile_sha256": {"$ref": "#/$defs/sha256"},
    "provider_capability_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "founder_generation_authority_id": {"type": "string", "minLength": 1},
    "external_execution_approved": {"const": true},
    "paid_generation_approved": {"const": true},
    "approved_output_count": {"type": "integer", "minimum": 1},
    "spend_envelope": {"type": "string", "minLength": 1},
    "automatic_fallback": {"const": "none"},
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packet_id", "mode", "cut_id", "prompt_sha256", "approved_attachment_sha256s", "approved_attachment_paths", "expected_output_path", "output_count", "decision"],
        "properties": {
          "packet_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["fp_hero_core", "official_core", "official_branch"]},
          "cut_id": {"type": "string", "minLength": 1},
          "prompt_sha256": {"$ref": "#/$defs/sha256"},
          "approved_attachment_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
          "approved_attachment_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expected_output_path": {"type": "string", "minLength": 1},
          "output_count": {"const": 1},
          "decision": {"const": "approved_for_current_job"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
