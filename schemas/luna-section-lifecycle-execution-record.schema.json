{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/luna-section-lifecycle-execution-record.schema.json",
  "title": "IDOL Section Image-Motion Lifecycle Execution Record",
  "description": "Provider-neutral registered-runner evidence for one physical section image-motion checkpoint bound to one Overall-promoted 02A Production Cut lineage. Active v2 pins the resolved worker provider capability without turning that provider into a logical authority, returns to CDD, permits a later checkpoint in a new physical session while preserving the same section lineage, and excludes 04.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "session_type",
    "session_id",
    "logical_role",
    "logical_profile_alias",
    "provider_profile_snapshot_ref",
    "provider_capability_snapshot_sha256",
    "automatic_fallback",
    "source_02a_sha256",
    "assigned_section_ids",
    "fresh_session_boundary",
    "section_lineage_id",
    "checkpoint_id",
    "durable_checkpoint_resume",
    "same_physical_session_required",
    "04_edit_session_included",
    "completion_state",
    "return_recipient_role",
    "canonical_creative_write_performed"
  ],
  "properties": {
    "schema_version": {"const": "idol_luna_section_lifecycle_execution_record.v2"},
    "producer": {"const": "registered_section_image_motion_lifecycle_runner"},
    "session_type": {"const": "section_image_motion_checkpoint"},
    "session_id": {"type": "string", "minLength": 1},
    "logical_role": {"const": "section_image_motion_worker"},
    "logical_profile_alias": {"const": "worker_high"},
    "provider_profile_snapshot_ref": {
      "type": "string",
      "pattern": "^automation/harness-provider-profile-registry\\.yaml#/logical_profiles/worker_high/providers/[a-z0-9_-]+(?:/role_profiles/section_image_motion_worker)?$"
    },
    "provider_capability_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "automatic_fallback": {"const": "none"},
    "source_02a_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assigned_section_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"}
    },
    "fresh_session_boundary": {"const": "overall_promoted_02a_section_boundary"},
    "section_lineage_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "durable_checkpoint_resume": {"type": "boolean"},
    "same_physical_session_required": {"const": false},
    "04_edit_session_included": {"const": false},
    "completion_state": {"enum": ["awaiting_cdd_production_cut_review", "complete", "hold"]},
    "return_recipient_role": {"const": "creative_development_director"},
    "canonical_creative_write_performed": {"const": false}
  }
}
