{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/terra-section-lifecycle-receipt.schema.json",
  "title": "IDOL Terra Section Lifecycle Receipt",
  "description": "Retired evidence-only Terra/XHigh section lifecycle receipt. Historical lineages remain validator-readable, but new post-02A work must use the active Luna Section Lifecycle Receipt; this schema cannot open or resume a new lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run",
    "section_id",
    "status",
    "executor",
    "session_contract",
    "sources",
    "stage_statuses",
    "generated_branch_cut_sol_gate",
    "direct_script_checks",
    "inspected_asset_manifest",
    "sol_decision_evidence",
    "completion_report",
    "authority_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "idol_terra_section_lifecycle_receipt.v3"},
    "artifact_type": {"const": "terra_section_lifecycle_receipt"},
    "run": {"type": "string", "pattern": "^(?:runs/[a-z0-9][a-z0-9-]{1,120}/[a-z0-9가-힣][a-z0-9가-힣-]{1,120}/[A-Za-z0-9][A-Za-z0-9._-]{2,120}|runs/2026-07-29/0729_ONE_MOVE)$"},
    "section_id": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
    "status": {"enum": ["awaiting_sol_branch_cut_selection", "complete", "hold"]},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "agent_name", "model_id", "reasoning_effort", "session_id", "execution_record"],
      "properties": {
        "surface": {"const": "codex"},
        "agent_name": {"const": "idol_terra_routine_judgment"},
        "model_id": {"const": "gpt-5.6-terra"},
        "reasoning_effort": {"const": "xhigh"},
        "session_id": {"type": "string", "minLength": 1},
        "execution_record": {"$ref": "#/$defs/sourcePointer"}
      }
    },
    "session_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_session_boundary",
        "exactly_one_section",
        "sol_physical_shard_execution_forbidden",
        "section_lineage_id",
        "durable_checkpoint_resume_allowed",
        "same_physical_session_required",
        "04_edit_session_included",
        "completed_checkpoint_id"
      ],
      "properties": {
        "fresh_session_boundary": {"const": "sol_approved_02a_section"},
        "exactly_one_section": {"const": true},
        "sol_physical_shard_execution_forbidden": {"const": true},
        "section_lineage_id": {"type": "string", "minLength": 1},
        "durable_checkpoint_resume_allowed": {"const": true},
        "same_physical_session_required": {"const": false},
        "04_edit_session_included": {"const": false},
        "completed_checkpoint_id": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_02a", "source_02b", "context_pack", "planning_source"],
      "properties": {
        "source_02a": {"$ref": "#/$defs/sourcePointer"},
        "source_02b": {
          "oneOf": [
            {"$ref": "#/$defs/sourcePointer"},
            {"type": "null"}
          ]
        },
        "context_pack": {"$ref": "#/$defs/sourcePointer"},
        "planning_source": {"$ref": "#/$defs/sourcePointer"}
      }
    },
    "stage_statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "02a_validation",
        "02b_exact_compile",
        "branch_cut_image_generation",
        "generated_branch_cut_review",
        "03v_motion_video_work"
      ],
      "properties": {
        "02a_validation": {"$ref": "#/$defs/stageStatus"},
        "02b_exact_compile": {"$ref": "#/$defs/stageStatus"},
        "branch_cut_image_generation": {"$ref": "#/$defs/stageStatus"},
        "generated_branch_cut_review": {"$ref": "#/$defs/stageStatus"},
        "03v_motion_video_work": {"$ref": "#/$defs/stageStatus"},
        "04_section_edit_qc": {"$ref": "#/$defs/stageStatus"}
      }
    },
    "generated_branch_cut_sol_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_owner",
        "candidate_asset_ids",
        "selected_asset_ids",
        "sol_session_id",
        "selection_note"
      ],
      "properties": {
        "status": {"enum": ["pending", "selected", "hold"]},
        "decision_owner": {"const": "continuing_sol_session"},
        "candidate_asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "selected_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sol_session_id": {"type": ["string", "null"], "minLength": 1},
        "selection_note": {"type": "string"},
        "resume_same_section_lineage_required": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "selected"}}, "required": ["status"]},
          "then": {
            "properties": {
              "selected_asset_ids": {"minItems": 1},
              "sol_session_id": {"type": "string", "minLength": 1},
              "selection_note": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "direct_script_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scriptCheck"}
    },
    "inspected_asset_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inspectedAsset"}
    },
    "sol_decision_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/decisionEvidence"}
    },
    "completion_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported_to_sol", "summary", "remaining_risks", "sol_final_decision_required"],
      "properties": {
        "reported_to_sol": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1},
        "remaining_risks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "sol_final_decision_required": {"const": true}
      }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_check_owner",
        "full_asset_inspection_owner",
        "creative_selection_owner",
        "prompt_or_motion_rewrite_performed",
        "canonical_creative_write_performed"
      ],
      "properties": {
        "deterministic_check_owner": {"const": "registered_direct_scripts"},
        "full_asset_inspection_owner": {"const": "terra"},
        "creative_selection_owner": {"const": "sol"},
        "prompt_or_motion_rewrite_performed": {"const": false},
        "canonical_creative_write_performed": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "properties": {
          "sources": {
            "properties": {"source_02b": {"$ref": "#/$defs/sourcePointer"}}
          },
          "stage_statuses": {
            "properties": {
              "02a_validation": {"const": "complete"},
              "02b_exact_compile": {"const": "complete"},
              "branch_cut_image_generation": {"const": "complete"},
              "generated_branch_cut_review": {"const": "complete"},
              "03v_motion_video_work": {"const": "complete"}
            }
          },
          "generated_branch_cut_sol_gate": {
            "properties": {"status": {"const": "selected"}}
          },
          "completion_report": {
            "properties": {"reported_to_sol": {"const": true}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "awaiting_sol_branch_cut_selection"}}, "required": ["status"]},
      "then": {
        "properties": {
          "generated_branch_cut_sol_gate": {
            "properties": {"status": {"const": "pending"}}
          }
        }
      }
    },
    {
      "properties": {
        "stage_statuses": {"not": {"required": ["04_section_edit_qc"]}},
        "generated_branch_cut_sol_gate": {
          "required": ["resume_same_section_lineage_required"]
        },
        "inspected_asset_manifest": {
          "items": {
            "allOf": [
              {"$ref": "#/$defs/inspectedAsset"},
              {
                "not": {
                  "properties": {"stage": {"const": "04"}},
                  "required": ["stage"]
                }
              }
            ]
          }
        },
        "sol_decision_evidence": {
          "items": {
            "allOf": [
              {"$ref": "#/$defs/decisionEvidence"},
              {
                "not": {
                  "properties": {"stage": {"const": "04"}},
                  "required": ["stage"]
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stageStatus": {"enum": ["pending", "complete", "hold"]},
    "scriptCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "command_id", "status", "evidence_path", "evidence_sha256"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "command_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "hold"]},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inspectedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "stage",
        "media_type",
        "actual_path",
        "sha256",
        "inspection_status",
        "observable_facts",
        "technical_disposition"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "stage": {"enum": ["02a_validation", "generated_branch_cut_review", "03v"]},
        "media_type": {"enum": ["image", "frame", "crop", "clip", "playback"]},
        "actual_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "inspection_status": {"const": "pixel_or_playback_inspected"},
        "observable_facts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "technical_disposition": {"enum": ["technical_pass", "technical_hold", "locked_rubric_rerun"]}
      }
    },
    "evidenceSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_path",
        "sha256",
        "source_or_generated_asset_id",
        "maps_to_core_cut_ids",
        "maps_to_branch_cut_ids",
        "decision_anchor_role",
        "audio_or_section_cue",
        "inspected_observable_fact",
        "relevant_boundary",
        "media_type"
      ],
      "properties": {
        "actual_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_or_generated_asset_id": {"type": "string", "minLength": 1},
        "maps_to_core_cut_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "maps_to_branch_cut_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"}
        },
        "decision_anchor_role": {"type": "string", "minLength": 1},
        "audio_or_section_cue": {"type": "string", "minLength": 1},
        "inspected_observable_fact": {"type": "string", "minLength": 1},
        "relevant_boundary": {"type": "string", "minLength": 1},
        "media_type": {"enum": ["image", "frame", "crop", "clip", "playback"]},
        "time_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_seconds", "end_seconds"],
          "properties": {
            "start_seconds": {"type": "number", "minimum": 0},
            "end_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "sequence_position": {"enum": ["start", "change", "peak", "end", "diagnostic"]}
      }
    },
    "decisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_set_id", "stage", "evidence_kind", "source_anchor_ids", "surfaces"],
      "properties": {
        "decision_set_id": {"type": "string", "minLength": 1},
        "stage": {"enum": ["02a_validation", "generated_branch_cut_review", "03v"]},
        "evidence_kind": {"enum": ["still_frame_set", "sequence_bundle", "playback_clip"]},
        "source_anchor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/evidenceSurface"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"evidence_kind": {"const": "sequence_bundle"}}, "required": ["evidence_kind"]},
          "then": {"properties": {"surfaces": {"minItems": 2}}}
        },
        {
          "if": {"properties": {"evidence_kind": {"const": "playback_clip"}}, "required": ["evidence_kind"]},
          "then": {"properties": {"surfaces": {"maxItems": 1}}}
        }
      ]
    }
  }
}
