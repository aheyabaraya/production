{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/prompt-packets.schema.json",
  "title": "IDOL Provider-Neutral One-Cut One-Image Prompt Packets",
  "description": "Active 2.6 contract. It preserves provider transport attachment roles while carrying an authored, exact-copy logical reference-role plan with no more than four groups and mandatory motion evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "status",
    "prompt_profile",
    "packet_policy",
    "run_execution_selection",
    "prompt_packets",
    "section_shards",
    "review_surface",
    "open_questions"
  ],
  "properties": {
    "schema_version": {"const": "2.6"},
    "content_id": {"type": "string", "minLength": 1},
    "input_files": {"type": "object"},
    "status": {"enum": ["draft", "founder_review", "approved", "hold", "rejected"]},
    "prompt_profile": {"const": "idol_one_cut_one_image.v1"},
    "packet_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "prompt_structure", "creative_authoring", "provider_transport", "fallback", "output_count"],
      "properties": {
        "unit": {"const": "one_cut_one_image"},
        "prompt_structure": {"const": "exactly_five_natural_language_lines"},
        "creative_authoring": {"const": "human_or_assigned_model_only"},
        "provider_transport": {"const": "exact_bytes_and_locked_attachment_order_only"},
        "fallback": {"const": "none"},
        "output_count": {"const": 1}
      }
    },
    "run_execution_selection": {"$ref": "#/$defs/runExecutionSelection"},
    "prompt_packets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/promptPacket"}
    },
    "section_shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "packet_ids", "status"],
        "properties": {
          "section_id": {"$ref": "#/$defs/sectionId"},
          "section_cohort_id": {"$ref": "#/$defs/sectionCohortId"},
          "packet_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["draft", "founder_review", "passed", "hold", "rejected"]}
        }
      }
    },
    "review_surface": {
      "type": "object",
      "required": ["recipient", "pixel_review_required", "mechanical_pass_is_creative_pass"],
      "properties": {
        "recipient": {"const": "creative_development_director"},
        "pixel_review_required": {"const": true},
        "mechanical_pass_is_creative_pass": {"const": false}
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sectionId": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "runExecutionSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creative_role_provider", "image_execution_request", "image_execution_request_origin", "image_execution_session_provider", "image_execution_lane", "video_execution_lane", "automatic_fallback"],
      "properties": {
        "creative_role_provider": {"enum": ["codex", "grok_build"]},
        "image_execution_request": {"enum": ["current_session_native", "openai_api_gpt_image_2", "grok_build_oauth_subscription", "xai_api_media"]},
        "image_execution_request_origin": {"enum": ["founder_omitted_current_session_default", "founder_explicit"]},
        "image_execution_session_provider": {"enum": ["codex", "grok_build"]},
        "image_execution_lane": {"enum": ["codex_session_native", "openai_api_gpt_image_2", "grok_build_oauth_subscription", "xai_api_media"]},
        "video_execution_lane": {"enum": ["grok_build_oauth_subscription", "xai_api_media", "other_registered"]},
        "automatic_fallback": {"const": "none"}
      },
      "allOf": [
        {"if": {"properties": {"image_execution_request_origin": {"const": "founder_omitted_current_session_default"}}}, "then": {"properties": {"image_execution_request": {"const": "current_session_native"}}}},
        {"if": {"properties": {"image_execution_request": {"const": "current_session_native"}}}, "then": {"oneOf": [
          {"properties": {"creative_role_provider": {"const": "codex"}, "image_execution_session_provider": {"const": "codex"}, "image_execution_lane": {"const": "codex_session_native"}}},
          {"properties": {"creative_role_provider": {"const": "grok_build"}, "image_execution_session_provider": {"const": "grok_build"}, "image_execution_lane": {"const": "grok_build_oauth_subscription"}}}
        ]}},
        {"if": {"properties": {"image_execution_request": {"const": "current_session_native"}, "image_execution_session_provider": {"const": "codex"}}}, "then": {"properties": {"image_execution_lane": {"const": "codex_session_native"}}}},
        {"if": {"properties": {"image_execution_request": {"const": "current_session_native"}, "image_execution_session_provider": {"const": "grok_build"}}}, "then": {"properties": {"image_execution_lane": {"const": "grok_build_oauth_subscription"}}}},
        {"if": {"properties": {"image_execution_request": {"const": "openai_api_gpt_image_2"}}}, "then": {"properties": {"image_execution_lane": {"const": "openai_api_gpt_image_2"}}}},
        {"if": {"properties": {"image_execution_request": {"const": "grok_build_oauth_subscription"}}}, "then": {"properties": {"image_execution_lane": {"const": "grok_build_oauth_subscription"}}}},
        {"if": {"properties": {"image_execution_request": {"const": "xai_api_media"}}}, "then": {"properties": {"image_execution_lane": {"const": "xai_api_media"}}}}
      ]
    },
    "cutPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cut_id", "cut_type", "section_id", "major_scene_id", "source_path", "source_json_pointer", "source_value_sha256"],
      "properties": {
        "cut_id": {"type": "string", "minLength": 1},
        "cut_type": {"enum": ["hero_core", "official_core", "branch"]},
        "section_id": {"$ref": "#/$defs/sectionId"},
        "major_scene_id": {"type": "string", "pattern": "^MJ[0-9]{2,}[A-Z0-9_]*$"},
        "parent_core_cut_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_json_pointer": {"type": "string", "pattern": "^/"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identityComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_identity", "current_title_visual_bindings", "identity_preservation_rule"],
      "properties": {
        "visible_identity": {"type": "string", "minLength": 1},
        "current_title_visual_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "identity_preservation_rule": {"type": "string", "minLength": 1}
      }
    },
    "sceneIntentComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whole_film_component", "section_component", "major_scene_component", "core_slot_or_core_component", "branch_expansion_component"],
      "properties": {
        "whole_film_component": {"type": "string", "minLength": 1},
        "section_component": {"type": "string", "minLength": 1},
        "major_scene_component": {"type": "string", "minLength": 1},
        "core_slot_or_core_component": {"type": ["string", "null"]},
        "branch_expansion_component": {"type": ["string", "null"]}
      }
    },
    "stillCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_height", "shot_scale_distance", "direction_angle", "depth_design", "subject_placement", "crop_negative_space", "lens_feel"],
      "properties": {
        "camera_height": {"type": "string", "minLength": 1},
        "shot_scale_distance": {"type": "string", "minLength": 1},
        "direction_angle": {"type": "string", "minLength": 1},
        "depth_design": {"type": "string", "minLength": 1},
        "subject_placement": {"type": "string", "minLength": 1},
        "crop_negative_space": {"type": "string", "minLength": 1},
        "lens_feel": {"type": "string", "minLength": 1}
      }
    },
    "visibleDetailsComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background_and_space", "still_camera_and_composition", "lighting_color_material", "render_quality"],
      "properties": {
        "background_and_space": {"type": "string", "minLength": 1},
        "still_camera_and_composition": {"$ref": "#/$defs/stillCamera"},
        "lighting_color_material": {"type": "string", "minLength": 1},
        "render_quality": {"const": "4K, high quality, high detail"}
      }
    },
    "actionCueComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_state_or_pose", "visible_action_or_hold", "object_environment_response"],
      "properties": {
        "subject_state_or_pose": {"type": "string", "minLength": 1},
        "visible_action_or_hold": {"type": "string", "minLength": 1},
        "object_environment_response": {"type": ["string", "null"]}
      }
    },
    "fiveLineComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoring_owner", "identity_reference_rule", "scene_intent", "visible_details", "action_cue", "avoid"],
      "properties": {
        "authoring_owner": {"const": "human_or_assigned_model"},
        "identity_reference_rule": {"$ref": "#/$defs/identityComponents"},
        "scene_intent": {"$ref": "#/$defs/sceneIntentComponents"},
        "visible_details": {"$ref": "#/$defs/visibleDetailsComponents"},
        "action_cue": {"$ref": "#/$defs/actionCueComponents"},
        "avoid": {"type": "string", "minLength": 1}
      }
    },
    "renderedFiveLines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_reference_rule", "scene_intent", "visible_details", "action_cue", "avoid", "full_prompt_text", "full_prompt_sha256", "label_order"],
      "properties": {
        "identity_reference_rule": {"type": "string", "minLength": 1},
        "scene_intent": {"type": "string", "minLength": 1},
        "visible_details": {"type": "string", "minLength": 1},
        "action_cue": {"type": "string", "minLength": 1},
        "avoid": {"type": "string", "minLength": 1},
        "full_prompt_text": {"type": "string", "minLength": 1},
        "full_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "label_order": {
          "type": "array",
          "prefixItems": [
            {"const": "Identity reference rule"},
            {"const": "Scene intent"},
            {"const": "Visible details"},
            {"const": "Action cue"},
            {"const": "Avoid"}
          ],
          "items": false
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "role", "binding_id", "asset_id", "actual_path", "sha256", "pixel_inspection_status", "locked"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "role": {"enum": ["current_title_member_visual", "governing_scene_or_sequence_reference", "supporting_component_reference"]},
        "binding_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "actual_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "pixel_inspection_status": {"const": "passed"},
        "locked": {"const": true}
      }
    },
    "sectionCohortId": {"type": "string", "pattern": "^(?:C[0-9]+|COHORT_[A-Z0-9_]{1,80})$"},
    "referenceFunctionLineage": {
      "type": "object",
      "description": "Exact Front Planning function/disposition lineage for one logical use of one physical attachment. source_media_type describes source shape only; purpose describes the selected screen function and the two fields are never interchangeable.",
      "additionalProperties": false,
      "required": ["attachment_binding_id", "reference_unit_id", "function_id", "purpose", "disposition", "source_media_type", "source_artifact", "reference_unit_json_pointer", "reference_unit_value_sha256", "function_json_pointer", "function_value_sha256"],
      "properties": {
        "attachment_binding_id": {"type": "string", "minLength": 1},
        "reference_unit_id": {"type": "string", "minLength": 1},
        "function_id": {"type": "string", "pattern": "^RFN_[A-Z0-9_]{2,100}$"},
        "purpose": {"enum": ["major_scene_grammar_or_feeling", "background_and_space", "still_camera_and_composition", "lighting_color_material", "subject_state_or_pose", "visible_action_or_hold", "object_environment_response", "edit_or_transition"]},
        "disposition": {"enum": ["applied", "combined"]},
        "source_media_type": {"enum": ["image", "video", "video_selected_range", "image_selected_crop", "video_frame", "contact_sheet", "board", "crop", "generated_image", "other"]},
        "source_artifact": {"$ref": "#/$defs/referenceFunctionArtifactRef"},
        "reference_unit_json_pointer": {"type": "string", "pattern": "^/reference_connection_research/reference_units/[0-9]+$"},
        "reference_unit_value_sha256": {"$ref": "#/$defs/sha256"},
        "function_json_pointer": {"type": "string", "pattern": "^/reference_connection_research/reference_units/[0-9]+/function_analysis/[0-9]+$"},
        "function_value_sha256": {"$ref": "#/$defs/sha256"},
        "sequence_unit_json_pointer": {"type": "string", "pattern": "^/reference_connection_research/reference_units/[0-9]+/sequence_unit$"},
        "sequence_unit_value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "referenceFunctionArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_version": {"const": "front-planning-readiness.v17"}}
    },
    "referenceRoleGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_role", "applicability", "attachment_binding_ids"],
      "properties": {
        "logical_role": {"enum": ["character_visual", "scene_visual_package", "motion_reference", "prop_reference"]},
        "applicability": {"enum": ["required", "not_applicable_member_absent", "not_applicable_no_material_prop"]},
        "attachment_binding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "world_look_binding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "composition_anchor_binding_id": {"type": "string", "minLength": 1},
        "world_look_function_lineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceFunctionLineage"}},
        "composition_anchor_function_lineage": {"$ref": "#/$defs/referenceFunctionLineage"},
        "motion_function_lineage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/referenceFunctionLineage"}},
        "prop_function_lineage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/referenceFunctionLineage"}},
        "sequence_unit_id": {"type": "string", "pattern": "^SEQU_[A-Z0-9_]{2,100}$"},
        "source_locator": {"type": "string", "minLength": 1},
        "sampling_interval_seconds": {"const": 1},
        "sample_count": {"const": 5},
        "contiguous_event": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"logical_role": {"const": "scene_visual_package"}}, "required": ["logical_role"]},
          "then": {
            "required": ["world_look_binding_ids", "composition_anchor_binding_id", "world_look_function_lineage", "composition_anchor_function_lineage"],
            "properties": {
              "applicability": {"const": "required"},
              "attachment_binding_ids": {"minItems": 1},
              "world_look_function_lineage": {"items": {"properties": {"purpose": {"enum": ["major_scene_grammar_or_feeling", "background_and_space", "lighting_color_material", "object_environment_response"]}}}},
              "composition_anchor_function_lineage": {"properties": {"purpose": {"const": "still_camera_and_composition"}}}
            }
          }
        },
        {"if": {"properties": {"logical_role": {"const": "motion_reference"}}, "required": ["logical_role"]}, "then": {"required": ["sequence_unit_id", "source_locator", "sampling_interval_seconds", "sample_count", "contiguous_event", "motion_function_lineage"], "properties": {"applicability": {"const": "required"}, "attachment_binding_ids": {"minItems": 1}, "motion_function_lineage": {"items": {"required": ["sequence_unit_json_pointer", "sequence_unit_value_sha256"], "properties": {"purpose": {"enum": ["subject_state_or_pose", "visible_action_or_hold", "edit_or_transition"]}, "source_media_type": {"enum": ["video", "video_selected_range"]}}}}}}},
        {"if": {"properties": {"logical_role": {"const": "prop_reference"}}, "required": ["logical_role"]}, "then": {"properties": {"applicability": {"enum": ["required", "not_applicable_no_material_prop"]}}, "allOf": [{"if": {"properties": {"applicability": {"const": "required"}}, "required": ["applicability"]}, "then": {"required": ["prop_function_lineage"], "properties": {"attachment_binding_ids": {"minItems": 1}, "prop_function_lineage": {"items": {"properties": {"purpose": {"enum": ["object_environment_response", "subject_state_or_pose", "visible_action_or_hold"]}}}}}}}, {"if": {"properties": {"applicability": {"const": "not_applicable_no_material_prop"}}, "required": ["applicability"]}, "then": {"properties": {"attachment_binding_ids": {"maxItems": 0}}, "not": {"required": ["prop_function_lineage"]}}}]}}
      ]
    },
    "referenceRolePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoring_owner", "scene_character_compile_mode", "performance_mode", "attachment_order_binding_ids", "logical_role_groups"],
      "properties": {
        "authoring_owner": {"const": "human_or_assigned_model"},
        "scene_character_compile_mode": {"enum": ["separate", "combined", "hybrid"]},
        "performance_mode": {"enum": ["none", "supporting", "primary"]},
        "attachment_order_binding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "logical_role_groups": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/referenceRoleGroup"}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_adapter_id", "provider", "provider_model_or_tool", "selected_native_tool", "auth_lane", "provider_profile_id", "provider_profile_sha256", "provider_capability_snapshot_sha256", "cli_or_api_version", "founder_generation_authority_id", "prompt_rewrite_policy", "automatic_fallback", "expected_output_path", "output_count"],
      "properties": {
        "execution_adapter_id": {"enum": ["codex_imagegen", "openai_api_gpt_image_2", "grok_image", "xai_api_media"]},
        "provider": {"enum": ["codex", "openai", "xai_grok_build", "xai_api"]},
        "provider_model_or_tool": {"type": "string", "minLength": 1},
        "selected_native_tool": {"type": ["string", "null"], "enum": ["imagegen", "image_edit", "image_gen", null]},
        "auth_lane": {"enum": ["codex_session", "subscription_oauth", "founder_approved_api"]},
        "provider_profile_id": {"type": "string", "minLength": 1},
        "provider_profile_sha256": {"$ref": "#/$defs/sha256"},
        "provider_capability_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "cli_or_api_version": {"type": "string", "minLength": 1},
        "founder_generation_authority_id": {"type": ["string", "null"]},
        "prompt_rewrite_policy": {"const": "forbidden"},
        "automatic_fallback": {"const": "none"},
        "expected_output_path": {"type": "string", "minLength": 1},
        "output_count": {"const": 1}
      },
      "oneOf": [
        {
          "properties": {
            "execution_adapter_id": {"const": "codex_imagegen"},
            "provider": {"const": "codex"},
            "provider_model_or_tool": {"const": "codex_imagegen"},
            "selected_native_tool": {"const": "imagegen"},
            "auth_lane": {"const": "codex_session"}
          }
        },
        {
          "properties": {
            "execution_adapter_id": {"const": "openai_api_gpt_image_2"},
            "provider": {"const": "openai"},
            "provider_model_or_tool": {"const": "gpt-image-2"},
            "selected_native_tool": {"const": null},
            "auth_lane": {"const": "founder_approved_api"}
          }
        },
        {
          "properties": {
            "execution_adapter_id": {"const": "grok_image"},
            "provider": {"const": "xai_grok_build"},
            "provider_model_or_tool": {"const": "grok_image"},
            "selected_native_tool": {"enum": ["image_edit", "image_gen"]},
            "auth_lane": {"const": "subscription_oauth"}
          }
        },
        {
          "properties": {
            "execution_adapter_id": {"const": "xai_api_media"},
            "provider": {"const": "xai_api"},
            "provider_model_or_tool": {"type": "string", "minLength": 1, "not": {"const": "unregistered_selection_only"}},
            "selected_native_tool": {"const": null},
            "auth_lane": {"const": "founder_approved_api"}
          }
        }
      ]
    },
    "inspectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspection_owner", "source_cut_contract_sha256", "source_storyline_alignment_binding_sha256", "inspected_storyline_levels", "inspected_visual_reference_binding_ids", "inspected_current_title_asset_ids", "authored_component_order", "creative_fill_policy", "storyline_inspection_note", "inspection_note"],
      "properties": {
        "inspection_owner": {"const": "human_or_assigned_model"},
        "source_cut_contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_storyline_alignment_binding_sha256": {"$ref": "#/$defs/sha256"},
        "inspected_storyline_levels": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["whole_film", "section", "major_scene", "planning_core_or_slot", "02a_branch_expansion"]}},
        "inspected_visual_reference_binding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "inspected_current_title_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authored_component_order": {
          "type": "array",
          "prefixItems": [
            {"const": "identity_reference_rule"},
            {"const": "scene_intent"},
            {"const": "visible_details"},
            {"const": "action_cue"},
            {"const": "avoid"}
          ],
          "items": false
        },
        "creative_fill_policy": {"const": "human_or_assigned_model_only_scripts_exact_copy_and_fixed_labels_only"},
        "storyline_inspection_note": {"type": "string", "minLength": 1},
        "inspection_note": {"type": "string", "minLength": 1}
      }
    },
    "promptPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "prompt_profile", "mode", "authority_status", "derivative_route_id", "production_scope_id", "cut_pointer", "active_storyline_version_id", "screen_progression_node_id", "source_sections", "execution_section_id", "member_visual_applicability", "authoring_model_profile_id", "execution", "five_line_components", "rendered_five_lines", "attachments", "reference_role_plan", "authoring_inspection_receipt", "adoption_lineage", "expected_output_path", "status"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^PKT_[A-Z0-9_]{3,120}$"},
        "prompt_profile": {"const": "idol_one_cut_one_image.v1"},
        "mode": {"enum": ["fp_hero_core", "official_core", "official_branch"]},
        "authority_status": {"enum": ["planning_candidate_only", "official_core_storyboard_authorized", "branch_generation_authorized"]},
        "derivative_route_id": {"type": "string", "minLength": 1},
        "production_scope_id": {"type": "string", "minLength": 1},
        "cut_pointer": {"$ref": "#/$defs/cutPointer"},
        "active_storyline_version_id": {"type": "string", "minLength": 1},
        "screen_progression_node_id": {"type": "string", "minLength": 1},
        "source_sections": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/sectionId"}},
        "execution_section_id": {"$ref": "#/$defs/sectionId"},
        "member_visual_applicability": {"enum": ["meaningfully_visible", "visible_but_member_visual_unnecessary", "not_visible"]},
        "authoring_model_profile_id": {"type": "string", "minLength": 1},
        "execution": {"$ref": "#/$defs/execution"},
        "five_line_components": {"$ref": "#/$defs/fiveLineComponents"},
        "rendered_five_lines": {"$ref": "#/$defs/renderedFiveLines"},
        "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
        "reference_role_plan": {"$ref": "#/$defs/referenceRolePlan"},
        "section_cohort_id": {"$ref": "#/$defs/sectionCohortId"},
        "authoring_inspection_receipt": {"$ref": "#/$defs/inspectionReceipt"},
        "adoption_lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adopted_from_packet_id", "same_image_bytes_reusable", "canonical_promotion_inferred"],
          "properties": {
            "adopted_from_packet_id": {"type": ["string", "null"]},
            "same_image_bytes_reusable": {"type": "boolean"},
            "canonical_promotion_inferred": {"const": false}
          }
        },
        "expected_output_path": {"type": "string", "minLength": 1},
        "branch_cut_id": {"type": "string", "pattern": "^BC[0-9A-Z_]{2,80}$"},
        "core_cut_id": {"type": "string", "minLength": 1},
        "time_range": {"type": "string", "minLength": 1},
        "local_trace": {"type": "object"},
        "same_section_context": {"type": "object"},
        "branch_cut_lock": {"type": "object"},
        "storyline_alignment_lock": {"type": "object"},
        "member_visual_lock": {"type": "object"},
        "visual_reference_bindings": {"type": "array", "items": {"type": "object"}},
        "direct_prompt_revision": {"type": "object"},
        "compiled_prompt_block": {"type": "object"},
        "export_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_output_path", "request_unit", "provider_neutral_profile", "approval_state"],
          "properties": {
            "expected_output_path": {"type": "string", "minLength": 1},
            "request_unit": {"const": "one_packet_one_request"},
            "provider_neutral_profile": {"const": "idol_one_cut_one_image.v1"},
            "approval_state": {"const": "not_inferred"}
          }
        },
        "status": {"enum": ["draft", "founder_review", "approved", "hold", "rejected"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "official_branch"}}},
          "then": {
            "required": ["branch_cut_id", "core_cut_id", "time_range", "local_trace", "same_section_context", "branch_cut_lock", "storyline_alignment_lock", "member_visual_lock", "visual_reference_bindings", "direct_prompt_revision", "compiled_prompt_block", "export_contract", "section_cohort_id"],
            "properties": {
              "authority_status": {"const": "branch_generation_authorized"},
              "cut_pointer": {"properties": {"cut_type": {"const": "branch"}}, "required": ["parent_core_cut_id"]}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "official_core"}}},
          "then": {"properties": {"authority_status": {"const": "official_core_storyboard_authorized"}, "cut_pointer": {"properties": {"cut_type": {"const": "official_core"}}}}}
        },
        {
          "if": {"properties": {"mode": {"const": "fp_hero_core"}}},
          "then": {"properties": {"authority_status": {"const": "planning_candidate_only"}, "cut_pointer": {"properties": {"cut_type": {"const": "hero_core"}}}}}
        },
        {
          "if": {"properties": {"member_visual_applicability": {"const": "meaningfully_visible"}}, "required": ["member_visual_applicability"]},
          "then": {
            "properties": {
              "attachments": {
                "minItems": 1,
                "contains": {"type": "object", "properties": {"role": {"const": "current_title_member_visual"}}, "required": ["role"]},
                "minContains": 1
              },
              "five_line_components": {
                "properties": {
                  "identity_reference_rule": {
                    "properties": {"current_title_visual_bindings": {"minItems": 1}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"member_visual_applicability": {"enum": ["visible_but_member_visual_unnecessary", "not_visible"]}}, "required": ["member_visual_applicability"]},
          "then": {
            "properties": {
              "attachments": {
                "not": {"contains": {"type": "object", "properties": {"role": {"const": "current_title_member_visual"}}, "required": ["role"]}}
              },
              "five_line_components": {
                "properties": {
                  "identity_reference_rule": {
                    "properties": {"current_title_visual_bindings": {"maxItems": 0}}
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
