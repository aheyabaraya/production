{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/edit-effect-registry.schema.json",
  "title": "IDOL Edit Effect Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_skill",
    "catalog_ref",
    "renderer",
    "compiler",
    "contract",
    "common_parameters",
    "parameter_specs",
    "xfade_transitions",
    "effects"
  ],
  "properties": {
    "schema_version": {"const": "idol_edit_effect_registry.v1"},
    "owner_skill": {"type": "string", "minLength": 1},
    "catalog_ref": {"type": "string", "minLength": 1},
    "renderer": {"type": "string", "minLength": 1},
    "compiler": {"type": "string", "minLength": 1},
    "contract": {"type": "object"},
    "common_parameters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/parameterSpec"}
    },
    "parameter_specs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/parameterSpec"}
    },
    "xfade_transitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "effects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["aliases", "renderer_status", "timeline_class", "duration_behavior", "parameters"],
        "properties": {
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "renderer_status": {"enum": ["supported_now", "metadata_only", "needs_script_extension"]},
          "timeline_class": {"enum": ["single_stream", "boundary", "metadata"]},
          "duration_behavior": {"enum": ["unchanged", "requires_handle_contract_for_unchanged_program"]},
          "timing_perception_risk": {"type": "boolean"},
          "required_parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "parameterSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["number", "integer", "string", "object", "color"]},
        "minimum": {"type": "number"},
        "exclusive_minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "min_length": {"type": "integer", "minimum": 0},
        "max_length": {"type": "integer", "minimum": 1},
        "pattern": {"type": "string"},
        "forbidden_pattern": {"type": "string"},
        "enum": {"type": "array", "minItems": 1}
      }
    }
  }
}
