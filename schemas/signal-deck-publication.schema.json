{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/signal-deck-publication.schema.json",
  "title": "Loom Signal Deck Public Publication Registry",
  "description": "Canonical local closeout contract that binds one observed public post to its analytics row, Loom member/track-or-CF placement, and exact web-ready visual lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "publications"],
  "properties": {
    "schema_version": {"const": "idol_signal_deck_publication.v1"},
    "status": {"const": "active"},
    "publications": {
      "type": "array",
      "items": {"$ref": "#/$defs/publication"}
    }
  },
  "$defs": {
    "platform": {
      "type": "string",
      "enum": ["tiktok", "youtube", "youtube_shorts", "instagram_reels"]
    },
    "memberCode": {
      "type": "string",
      "pattern": "^M(?:0[1-9]|1[0-3])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?:analytics/|assets/|catalog/|cf/|runs/|web/).+"
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "member_codes",
        "src",
        "alt",
        "source_path",
        "source_sha256",
        "web_path",
        "web_sha256",
        "lineage_mode"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"},
        "member_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/memberCode"}
        },
        "src": {"type": "string", "pattern": "^/assets/.+\\.webp$"},
        "alt": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/repoPath"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "web_path": {"type": "string", "pattern": "^web/public/assets/.+\\.webp$"},
        "web_sha256": {"$ref": "#/$defs/sha256"},
        "lineage_mode": {"enum": ["exact_copy", "web_derivative"]},
        "derivative_note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"lineage_mode": {"const": "web_derivative"}}, "required": ["lineage_mode"]},
          "then": {"required": ["derivative_note"]},
          "else": {"not": {"required": ["derivative_note"]}}
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_id",
        "content_id",
        "content_kind",
        "content_label",
        "platform",
        "platform_post_id",
        "published_url",
        "embed_url",
        "published_at",
        "title",
        "member_visibility",
        "member_codes",
        "visuals"
      ],
      "properties": {
        "post_id": {"type": "string", "minLength": 1},
        "content_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,120}$"},
        "content_kind": {"enum": ["mv", "cf"]},
        "content_label": {"type": "string", "minLength": 1},
        "platform": {"$ref": "#/$defs/platform"},
        "platform_post_id": {"type": "string", "minLength": 1},
        "published_url": {"type": "string", "pattern": "^https://"},
        "embed_url": {"type": "string", "pattern": "^https://"},
        "published_at": {"type": "string", "format": "date-time"},
        "title": {"type": "string", "minLength": 1},
        "member_visibility": {"enum": ["visible", "none"]},
        "member_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/memberCode"}
        },
        "track_id": {"type": "string", "minLength": 1},
        "cf_id": {"type": "string", "pattern": "^CF_[A-Z0-9_]+$"},
        "duration": {"type": ["number", "null"], "minimum": 0},
        "views": {"type": ["number", "null"], "minimum": 0},
        "likes": {"type": ["number", "null"], "minimum": 0},
        "visuals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/visual"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"content_kind": {"const": "mv"}}, "required": ["content_kind"]},
          "then": {"required": ["track_id"], "not": {"required": ["cf_id"]}}
        },
        {
          "if": {"properties": {"content_kind": {"const": "cf"}}, "required": ["content_kind"]},
          "then": {"required": ["cf_id"], "not": {"required": ["track_id"]}}
        },
        {
          "if": {"properties": {"member_visibility": {"const": "visible"}}, "required": ["member_visibility"]},
          "then": {"properties": {"member_codes": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"member_visibility": {"const": "none"}}, "required": ["member_visibility"]},
          "then": {"properties": {"member_codes": {"maxItems": 0}}}
        }
      ]
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "post_id",
        "content_id",
        "platform",
        "published_url",
        "published_at",
        "run_root",
        "source_queue",
        "title_registry",
        "signal_deck"
      ],
      "properties": {
        "schema_version": {"const": "idol_social_public_closeout.v1"},
        "post_id": {"type": "string", "minLength": 1},
        "content_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,120}$"},
        "platform": {"$ref": "#/$defs/platform"},
        "published_url": {"type": "string", "pattern": "^https://"},
        "published_at": {"type": "string", "format": "date-time"},
        "run_root": {"type": "string", "pattern": "^runs/.+"},
        "source_queue": {"type": "string", "pattern": "^runs/.+\\.jsonl$"},
        "title_registry": {"type": "string", "pattern": "^catalog/albums/.+/output-registry\\.yaml$"},
        "signal_deck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_kind",
            "content_label",
            "title",
            "member_visibility",
            "member_codes",
            "visuals"
          ],
          "properties": {
            "content_kind": {"enum": ["mv", "cf"]},
            "content_label": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "member_visibility": {"enum": ["visible", "none"]},
            "member_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/memberCode"}
            },
            "track_id": {"type": "string", "minLength": 1},
            "cf_id": {"type": "string", "pattern": "^CF_[A-Z0-9_]+$"},
            "duration": {"type": ["number", "null"], "minimum": 0},
            "visuals": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/visual"}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"content_kind": {"const": "mv"}}, "required": ["content_kind"]},
              "then": {"required": ["track_id"], "not": {"required": ["cf_id"]}}
            },
            {
              "if": {"properties": {"content_kind": {"const": "cf"}}, "required": ["content_kind"]},
              "then": {"required": ["cf_id"], "not": {"required": ["track_id"]}}
            },
            {
              "if": {"properties": {"member_visibility": {"const": "visible"}}, "required": ["member_visibility"]},
              "then": {"properties": {"member_codes": {"minItems": 1}}}
            },
            {
              "if": {"properties": {"member_visibility": {"const": "none"}}, "required": ["member_visibility"]},
              "then": {"properties": {"member_codes": {"maxItems": 0}}}
            }
          ]
        }
      }
    }
  }
}
