{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/schemas/harness-founder-gate.schema.json",
  "title": "IDOL Graph Engineering Founder Gate Packet",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "run",
    "album_key",
    "title_key",
    "gate_id",
    "gate_type",
    "status",
    "source_next_unit",
    "source_action_queue",
    "source_worklist",
    "source_artifact",
    "selected_unit",
    "section_range",
    "section_ids",
    "packet_count",
    "current_local_status",
    "decision_needed",
    "allowed_decisions",
    "forbidden_actions",
    "automation_boundaries",
    "refresh_commands"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "harness-founder-gate.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "album_key": {
      "type": "string"
    },
    "title_key": {
      "type": "string"
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_type": {
      "enum": ["03v_front_playback_generation"]
    },
    "status": {
      "enum": ["founder_input_needed", "archived"]
    },
    "source_next_unit": {
      "type": "string",
      "minLength": 1
    },
    "source_action_queue": {
      "type": "string",
      "minLength": 1
    },
    "source_worklist": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact": {
      "type": "string",
      "minLength": 1
    },
    "selected_unit": {
      "type": "object",
      "required": ["id", "status", "action", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "reason": {"type": "string"}
      }
    },
    "section_range": {
      "type": "string",
      "minLength": 1
    },
    "section_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "packet_count": {
      "type": "integer",
      "minimum": 1
    },
    "current_local_status": {
      "type": "object",
      "required": [
        "local_ready_sections",
        "remaining_check",
        "next_local_section",
        "next_local_continuation_allowed",
        "source_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "local_ready_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "remaining_check": {
          "type": "string",
          "minLength": 1
        },
        "next_local_section": {
          "type": "string"
        },
        "next_local_continuation_allowed": {
          "type": "boolean"
        },
        "source_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_needed": {
      "type": "string",
      "minLength": 1
    },
    "allowed_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "effect",
          "requires_explicit_approval",
          "allows_paid_generation",
          "allows_external_execution",
          "continues_local_qa",
          "marks_section_qa_pass",
          "next_action"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "requires_explicit_approval": {"type": "boolean"},
          "allows_paid_generation": {"type": "boolean"},
          "allows_external_execution": {"type": "boolean"},
          "continues_local_qa": {"type": "boolean"},
          "marks_section_qa_pass": {"type": "boolean"},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "automation_boundaries": {
      "type": "array",
      "items": {"type": "string"}
    },
    "refresh_commands": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
