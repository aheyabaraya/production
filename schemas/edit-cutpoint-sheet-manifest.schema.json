{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/edit-cutpoint-sheet-manifest.schema.json",
  "title": "IDOL Edit Cutpoint Frame-Step Sheet Manifest",
  "description": "Hash-bound frame-step review material for exact frames around 04 program boundaries. It does not make a cut verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "rendered_video",
    "frame_zero_definition",
    "frame_extraction",
    "drop_frame_timecode",
    "entries",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {"const": "idol_edit_cutpoint_sheet_manifest.v1"},
    "plan": {"$ref": "#/$defs/binding"},
    "rendered_video": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {
          "type": "object",
          "required": ["fps", "observed_fps_float", "frame_count"],
          "properties": {
            "fps": {"$ref": "#/$defs/fps"},
            "observed_fps_float": {"type": "number", "exclusiveMinimum": 0},
            "frame_count": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "frame_zero_definition": {"const": "incoming_slot_first_frame"},
    "frame_extraction": {"const": "single_pass_sequential_decode_no_random_gop_seek"},
    "drop_frame_timecode": {"type": "boolean"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundary_id",
          "from_slot",
          "to_slot",
          "cut_frame",
          "cut_timecode",
          "requested_offsets",
          "captured_frames",
          "missing_offsets",
          "window_status",
          "sheet",
          "incoming_cut_method",
          "timing_relation",
          "timing_offset_frames",
          "pre_cut_evidence",
          "cut_frame_evidence",
          "post_cut_evidence"
        ],
        "properties": {
          "boundary_id": {"type": "string", "minLength": 1},
          "from_slot": {"type": "string", "minLength": 1},
          "to_slot": {"type": "string", "minLength": 1},
          "cut_frame": {"type": "integer", "minimum": 0},
          "cut_timecode": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}[:;][0-9]{2}$"},
          "requested_offsets": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": 0}, "items": {"type": "integer"}},
          "captured_frames": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "missing_offsets": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
          "window_status": {"enum": ["complete", "incomplete_window"]},
          "sheet": {"type": ["string", "null"]},
          "sheet_sha256": {"$ref": "#/$defs/sha256"},
          "incoming_cut_method": {"type": ["string", "null"]},
          "timing_relation": {"type": ["string", "null"]},
          "timing_offset_frames": {"type": ["integer", "null"]},
          "pre_cut_evidence": {"type": ["string", "null"]},
          "cut_frame_evidence": {"type": ["string", "null"]},
          "post_cut_evidence": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"sheet": {"type": "string"}}, "required": ["sheet"]},
            "then": {"required": ["sheet_sha256"]}
          }
        ]
      }
    },
    "interpretation_boundary": {"const": "review_surface_only_no_automatic_cut_pass"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
