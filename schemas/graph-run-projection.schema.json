{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/graph-run-projection.schema.json",
  "title": "IDOL Graph Engineering Run Projection v1",
  "description": "Deterministic read-only six-view projection of one run ledger, including canonical minimum-count C1..Cn section cohorts. Advisory shadow only. Never a creative, promotion, or default-writer authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "status",
    "run_id",
    "source_ledger_sha256",
    "hold_reasons",
    "views",
    "owner_writer_index",
    "promotion_evidence",
    "invalidation",
    "founder_gates",
    "cohorts",
    "legacy_source_pointers",
    "provider_locks",
    "next_legal_actions",
    "projection_digest"
  ],
  "properties": {
    "schema_version": {"const": "idol-graph-run-projection.v1"},
    "authority": {"const": "read_only_projection"},
    "status": {"enum": ["pass", "hold"]},
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "hold_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creative_truth",
        "evidence_provenance",
        "authority_ownership",
        "execution_session",
        "review_decision",
        "provider_capability"
      ],
      "properties": {
        "creative_truth": {"$ref": "#/$defs/viewSlice"},
        "evidence_provenance": {"$ref": "#/$defs/viewSlice"},
        "authority_ownership": {"$ref": "#/$defs/viewSlice"},
        "execution_session": {"$ref": "#/$defs/viewSlice"},
        "review_decision": {"$ref": "#/$defs/viewSlice"},
        "provider_capability": {"$ref": "#/$defs/viewSlice"}
      }
    },
    "owner_writer_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "owner_role", "writer_id", "may_write", "node_id"],
        "properties": {
          "scope_id": {"$ref": "#/$defs/identifier"},
          "owner_role": {"type": "string", "minLength": 1},
          "writer_id": {"$ref": "#/$defs/identifier"},
          "may_write": {"type": "boolean"},
          "node_id": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "promotion_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "review_id",
          "promotes_edge_id",
          "input_digest",
          "result_digest",
          "output_hash"
        ],
        "properties": {
          "node_id": {"$ref": "#/$defs/identifier"},
          "review_id": {"$ref": "#/$defs/identifier"},
          "promotes_edge_id": {"$ref": "#/$defs/identifier"},
          "input_digest": {"$ref": "#/$defs/sha256"},
          "result_digest": {"$ref": "#/$defs/sha256"},
          "output_hash": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "invalidation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changed_node_id",
          "affected_node_ids",
          "preserved_node_ids",
          "scope_ids",
          "traversal"
        ],
        "properties": {
          "changed_node_id": {"$ref": "#/$defs/identifier"},
          "affected_node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "preserved_node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "scope_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "traversal": {"const": "invalidates_edges_only"}
        }
      }
    },
    "founder_gates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "node_id", "state", "required_closed_before"],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^G[0-4]$"
          },
          "node_id": {"$ref": "#/$defs/identifier"},
          "state": {
            "enum": ["planned", "promoted", "hold"]
          },
          "required_closed_before": {
            "type": "array",
            "items": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    },
    "cohorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition", "planning_p3", "section_cluster_v", "carry_rule"],
      "properties": {
        "partition": {
          "type": "array",
          "items": {"$ref": "#/$defs/cohortRow"}
        },
        "planning_p3": {
          "type": "array",
          "items": {"$ref": "#/$defs/cohortLane"}
        },
        "section_cluster_v": {
          "type": "array",
          "items": {"$ref": "#/$defs/cohortLane"}
        },
        "carry_rule": {"const": "exact_p3_cohort_id_to_v_cohort"}
      }
    },
    "legacy_source_pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capsule", "path", "legacy_id", "sha256", "node_id"],
        "properties": {
          "capsule": {"const": "parse_only"},
          "path": {"$ref": "#/$defs/repositoryPath"},
          "local_fixture_path": {"$ref": "#/$defs/repositoryPath"},
          "legacy_id": {"type": "string", "minLength": 1},
          "json_pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {"$ref": "#/$defs/sha256"},
          "node_id": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "provider_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "logical_tier",
          "resolved_profile_id",
          "fallback_policy"
        ],
        "properties": {
          "node_id": {"$ref": "#/$defs/identifier"},
          "logical_tier": {
            "enum": ["frontier_director", "worker_high", "research_medium"]
          },
          "resolved_profile_id": {"$ref": "#/$defs/identifier"},
          "fallback_policy": {"const": "forbidden"}
        }
      }
    },
    "next_legal_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "owner_role", "scope_id"],
        "properties": {
          "action": {"$ref": "#/$defs/identifier"},
          "owner_role": {"type": "string", "minLength": 1},
          "scope_id": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "projection_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {"properties": {"hold_reasons": {"maxItems": 0}}},
      "else": {"properties": {"hold_reasons": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sectionId": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "cohortId": {
      "type": "string",
      "pattern": "^C[1-9][0-9]*$"
    },
    "viewSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_ids", "edge_ids"],
      "properties": {
        "node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "edge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "cohortRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "section_ids", "size"],
      "properties": {
        "cohort_id": {"$ref": "#/$defs/cohortId"},
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "cohortLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_node_id", "cohort_id", "section_ids", "state"],
      "properties": {
        "lane_node_id": {"$ref": "#/$defs/identifier"},
        "cohort_id": {"$ref": "#/$defs/cohortId"},
        "section_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "state": {
          "enum": ["planned", "admitted", "running", "retired"]
        }
      }
    }
  }
}
