{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheyabaraya.local/idol/schemas/graph-section-cohort-map.schema.json",
  "title": "IDOL Graph Section Cohort Map",
  "description": "Roster-derived Graph Engineering partition of every section into the deterministic minimum number of contiguous 2-or-3-section cohorts, except a one-section title. Carries exact C1..Cn P3-Ci to V-Ci identity, one section output writer, one cohort CDD reviewer, and one return recipient. Capacity never creates a cohort. Scripts validate structure and provenance only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run",
    "phase",
    "partition_basis",
    "section_roster",
    "cohorts",
    "p3_to_v_carry",
    "founder_partition_waiver"
  ],
  "properties": {
    "schema_version": {"const": "idol-graph-section-cohort-map.v1"},
    "artifact_type": {"const": "graph_section_cohort_map"},
    "run": {"$ref": "#/$defs/runPath"},
    "phase": {
      "enum": ["planning_provisional", "g40_handoff", "production_active"]
    },
    "partition_basis": {"const": "roster_derived_not_capacity"},
    "section_roster": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sectionId"}
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cohort"}
    },
    "p3_to_v_carry": {
      "type": "array",
      "items": {"$ref": "#/$defs/carry"}
    },
    "founder_partition_waiver": {
      "oneOf": [
        {"$ref": "#/$defs/waiver"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1, "maxLength": 4000},
    "runPath": {
      "type": "string",
      "pattern": "^(?:runs/[0-9]{4}-[0-9]{2}-[0-9]{2}/[A-Z0-9][A-Z0-9_-]{2,80}|runs/[a-z0-9][a-z0-9-]{1,120}/[a-z0-9\\uac00-\\ud7a3][a-z0-9\\uac00-\\ud7a3-]{1,120}/[A-Za-z0-9][A-Za-z0-9._-]{2,120}|cf/runs/CF_[A-Z0-9][A-Z0-9_-]{2,120})$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?:AGENTS\\.md|(?:\\.codex/|\\.cursor/|\\.grok/|automation/|assets/|catalog/|cf/|development/|handoff/|policies/|reference-library/|references/|runs/|schemas/|scripts/|skills/|source-materials/|wiki/|work/).+)"
    },
    "sectionId": {"type": "string", "pattern": "^S[0-9]{2,}[A-Z]?$"},
    "cohortId": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "sectionWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "owner", "role"],
      "properties": {
        "section_id": {"$ref": "#/$defs/sectionId"},
        "owner": {"$ref": "#/$defs/nonEmpty"},
        "role": {"const": "section_image_motion_worker"}
      }
    },
    "cddReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "role", "lane_id"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonEmpty"},
        "role": {"const": "creative_development_director"},
        "lane_id": {
          "type": "string",
          "pattern": "^(?:planning_p3_c[1-9][0-9]*|section_cluster_v_c[1-9][0-9]*)$"
        },
        "session_id": {"$ref": "#/$defs/nonEmpty"},
        "logical_lineage_id": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "role", "return_route"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonEmpty"},
        "role": {
          "enum": [
            "overall_director",
            "creative_development_director",
            "edit_director"
          ]
        },
        "return_route": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "carry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_cohort_id",
        "planning_lane_id",
        "production_lane_id",
        "exact_section_ids",
        "exact_carry",
        "planning_handoff"
      ],
      "properties": {
        "section_cohort_id": {"$ref": "#/$defs/cohortId"},
        "planning_lane_id": {
          "type": "string",
          "pattern": "^planning_p3_c[1-9][0-9]*$"
        },
        "production_lane_id": {
          "type": "string",
          "pattern": "^section_cluster_v_c[1-9][0-9]*$"
        },
        "exact_section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "exact_carry": {"const": true},
        "planning_handoff": {"$ref": "#/$defs/pointer"}
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["founder_lock_id", "verbatim_reason", "affected_section_ids"],
      "properties": {
        "founder_lock_id": {"$ref": "#/$defs/nonEmpty"},
        "verbatim_reason": {"$ref": "#/$defs/nonEmpty"},
        "affected_section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_cohort_id",
        "planning_lane_id",
        "production_lane_id",
        "section_ids",
        "cdd_reviewer",
        "return_recipient",
        "section_output_writers"
      ],
      "properties": {
        "section_cohort_id": {"$ref": "#/$defs/cohortId"},
        "planning_lane_id": {
          "type": "string",
          "pattern": "^planning_p3_c[1-9][0-9]*$"
        },
        "production_lane_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^section_cluster_v_c[1-9][0-9]*$"
            },
            {"type": "null"}
          ]
        },
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "cdd_reviewer": {"$ref": "#/$defs/cddReviewer"},
        "return_recipient": {"$ref": "#/$defs/recipient"},
        "section_output_writers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sectionWriter"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {"enum": ["g40_handoff", "production_active"]}
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "cohorts": {
            "items": {
              "properties": {
                "cdd_reviewer": {
                  "required": ["session_id", "logical_lineage_id"]
                }
              }
            }
          }
        }
      }
    }
  ]
}
