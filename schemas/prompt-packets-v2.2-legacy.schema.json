        "package_title_key": {"type": "string", "minLength": 1},
        "selected_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/memberVisualAssetInput"}
        },
        "selection_rule": {
          "const": "smallest_branch_cut_relevant_subset_from_front_planning_authorized_current_title_pool"
        },
        "visual_control_policy": {
          "const": "member_visual_controls_only_appearance_hair_makeup_wardrobe_material_silhouette_and_body_continuity_never_forces_face_frontal_gaze_pose_camera_crop_or_proportions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"member_visual_reference_policy": {"const": "required"}},
            "required": ["member_visual_reference_policy"]
          },
          "then": {
            "properties": {"selected_assets": {"minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {"member_visual_reference_policy": {"const": "prohibited"}},
            "required": ["member_visual_reference_policy"]
          },
          "then": {
            "properties": {"selected_assets": {"maxItems": 0}}
          }
        },
        {
          "if": {
            "properties": {"member_visual_applicability": {"const": "meaningfully_visible"}},
            "required": ["member_visual_applicability"]
          },
          "then": {
            "properties": {
              "member_visual_reference_policy": {"const": "required"},
              "visible_member_focus": {"minItems": 1},
              "selected_assets": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "member_visual_applicability": {
                "const": "visible_but_member_visual_unnecessary"
              }
            },
            "required": ["member_visual_applicability"]
          },
          "then": {
            "properties": {
              "member_visual_reference_policy": {"const": "prohibited"},
              "visible_member_focus": {"minItems": 1},
              "selected_assets": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"member_visual_applicability": {"const": "not_visible"}},
            "required": ["member_visual_applicability"]
          },
          "then": {
            "properties": {
              "member_visual_reference_policy": {"const": "prohibited"},
              "visible_member_focus": {"maxItems": 0},
              "selected_assets": {"maxItems": 0}
            }
          }
        }
      ]
